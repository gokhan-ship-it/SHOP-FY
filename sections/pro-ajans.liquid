{%- comment -%} Text To Next PRO - Ajanstan istenenler {%- endcomment -%}
<section class="pro-ask pro-pad" aria-labelledby="pro-ask-{{ section.id }}">
  <div class="pro-wrap">
    <div class="pro-head pro-head--left pro-reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="pro-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 id="pro-ask-{{ section.id }}" class="pro-h2 pro-h2--xl">{{ section.settings.title }}</h2>
    </div>

    <ul class="pro-ask__list pro-reveal">
      {%- for block in section.blocks -%}
        <li class="pro-ask__item" {{ block.shopify_attributes }}>
          <span class="pro-ask__icon">{%- render 'pro-icon', icon: block.settings.icon -%}</span>
          <span class="pro-ask__label">{{ block.settings.title }}</span>
          {%- if block.settings.text != blank -%}<span class="pro-ask__hint">{{ block.settings.text }}</span>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.emphasis != blank -%}
      <div class="pro-ask__emph pro-reveal">
        {%- if section.settings.badge != blank -%}<span class="pro-ask__badge">{%- render 'pro-icon', icon: 'clock' -%}{{ section.settings.badge }}</span>{%- endif -%}
        {%- assign e_parts = section.settings.emphasis | split: '. ' -%}
        <p class="pro-ask__emph-text">
          {%- if e_parts.size > 1 -%}
            {%- assign e_rest = section.settings.emphasis | remove_first: e_parts.first | remove_first: '. ' -%}
            <span class="pro-ask__emph-mute">{{ e_parts.first }}.</span> {{ e_rest }}
          {%- else -%}
            {{ section.settings.emphasis }}
          {%- endif -%}
        </p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "PRO - Ajanstan istenenler",
  "class": "pro-section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Üst etiket", "default": "Ajanslar için" },
    { "type": "text", "id": "title", "label": "Başlık", "default": "Siz sadece 4 şey gönderin." },
    { "type": "text", "id": "badge", "label": "Vurgu rozeti", "default": "24 saat" },
    { "type": "textarea", "id": "emphasis", "label": "Büyük vurgu metni", "default": "Gerisine karışmayın. 24 saat içinde etkinlik linkiniz hazır." }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Madde",
      "settings": [
        { "type": "select", "id": "icon", "label": "İkon", "default": "text", "options": [
          { "value": "text", "label": "Yazı" },
          { "value": "calendar", "label": "Takvim" },
          { "value": "image", "label": "Görsel" },
          { "value": "logo", "label": "Logo" },
          { "value": "qr", "label": "QR kod" },
          { "value": "check", "label": "Onay" }
        ] },
        { "type": "text", "id": "title", "label": "Başlık", "default": "Etkinlik adı" },
        { "type": "text", "id": "text", "label": "Kısa açıklama (isteğe bağlı)" }
      ]
    }
  ]
}
{% endschema %}
