    { "type": "color", "id": "kod_renk", "label": "İndirimli fiyat", "default": "#3E5E4A" },
    { "type": "color", "id": "etiket_renk", "label": "Fiyat üstü küçük etiket", "default": "#777777" },
    { "type": "color", "id": "fiyat_renk", "label": "Fiyat", "default": "#16181D" },
    { "type": "color", "id": "eski_renk", "label": "Üstü çizili fiyat", "default": "#999999" },
    { "type": "color", "id": "ayrac_renk", "label": "Kesik çizgi", "default": "#E3E5E8" },
    { "type": "color", "id": "kenar", "label": "Kart çerçevesi", "default": "#E3E5E8" },
    { "type": "color", "id": "koyu", "label": "Başlık ve ürün adı", "default": "#15171C" },
    { "type": "color", "id": "gri", "label": "Alt başlık", "default": "#6B7280" }
  ],
  "blocks": [
    {
      "type": "urun",
      "name": "Ürün kartı",
      "settings": [
        { "type": "product", "id": "urun", "label": "Ürün",
          "info": "Görsel, fiyat ve eski fiyat bu üründen gelir. Kart ürün sayfasına değil, kategorinin koleksiyonuna gider." },
        { "type": "select", "id": "kategori", "label": "Kategori",
          "options": [ { "value": "couple", "label": "Couple" }, { "value": "kadin", "label": "Kadın" }, { "value": "erkek", "label": "Erkek" } ],
