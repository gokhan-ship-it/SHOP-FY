    { "type": "text", "id": "erkek_link", "label": "Erkek linki", "default": "https://texttonext.com/collections/zaman-kapsulu-bileklik" },
    { "type": "url", "id": "couple_link", "label": "Couple linki",
      "info": "Boş bırakılırsa Couple kartları tıklanamaz görünür (bozuk link yerine linksiz kart)." },
    { "type": "text", "id": "couple_uyari_metin", "label": "Couple linki boşken editörde çıkan uyarı",
      "default": "Couple linkini girin — şu an Couple kartları tıklanamıyor.",
      "info": "Yalnızca tema editöründe görünür, canlı sitede hiç basılmaz." },

    { "type": "header", "content": "Kart metinleri" },
    { "type": "text", "id": "rozet_couple", "label": "Varsayılan rozet – Couple", "default": "2'li set" },
    { "type": "text", "id": "rozet_kadin", "label": "Varsayılan rozet – Kadın", "default": "Kadın" },
    { "type": "text", "id": "rozet_erkek", "label": "Varsayılan rozet – Erkek", "default": "Erkek" },
    { "type": "text", "id": "ust_couple", "label": "Varsayılan üst etiket – Couple", "default": "Couple Zaman Kapsülü" },
    { "type": "text", "id": "ust_tekli", "label": "Varsayılan üst etiket – Kadın/Erkek", "default": "Single Zaman Kapsülü" },
    { "type": "text", "id": "etiket_normal", "label": "Fiyatın üstündeki küçük etiket",
      "info": "Çark kodu yokken görünen satır. Boş bırakılırsa etiket çıkmaz." },
    { "type": "text", "id": "kod_etiket", "label": "Çark kodu geçerliyken küçük etiket", "default": "İNDİRİM KODU İLE" },
    { "type": "text", "id": "kisi_etiket", "label": "Couple kartında kesikli çizgi altı", "default": "Kişi başı [tutar]",
      "info": "[tutar] kişi başı tutarla değişir. Boş bırakılırsa satır çıkmaz." },
    { "type": "text", "id": "kadin_metin", "label": "Kadın kartında kesikli çizgi altı", "default": "Kadın koleksiyonunu gör" },
    { "type": "text", "id": "erkek_metin", "label": "Erkek kartında kesikli çizgi altı", "default": "Erkek koleksiyonunu gör" },
    { "type": "text", "id": "onceki", "label": "Sol ok – erişilebilirlik adı", "default": "Önceki kartlar" },
