    { "type": "color", "id": "zemin", "label": "Arka plan rengi", "default": "#F7F8FA" },
    { "type": "range", "id": "genislik", "label": "En fazla genişlik", "min": 600, "max": 1600, "step": 20, "unit": "px", "default": 1200 },
    { "type": "range", "id": "bosluk_ust_m", "label": "Üst boşluk – mobil", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "bosluk_alt_m", "label": "Alt boşluk – mobil", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "bosluk_ust_d", "label": "Üst boşluk – masaüstü", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 56 },
    { "type": "range", "id": "bosluk_alt_d", "label": "Alt boşluk – masaüstü", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 56 },

    { "type": "header", "content": "Renkler" },
    { "type": "color", "id": "rozet_zemin", "label": "Rozet ve üst etiket", "default": "#3E5E4A" },
