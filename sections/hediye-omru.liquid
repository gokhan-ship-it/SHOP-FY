      "options": [
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "p",
          "label": "Normal metin"
        }
      ]
    },
    {
      "type": "select",
      "id": "hizalama",
      "label": "Başlık hizası",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Sola"
        },
        {
          "value": "center",
          "label": "Ortaya"
        }
      ]
    },
    {
      "type": "select",
      "id": "baslik_kalinligi",
      "label": "Başlık kalınlığı",
      "default": "700",
      "options": [
        {
          "value": "500",
          "label": "Orta"
        },
        {
          "value": "600",
          "label": "Yarı kalın"
        },
        {
          "value": "700",
          "label": "Kalın"
        },
        {
          "value": "800",
          "label": "Çok kalın"
