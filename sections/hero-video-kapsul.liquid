            src="https://player.vimeo.com/video/{{ s.video_url.id }}?autoplay={% if s.otomatik_oynat %}1{% else %}0{% endif %}&muted={% if s.sessiz %}1{% else %}0{% endif %}&loop={% if s.dongu %}1{% else %}0{% endif %}&background={% if s.kontroller %}0{% else %}1{% endif %}"
            title="{{ s.baslik | strip_html | escape }}"
            allow="autoplay; fullscreen; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        {%- endif -%}
      {%- elsif s.poster != blank -%}
        {%- assign poster_alt = s.baslik | strip_html | escape -%}
        {{ s.poster | image_url: width: 1800 | image_tag: loading: 'lazy', alt: poster_alt }}
      {%- else -%}
        <span class="hv-ph">{{ s.video_bos_yazi }}</span>
      {%- endif -%}
    </div>
  </div>
