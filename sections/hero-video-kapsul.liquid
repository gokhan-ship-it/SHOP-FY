<script>
  (function () {
    if (window.hvKapsulReady) { window.hvKapsulInit(); return; }
    window.hvKapsulReady = true;

    var roots = [];

    /* Duraklatilabilen TEK zamanlayici.

       Ticker'da her an yalnizca bir bekleyis var. Diziyi bir zamanlayici
       yigini yerine bununla surdurmek, sekme arka plandan donunce
       zamanlayicilarin birikip ifadelerin ust uste binmesini yapisal
       olarak imkansiz kiliyor: kurulan her yeni bekleyis oncekini
       temizliyor. */
    function Sayac() { this.id = null; this.fn = null; this.kalan = 0; this.bas = 0; }
    Sayac.prototype.temizle = function () {
      if (this.id) { clearTimeout(this.id); this.id = null; }
    };
    Sayac.prototype.kur = function (fn, ms) {
      this.temizle();
      this.fn = fn;
      this.kalan = ms;
      this.bas = Date.now();
      this.id = setTimeout(fn, ms);
    };
    Sayac.prototype.duraklat = function () {
      if (!this.id) return;
      this.kalan -= (Date.now() - this.bas);
      if (this.kalan < 0) this.kalan = 0;
      this.temizle();
    };
    Sayac.prototype.surdur = function () {
      if (this.id || !this.fn) return;
      this.bas = Date.now();
      this.id = setTimeout(this.fn, this.kalan);
    };

    function stop(root) {
      if (root.hvTimer) { clearInterval(root.hvTimer); root.hvTimer = null; }
    }

    function start(root) {
      if (root.hvReduce || document.hidden) return;
      stop(root);
      if (root.hvStats.length < 2) return;
      root.hvTimer = setInterval(function () {
        root.hvIndex = (root.hvIndex + 1) % root.hvStats.length;
        for (var i = 0; i < root.hvStats.length; i++) {
          var on = i === root.hvIndex;
          root.hvStats[i].classList.toggle('is-on', on);
          root.hvStats[i].setAttribute('aria-hidden', on ? 'false' : 'true');
        }
      }, root.hvWait);
    }

    /* ===================== TICKER =====================
       Ifadeler DOM'da ust uste duruyor; sadece siradaki gorunur.
       Boylece pill her zaman en uzun ifadenin genisliginde kalir. */
    var GIRIS = 350;
    var CIKIS = 450;
    var CIKIS_ESKIME = 650;   /* 250ms cizgi + 400ms metin */
    var VURGU_EK = 800;       /* vurgulu ifade bu kadar fazla durur */

    function tickerKur(root) {
      var katman = root.querySelector('[data-hv-ticker]');
      if (!katman) return;
      /* Azaltilmis hareket: hic baslamiyor. CSS varsayilani vurgulu
         ifadeyi gosterdigi icin pill dolu kalir. */
      if (root.hvReduce) return;

      var ogeler = Array.prototype.slice.call(katman.querySelectorAll('.hv-tk'));
      if (!ogeler.length) return;

      katman.setAttribute('data-hv-ticker-on', '');

      if (ogeler.length === 1) {
        ogeler[0].classList.add('is-on');
        ogeler[0].setAttribute('data-durum', 'gir');
        return;
      }

      var bekleme = parseInt(katman.getAttribute('data-bekleme'), 10) || 1400;
      var sayac = new Sayac();
      root.hvSayac = sayac;
      var i = -1;

      function sonraki() {
        if (i > -1) {
          ogeler[i].classList.remove('is-on');
          ogeler[i].removeAttribute('data-durum');
        }
        i = (i + 1) % ogeler.length;
        var o = ogeler[i];
        var efekt = o.getAttribute('data-efekt');
        o.classList.add('is-on');
        o.setAttribute('data-durum', 'gir');

        var dur = efekt === 'vurgu' ? bekleme + VURGU_EK : bekleme;
        sayac.kur(function () {
          o.setAttribute('data-durum', 'cik');
          sayac.kur(sonraki, efekt === 'eskime' ? CIKIS_ESKIME : CIKIS);
        }, GIRIS + dur);
      }

      sonraki();
    }

    function setup(root) {
      if (!root || root.hvInited) return;
      root.hvInited = true;
      root.hvReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      root.hvStats = root.querySelectorAll('.hv-stat');
      root.hvIndex = 0;
      root.hvWait = parseInt(root.getAttribute('data-stat-wait'), 10) || 3500;
      root.hvBolum = root.closest ? root.closest('.shopify-section') : null;
      if (roots.indexOf(root) === -1) roots.push(root);
      start(root);
      tickerKur(root);
    }

    function teardown(root) {
      if (!root) return;
      stop(root);
      /* Tema duzenleyicide bolum yeniden cizilince eski dizinin
         zamanlayicisi bosa calisip yeni kopyaya karisirdi. */
      if (root.hvSayac) { root.hvSayac.temizle(); root.hvSayac = null; }
      root.hvInited = false;
      var i = roots.indexOf(root);
      if (i > -1) roots.splice(i, 1);
    }

    window.hvKapsulInit = function (scope) {
      var list = (scope || document).querySelectorAll('[data-hv-root]');
      for (var i = 0; i < list.length; i++) setup(list[i]);
    };

    document.addEventListener('visibilitychange', function () {
      for (var i = 0; i < roots.length; i++) {
        var r = roots[i];
        if (document.hidden) {
          stop(r);
          if (r.hvSayac) r.hvSayac.duraklat();
          if (r.hvBolum) r.hvBolum.setAttribute('data-hv-duraklat', '');
        } else {
          start(r);
          if (r.hvBolum) r.hvBolum.removeAttribute('data-hv-duraklat');
          if (r.hvSayac) r.hvSayac.surdur();
        }
      }
    });

    document.addEventListener('shopify:section:load', function (e) {
      window.hvKapsulInit(e.target);
    });
    document.addEventListener('shopify:section:unload', function (e) {
      var list = e.target.querySelectorAll('[data-hv-root]');
      for (var i = 0; i < list.length; i++) teardown(list[i]);
    });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () { window.hvKapsulInit(); });
    } else {
      window.hvKapsulInit();
    }
  })();
</script>

