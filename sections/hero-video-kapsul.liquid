{%- liquid
  assign sid = section.id
  assign s = section.settings
  assign stat_blocks = section.blocks | where: 'type', 'istatistik'
  assign ticker_blocks = section.blocks | where: 'type', 'ticker'

  comment
    DUZEN

    Bu bolum anasayfada da kullaniliyor (acik zeminli, farkli baslikli
    bir ornek). Yeni dizilim -- ticker + sabit baslik + log line +
    ALTA tasinmis sosyal kanit -- bu yuzden bir ayara bagli;
    varsayilan "klasik", yani mevcut ornekler oldugu gibi kaliyor.
    Yeni dizilimi istedigin ornekte tema editorunden seciyorsun.
  endcomment
  assign yeni = false
  if s.duzen == 'yeni'
    assign yeni = true
  endif

  comment
    TICKER IFADELERI

    Ifadeler BLOK; eklenip cikarilabiliyor ve siralanabiliyor. Ama
    mevcut bir bolum ornegine blok kendiliginden EKLENEMEZ -- yeni
    dizilime gecince ticker bos kalirdi. Bu yuzden blok yoksa
    yerlesik dort ifade devreye giriyor.
  endcomment
  assign tk_ham = ''
  if ticker_blocks.size > 0
    for block in ticker_blocks
      assign tk_ham = tk_ham | append: block.settings.metin | append: '|' | append: block.settings.ikon | append: '|' | append: block.settings.efekt | append: '~~'
    endfor
  else
    assign tk_ham = 'Çiçek solar|lale|solma~~Parfüm uçar|parfum|buharlasma~~Cüzdan eskir|cuzdan|eskime~~Kapsül kalır|kilit|vurgu~~'
  endif
  assign tk_items = tk_ham | split: '~~'
-%}

<style>
  #shopify-section-{{ sid }} .hv-root {
    background: {{ s.arkaplan }};
    padding-top: {{ s.p_top_m }}px;
    padding-bottom: {{ s.p_bot_m }}px;
  }
  #shopify-section-{{ sid }} .hv-inner {
    max-width: {{ s.max_w }}px;
    margin: 0 auto;
    padding-left: {{ s.edge_m }}px;
    padding-right: {{ s.edge_m }}px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: {% if s.hizalama == 'left' %}flex-start{% else %}center{% endif %};
    text-align: {% if s.hizalama == 'left' %}left{% else %}center{% endif %};
  }

  /* --- yildizlar + degisen istatistik (klasik dizilim) --- */
  #shopify-section-{{ sid }} .hv-social {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 {{ s.sosyal_bosluk }}px;
  }
  #shopify-section-{{ sid }} .hv-stars {
    flex: none;
    display: flex;
    align-items: center;
    gap: 2px;
    line-height: 0;
  }
  #shopify-section-{{ sid }} .hv-stars svg {
    width: {{ s.yildiz_boyutu }}px;
    height: {{ s.yildiz_boyutu }}px;
    display: block;
    fill: {{ s.yildiz_rengi }};
  }
  /* tek hucreli grid: kapsayici her zaman en uzun metnin olculerinde kalir,
     bu yuzden metin degisince yildizlar kipirdamaz ve layout shift olmaz */
  #shopify-section-{{ sid }} .hv-stats {
    display: grid;
    align-items: center;
    justify-items: start;
    text-align: left;
  }
  #shopify-section-{{ sid }} .hv-stat {
    grid-area: 1 / 1;
    margin: 0;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 400ms ease, transform 400ms ease;
    pointer-events: none;
    font-size: {{ s.istatistik_boyutu_mobil }}px;
    line-height: 1.35;
    font-weight: {{ s.istatistik_kalinligi }};
    color: {{ s.istatistik_rengi }};
    white-space: nowrap;
  }
  #shopify-section-{{ sid }} .hv-stat.is-on {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  /* --- baslik ve metin --- */
  #shopify-section-{{ sid }} .hv-title {
    margin: 0 0 {{ s.baslik_bosluk }}px;
    font-size: {{ s.baslik_boyutu_mobil }}px;
    line-height: 1.15;
    font-weight: {{ s.baslik_kalinligi }};
    color: {{ s.baslik_rengi }};
    text-wrap: balance;
    /* temanin kaydirma animasyonu bu bolume dokunmasin */
    opacity: 1 !important;
    transform: none !important;
    animation: none !important;
    visibility: visible !important;
  }
  #shopify-section-{{ sid }} .hv-body {
    margin: 0;
    max-width: {{ s.metin_genisligi }}px;
    font-size: {{ s.metin_boyutu_mobil }}px;
    line-height: 1.6;
    color: {{ s.metin_rengi }};
    opacity: 1 !important;
    transform: none !important;
    animation: none !important;
    visibility: visible !important;
  }
  #shopify-section-{{ sid }} .hv-body p { margin: 0 0 10px; }
  #shopify-section-{{ sid }} .hv-body p:last-child { margin-bottom: 0; }
  #shopify-section-{{ sid }} .hv-body a { color: inherit; }

  /* ==================================================================
     YENI DIZILIM
     ticker  ->  sabit H1  ->  log line  ->  sosyal kanit  ->  gorsel
     ================================================================== */
  #shopify-section-{{ sid }} .hv-gizli {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* --- Ticker pill ---
     Yukseklik SABIT (34px) ve ifadelerin tamami tek hucreli bir
     grid'te ust uste duruyor: pill her zaman EN UZUN ifadenin
     olculerinde kalir, ifade degisince ne pill ne de altindaki
     baslik/gorsel kipirdar. */
  #shopify-section-{{ sid }} .hv-ticker {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    position: relative;
    height: 34px;
    min-width: 170px;
    padding: 0 14px;
    border-radius: 999px;
    background: {{ s.ticker_zemin }};
    border: 1px solid {{ s.ticker_kenarlik }};
    margin: 0 0 18px;
  }
  #shopify-section-{{ sid }} .hv-tk-katman { display: grid; place-items: center; }
  #shopify-section-{{ sid }} .hv-tk {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    white-space: nowrap;
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    color: {{ s.ticker_rengi }};
    opacity: 0;
    will-change: transform, opacity, filter;
  }
  #shopify-section-{{ sid }} .hv-tk svg {
    width: 17px;
    height: 17px;
    flex: none;
    display: block;
  }
  #shopify-section-{{ sid }} .hv-tk-yazi { position: relative; }
  #shopify-section-{{ sid }} .hv-tk-cizgi {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1.5px;
    background: #8B939D;
    transform: scaleX(0);
    transform-origin: left center;
    pointer-events: none;
  }
  /* JS yokken / azaltilmis harekette ekranda duran ifade. */
  #shopify-section-{{ sid }} .hv-tk[data-efekt="vurgu"] {
    opacity: 1;
    color: {{ s.ticker_vurgu_rengi }};
    text-shadow: 0 0 12px rgba(159, 212, 189, .4);
  }
  /* JS devrede: gorunurlugu artik sira belirliyor. */
  #shopify-section-{{ sid }} .hv-tk-katman[data-hv-ticker-on] .hv-tk { opacity: 0; }

  @keyframes hv-tk-gir-{{ sid }} {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: none; }
  }
  #shopify-section-{{ sid }} .hv-tk[data-durum="gir"] {
    animation: hv-tk-gir-{{ sid }} 350ms ease forwards;
  }

  /* SOLMA: dusup donerek griye */
  @keyframes hv-tk-solma-{{ sid }} {
    from { opacity: 1; transform: none; color: {{ s.ticker_rengi }}; }
    to   { opacity: 0; transform: translateY(12px) rotate(8deg); color: #6B7280; }
  }
  #shopify-section-{{ sid }} .hv-tk[data-durum="cik"][data-efekt="solma"] {
    animation: hv-tk-solma-{{ sid }} 450ms cubic-bezier(.4,.1,.7,1) forwards;
  }

  /* BUHARLASMA: yukari kalkip bulaniklasarak (vurgulu ifade de bunu kullanir) */
  @keyframes hv-tk-buhar-{{ sid }} {
    from { opacity: 1; transform: none; filter: blur(0); }
    to   { opacity: 0; transform: translateY(-12px) scale(1.1); filter: blur(4px); }
  }
  #shopify-section-{{ sid }} .hv-tk[data-durum="cik"][data-efekt="buharlasma"],
  #shopify-section-{{ sid }} .hv-tk[data-durum="cik"][data-efekt="vurgu"] {
    animation: hv-tk-buhar-{{ sid }} 450ms ease-out forwards;
  }

  /* ESKIME: once cizgi soldan saga, sonra metin koyu griye */
  @keyframes hv-tk-cizgi-{{ sid }} {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }
  @keyframes hv-tk-eski-{{ sid }} {
    from { opacity: 1; color: {{ s.ticker_rengi }}; filter: blur(0); }
    to   { opacity: 0; color: #3A4048; filter: blur(1px); }
  }
  #shopify-section-{{ sid }} .hv-tk[data-durum="cik"][data-efekt="eskime"] .hv-tk-cizgi {
    animation: hv-tk-cizgi-{{ sid }} 250ms ease-out forwards;
  }
  #shopify-section-{{ sid }} .hv-tk[data-durum="cik"][data-efekt="eskime"] {
    /* Cizgi bittikten sonra basliyor. */
    animation: hv-tk-eski-{{ sid }} 400ms ease-in 250ms forwards;
  }

  /* Sekme arka plandayken kare kare donmesin. */
  #shopify-section-{{ sid }}[data-hv-duraklat] .hv-tk,
  #shopify-section-{{ sid }}[data-hv-duraklat] .hv-tk-cizgi {
    animation-play-state: paused;
  }

  /* --- Sabit baslik + log line + sosyal kanit --- */
  #shopify-section-{{ sid }} .hv-yeni .hv-title {
    margin-bottom: 0;
    letter-spacing: -0.02em;
  }
  #shopify-section-{{ sid }} .hv-vurgu {
    font-style: normal;
    color: {{ s.ticker_vurgu_rengi }};
  }
  #shopify-section-{{ sid }} .hv-log {
    margin: 10px 0 0;
    max-width: 320px;
    font-size: 14px;
    line-height: 1.55;
    color: {{ s.log_rengi }};
  }
  #shopify-section-{{ sid }} .hv-log p { margin: 0 0 8px; }
  #shopify-section-{{ sid }} .hv-log p:last-child { margin-bottom: 0; }
  #shopify-section-{{ sid }} .hv-kanit {
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 14px 0 0;
    font-size: 12px;
    line-height: 1.3;
    color: {{ s.kanit_rengi }};
  }
  #shopify-section-{{ sid }} .hv-kanit-yildiz {
    flex: none;
    display: flex;
    align-items: center;
    gap: 1px;
    line-height: 0;
  }
  #shopify-section-{{ sid }} .hv-kanit-yildiz svg {
    width: 13px;
    height: 13px;
    display: block;
    fill: {{ s.kanit_yildiz_rengi }};
  }

  /* --- 21:9 video alani --- */
  #shopify-section-{{ sid }} .hv-media {
    position: relative;
    width: 100%;
    max-width: {{ s.video_genisligi }}px;
    margin-top: {{ s.video_bosluk }}px;
    aspect-ratio: {{ s.oran }};
    border-radius: {{ s.video_kose }}px;
    overflow: hidden;
    background: {{ s.video_arkaplan }};
    {% if s.video_kenarlik %}border: 1px solid {{ s.video_kenarlik_rengi }};{% endif %}
  }
  #shopify-section-{{ sid }} .hv-media video,
  #shopify-section-{{ sid }} .hv-media iframe,
  #shopify-section-{{ sid }} .hv-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border: 0;
  }
  #shopify-section-{{ sid }} .hv-ph {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 16px;
    text-align: center;
    font-size: 13px;
    line-height: 1.4;
    color: {{ s.metin_rengi }};
  }

  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .hv-root {
      padding-top: {{ s.p_top_d }}px;
      padding-bottom: {{ s.p_bot_d }}px;
    }
    #shopify-section-{{ sid }} .hv-inner {
      padding-left: {{ s.edge_d }}px;
      padding-right: {{ s.edge_d }}px;
    }
    #shopify-section-{{ sid }} .hv-stat { font-size: {{ s.istatistik_boyutu }}px; }
    #shopify-section-{{ sid }} .hv-title { font-size: {{ s.baslik_boyutu_tablet }}px; }
    #shopify-section-{{ sid }} .hv-body { font-size: {{ s.metin_boyutu }}px; }
    #shopify-section-{{ sid }} .hv-log { max-width: 520px; font-size: 15px; }
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .hv-title { font-size: {{ s.baslik_boyutu }}px; }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .hv-stat { transition: none; transform: none; }
    /* Ticker JS tarafinda zaten hic baslamiyor; bu kurallar emniyet
       kemeri -- bir sekilde baslasa bile vurgulu ifade sabit kalir. */
    #shopify-section-{{ sid }} .hv-tk { animation: none !important; }
    #shopify-section-{{ sid }} .hv-tk-katman[data-hv-ticker-on] .hv-tk { opacity: 0; }
    #shopify-section-{{ sid }} .hv-tk[data-efekt="vurgu"] { opacity: 1 !important; }
  }
</style>

<div class="hv-root">
  <div
    class="hv-inner{% if yeni %} hv-yeni{% endif %}"
    data-hv-root
    data-stat-wait="{{ s.istatistik_bekleme_suresi | times: 1000 | round }}"
  >
    {%- if yeni -%}
      {%- comment -%}
        ----- 1) TICKER -----
        Ekran okuyucu donen ifadeleri degil, tek bir ozet cumle duyar.
      {%- endcomment -%}
      {%- if s.ticker_ac -%}
        {%- capture tk_ozet -%}
          {%- for item in tk_items -%}
            {%- assign p = item | split: '|' -%}
            {{- p[0] -}}{%- if forloop.last -%}.{%- else -%}, {% endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        <div class="hv-ticker">
          <span class="hv-gizli">{{ tk_ozet | strip }}</span>
          <span
            class="hv-tk-katman"
            aria-hidden="true"
            data-hv-ticker
            data-bekleme="{{ s.ticker_bekleme | times: 1000 | round }}"
          >
            {%- for item in tk_items -%}
              {%- assign p = item | split: '|' -%}
              {%- assign bidx = forloop.index0 -%}
              {%- assign bblock = ticker_blocks[bidx] -%}
              <span
                class="hv-tk"
                data-efekt="{{ p[2] | default: 'solma' | escape }}"
                {% if bblock %}{{ bblock.shopify_attributes }}{% endif %}
              >
                {%- case p[1] -%}
                  {%- when 'parfum' -%}
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M10 2.8h4v3h-4z"/>
                      <path d="M8.4 9.4a3 3 0 0 1 2.3-3.6h2.6a3 3 0 0 1 2.3 3.6l-.5 9a2 2 0 0 1-2 1.9h-2.2a2 2 0 0 1-2-1.9z"/>
                      <path d="M18.6 6.6h1.8M18.6 9.6h1.8M18.6 12.6h1.8"/>
                    </svg>
                  {%- when 'cuzdan' -%}
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M4.2 7.4a2 2 0 0 1 2-2h11a1.6 1.6 0 0 1 1.6 1.6v1.4"/>
                      <path d="M4.2 7.4v9.8a2 2 0 0 0 2 2h11.6a1.6 1.6 0 0 0 1.6-1.6v-6.4a1.6 1.6 0 0 0-1.6-1.6H6.2a2 2 0 0 1-2-2z"/>
                      <path d="M16.2 13.3h.01"/>
                    </svg>
                  {%- when 'kilit' -%}
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="4.8" y="10.4" width="14.4" height="9.4" rx="2"/>
                      <path d="M8.2 10.4V7.6a3.8 3.8 0 0 1 7.6 0v2.8"/>
                      <path d="M12 14.2v2"/>
                    </svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M8.6 4.6 V8.2 a3.4 3.4 0 0 0 6.8 0 V4.6 L13.7 6.6 L12 4 L10.3 6.6 Z"/>
                      <path d="M12 11.6 V21"/>
                      <path d="M12 17.5 C9.2 17.2 7.6 15.2 7.2 12.8 C9.8 13.3 11.6 15 12 17.5"/>
                    </svg>
                {%- endcase -%}
                <span class="hv-tk-yazi">{{ p[0] | escape }}<i class="hv-tk-cizgi"></i></span>
              </span>
            {%- endfor -%}
          </span>
        </div>
      {%- endif -%}

      {%- comment -%}
        ----- 2) SABIT BASLIK (sayfanin gercek H1'i) -----
        Vurgulanacak kisim baslikta geciyorsa <em> ile isaretleniyor.
      {%- endcomment -%}
      {%- assign bas = s.sabit_baslik | default: 'Bu, bir ömür saklar.' -%}
      <h1 class="hv-title">
        {%- if s.sabit_vurgu != blank and bas contains s.sabit_vurgu -%}
          {%- assign parcalar = bas | split: s.sabit_vurgu -%}
          {%- for parca in parcalar -%}
            {%- unless forloop.first -%}<em class="hv-vurgu">{{ s.sabit_vurgu | escape }}</em>{%- endunless -%}
            {{- parca | escape -}}
          {%- endfor -%}
          {%- comment -%}
            split sondaki BOS parcayi atiyor: vurgu basligin sonundaysa
            dongude hic <em> basilmaz ve vurgu sessizce kaybolurdu.
            Kuyruk acikca olculup tamamlaniyor.
          {%- endcomment -%}
          {%- assign vlen = s.sabit_vurgu.size -%}
          {%- assign neg = 0 | minus: vlen -%}
          {%- assign kuyruk = bas | slice: neg, vlen -%}
          {%- if kuyruk == s.sabit_vurgu -%}<em class="hv-vurgu">{{ s.sabit_vurgu | escape }}</em>{%- endif -%}
        {%- else -%}
          {{- bas | escape -}}
        {%- endif -%}
      </h1>

      {%- comment -%} ----- 3) LOG LINE ----- {%- endcomment -%}
      {%- if s.log_line != blank -%}
        <div class="hv-log rte">{{ s.log_line }}</div>
      {%- endif -%}

      {%- comment -%} ----- 4) SOSYAL KANIT (en ustten buraya tasindi) ----- {%- endcomment -%}
      {%- if s.kanit_metin != blank -%}
        <div class="hv-kanit">
          <span class="hv-kanit-yildiz" role="img" aria-label="5 üzerinden 5 yıldız">
            {%- for i in (1..5) -%}
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M12 2.4l2.9 5.88 6.49.94-4.7 4.58 1.11 6.46L12 17.2l-5.8 3.06 1.11-6.46-4.7-4.58 6.49-.94z"/>
              </svg>
            {%- endfor -%}
          </span>
          <span>{{ s.kanit_metin }}</span>
        </div>
      {%- endif -%}
    {%- else -%}
      {%- comment -%} ===== KLASIK DIZILIM (anasayfa ornegi bunu kullaniyor) ===== {%- endcomment -%}
      {%- if s.yildiz_goster or stat_blocks.size > 0 -%}
        <div class="hv-social">
          {%- if s.yildiz_goster -%}
            <span class="hv-stars" role="img" aria-label="5 üzerinden 5 yıldız">
              {%- for i in (1..5) -%}
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M12 2.4l2.9 5.88 6.49.94-4.7 4.58 1.11 6.46L12 17.2l-5.8 3.06 1.11-6.46-4.7-4.58 6.49-.94z"/>
                </svg>
              {%- endfor -%}
            </span>
          {%- endif -%}
          {%- if stat_blocks.size > 0 -%}
            <div class="hv-stats" aria-live="off">
              {%- for block in stat_blocks -%}
                <p
                  class="hv-stat{% if forloop.first %} is-on{% endif %}"
                  aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
                  {{ block.shopify_attributes }}
                >{{ block.settings.metin }}</p>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if s.baslik != blank -%}
        <{{ s.baslik_etiketi }} class="hv-title">{{ s.baslik }}</{{ s.baslik_etiketi }}>
      {%- endif -%}

      {%- if s.metin != blank -%}
        <div class="hv-body rte">{{ s.metin }}</div>
      {%- endif -%}
    {%- endif -%}

    {%- comment -%} ----- 5) URUN GORSELI / VIDEO (degismedi) ----- {%- endcomment -%}
    <div class="hv-media">
      {%- if s.video != blank -%}
        {{
          s.video
          | video_tag:
            image_size: '1600x',
            autoplay: s.otomatik_oynat,
            loop: s.dongu,
            muted: s.sessiz,
            controls: s.kontroller,
            playsinline: true
        }}
      {%- elsif s.video_url != blank -%}
        {%- if s.video_url.type == 'youtube' -%}
          <iframe
            src="https://www.youtube.com/embed/{{ s.video_url.id }}?autoplay={% if s.otomatik_oynat %}1{% else %}0{% endif %}&mute={% if s.sessiz %}1{% else %}0{% endif %}&loop={% if s.dongu %}1{% else %}0{% endif %}&playlist={{ s.video_url.id }}&controls={% if s.kontroller %}1{% else %}0{% endif %}&rel=0&playsinline=1&modestbranding=1"
            title="{{ s.baslik | strip_html | escape }}"
            allow="autoplay; encrypted-media; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        {%- elsif s.video_url.type == 'vimeo' -%}
