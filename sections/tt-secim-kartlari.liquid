    { "type": "text", "id": "gizle_secici", "label": "Couple modunda gizlenecek öğeler (CSS seçici)",
      "default": "facet-sticky.facet-sticky",
      "info": "Yapışkan çubukla çakışan öğeler. Virgülle ayırın." },

    { "type": "header", "content": "Varyant seçici" },
    { "type": "text", "id": "varyant_baslik", "label": "Başlık", "default": "Seçenek seç" },
    { "type": "text", "id": "kapat_etiket", "label": "Kapat (ekran okuyucu)", "default": "Kapat" },

    { "type": "header", "content": "Görünüm" },
    { "type": "range", "id": "genislik", "label": "En fazla genişlik", "min": 800, "max": 1600, "step": 20, "unit": "px", "default": 1200 },
    { "type": "select", "id": "urun_sutun_m", "label": "Ürün sütunu — telefon", "default": "2",
      "options": [ { "value": "1", "label": "1 sütun" }, { "value": "2", "label": "2 sütun" } ],
