    { "type": "text", "id": "kime_kadin", "label": "Kadın", "default": "Kadın" },
    { "type": "text", "id": "kime_erkek", "label": "Erkek", "default": "Erkek" },
    { "type": "text", "id": "sayac_eki", "label": "Sayaç eki", "default": "ürün" },
    { "type": "text", "id": "bos_metin", "label": "Sonuç boşsa", "default": "Bu seçimle eşleşen ürün kalmadı." },

    { "type": "header", "content": "Setini oluştur kutusu" },
