    { "type": "text", "id": "uk_kampanya", "label": "Kampanya rozeti metni", "default": "%[indirim] indirim",
      "info": "Yalnızca karşılaştırma fiyatı satış fiyatından BÜYÜKSE çıkar. [indirim] yuvarlanmış yüzdeyle değişir." },
    { "type": "text", "id": "uk_tukendi", "label": "\"Tükendi\" metni", "default": "Tükendi" },
