    { "type": "text", "id": "dugme_tam", "label": "Buton – 2 ürün seçiliyken", "default": "2 ürünü sepete ekle" },
    { "type": "text", "id": "uyari_metin", "label": "Eksik seçimle basılırsa", "default": "Sete bir ürün daha seç." },
    { "type": "text", "id": "hata_metin", "label": "Sepete eklenemezse", "default": "Sepete eklenemedi. Ürünlerden biri tükenmiş olabilir." },
    { "type": "checkbox", "id": "tutar_goster", "label": "Çubukta toplam tutarı göster", "default": true,
      "info": "Tutar bir tahmindir: pahalı ürün tam, ucuz ürün yarı fiyat. Gerçek tutarı Shopify sepette hesaplar. Kapatırsanız tutar yerine teklif metni çıkar." },
    { "type": "text", "id": "tutar_yerine", "label": "Tutar kapalıyken yazılacak", "default": "İkincisi yarı fiyatına",
