    { "type": "text", "id": "kadin_koleksiyon", "label": "Couple – kadın koleksiyonu (handle)", "default": "zaman-kapsulu-kolyeler" },
    { "type": "text", "id": "erkek_koleksiyon", "label": "Couple – erkek koleksiyonu (handle)", "default": "zaman-kapsulu-bileklik" },
    { "type": "select", "id": "tekil_izgara", "label": "Single modunda ürün ızgarası", "default": "kendi",
