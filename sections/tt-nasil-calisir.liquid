    { "type": "text", "id": "kapat_etiket", "label": "Kapat butonu (ekran okuyucu)", "default": "Kapat" },

    { "type": "header", "content": "1. kart" },
    { "type": "text", "id": "kart1_baslik", "label": "Başlık", "default": "Couple Zaman Kapsülü nasıl çalışır?" },
    { "type": "text", "id": "kart1_alt", "label": "Açıklama", "default": "2 ürün · Buluşunca açılır" },
    { "type": "url", "id": "kart1_url", "label": "Bağlantı" },
    { "type": "select", "id": "kart1_ikon", "label": "İkon", "default": "halkalar",
      "options": [
        { "value": "halkalar", "label": "İç içe iki halka (couple)" },
        { "value": "takvim-kalp", "label": "Kalpli takvim" },
        { "value": "oklar", "label": "Karşılıklı oklar" },
        { "value": "kilit", "label": "Kilit" },
        { "value": "parilti", "label": "Parıltı" }
      ] },

    { "type": "header", "content": "2. kart" },
    { "type": "text", "id": "kart2_baslik", "label": "Başlık", "default": "Single Zaman Kapsülü nasıl çalışır?" },
    { "type": "text", "id": "kart2_alt", "label": "Açıklama", "default": "1 ürün · Belirlediğin tarihte açılır" },
