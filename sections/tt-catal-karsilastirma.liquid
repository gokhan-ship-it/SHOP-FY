{%- liquid
  assign sid = section.id
  assign s = section.settings

  comment
    Catal karsilastirma bolumu.

    Amac: Single ve Couple kapsulu ortak eksende karsilastirmak. Ayni soru
    ikisine de soruluyor, cevaplar iki kolonda alt alta hizali duruyor.

    Bu bolum mevcut "story-choice-cards" bolumunden tamamen bagimsiz calisir;
    o bolum gizlense veya kaldirilsa bile buradaki hicbir sey bozulmaz.

    Vurgu kurali: yalnizca 3. satir ("Ne zaman acilir?") CTA renginde ve 500
    agirlikta. Karar o satirda veriliyor. Ikinci bir vurgulu satir yok.

    Butun metinler, iki buton linki ve iki gorsel tema editorunden yonetilir.
  endcomment
-%}
<style>
  .tt-catal-{{ sid }} {
    /* Renk katmani. Hepsi tema editorunden yonetiliyor; buradaki degerler
       yalnizca ayar bosaltilirsa devreye giren guvenlik agi. Varsayilanlar
       temanin Apple paletiyle ayni (CTA #0071e3). */
    --tt-catal-bg: {{ s.c_bg | default: '#000000' }};
    --tt-catal-surface: {{ s.c_surface | default: '#1d1d1f' }};
    --tt-catal-media: {{ s.c_media | default: '#000000' }};
    --tt-catal-line: {{ s.c_line | default: '#2a2a2c' }};
    --tt-catal-pill-bg: {{ s.c_pill_bg | default: '#2d2d2f' }};
    --tt-catal-text: {{ s.c_text | default: '#f5f5f7' }};
    --tt-catal-muted: {{ s.c_muted | default: '#86868b' }};
    --tt-catal-cta: {{ s.c_cta | default: '#0071e3' }};
    --tt-catal-name: {{ s.c_name | default: '#0071e3' }};
    --tt-catal-btn-text: {{ s.c_btn_text | default: '#ffffff' }};

    /* Bosluk olcegi: 4px tabanli, ara deger kullanilmiyor. */
    --tt-catal-s2: 8px;
    --tt-catal-s3: 12px;
    --tt-catal-s4: 16px;
    --tt-catal-s6: 24px;
    --tt-catal-s8: 32px;

    /* Kolon araligi ve hairline tek yerden yonetiliyor. */
    --tt-catal-gap: 10px;
    --tt-catal-hair: 0.5px;
    --tt-catal-radius: 12px;
    --tt-catal-radius-in: 8px;
    --tt-catal-max: 680px;

    /* Tipografi olcegi (mobil). Kirilma noktalarinda topluca buyuyor. */
    --tt-catal-fs-h: 24px;
    --tt-catal-fs-sub: 16px;
    --tt-catal-fs-pill: 11px;
    --tt-catal-fs-name: 15px;
    --tt-catal-fs-q: 12px;
    --tt-catal-fs-a: 13px;
    --tt-catal-fs-btn: 14px;

    background: var(--tt-catal-bg);
    padding-top: var(--tt-catal-s8);
    padding-bottom: var(--tt-catal-s8);
  }
  .tt-catal-inner-{{ sid }} {
    max-width: var(--tt-catal-max);
    margin: 0 auto;
    padding-left: var(--tt-catal-s4);
    padding-right: var(--tt-catal-s4);
  }

  /* --- Bolum basligi --- */
  .tt-catal-head-{{ sid }} {
    text-align: center;
  }
  .tt-catal-title-{{ sid }} {
    margin: 0;
    font-size: var(--tt-catal-fs-h);
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--tt-catal-text);
    text-wrap: balance;
  }
  .tt-catal-sub-{{ sid }} {
    margin: var(--tt-catal-s2) 0 0;
    font-size: var(--tt-catal-fs-sub);
    line-height: 1.5;
    font-weight: 400;
    color: var(--tt-catal-muted);
  }

  /* --- Ortak eksen: tum kolonlu bloklar ayni izgarayi kullanir --- */
  .tt-catal-cols-{{ sid }},
  .tt-catal-pair-{{ sid }} {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--tt-catal-gap);
  }
  .tt-catal-cols-{{ sid }} {
    margin-top: var(--tt-catal-s6);
  }

  /* --- Ust blok: kartlar --- */
  .tt-catal-card-{{ sid }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: var(--tt-catal-surface);
    border: var(--tt-catal-hair) solid var(--tt-catal-line);
    border-radius: var(--tt-catal-radius);
    padding: var(--tt-catal-s3);
  }
  .tt-catal-pill-{{ sid }} {
    display: inline-block;
    margin: 0;
    padding: 5px 10px;
    background: var(--tt-catal-pill-bg);
    border-radius: 40px;
    font-size: var(--tt-catal-fs-pill);
    line-height: 1.2;
    font-weight: 600;
    color: var(--tt-catal-text);
    white-space: nowrap;
  }
  .tt-catal-media-{{ sid }} {
    width: 100%;
    margin-top: var(--tt-catal-s3);
    /* Iki kolonda ayni oran: hizalama hicbir durumda kaymaz. */
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--tt-catal-media);
    border: var(--tt-catal-hair) solid var(--tt-catal-line);
    border-radius: var(--tt-catal-radius-in);
  }
  .tt-catal-media-{{ sid }} img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Gorsel secilmediginde gosterilen basit yer tutucu. */
  .tt-catal-ph-{{ sid }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: var(--tt-catal-muted);
  }
  .tt-catal-ph-{{ sid }} svg {
    width: 60%;
    height: auto;
  }
  /* Kart adi rengi ayri bir ayar: vurgulu satirdan bagimsiz degistirilebilsin. */
  .tt-catal-name-{{ sid }} {
    margin: var(--tt-catal-s3) 0 0;
    font-size: var(--tt-catal-fs-name);
    line-height: 1.3;
    font-weight: 600;
    color: var(--tt-catal-name);
    text-align: center;
  }

  /* --- Karsilastirma satirlari --- */
  .tt-catal-rows-{{ sid }} {
    margin-top: var(--tt-catal-s6);
    border-bottom: var(--tt-catal-hair) solid var(--tt-catal-line);
  }
  .tt-catal-row-{{ sid }} {
    padding-top: var(--tt-catal-s3);
    padding-bottom: var(--tt-catal-s3);
    border-top: var(--tt-catal-hair) solid var(--tt-catal-line);
  }
  .tt-catal-q-{{ sid }} {
    /* Soru iki kolonu birlikte kapliyor ve ortalanmis. */
    margin: 0 0 var(--tt-catal-s2);
    text-align: center;
    font-size: var(--tt-catal-fs-q);
    line-height: 1.4;
    font-weight: 400;
    color: var(--tt-catal-muted);
  }
  .tt-catal-a-{{ sid }} {
    margin: 0;
    text-align: center;
    font-size: var(--tt-catal-fs-a);
    line-height: 1.4;
    font-weight: 400;
    color: var(--tt-catal-text);
    /* Kisa cevaplarda kelime ortasindan kirilma olmasin. */
    overflow-wrap: break-word;
    text-wrap: balance;
  }
  /* Tek vurgulu satir: karar bu satirda veriliyor. */
  .tt-catal-row-vurgu-{{ sid }} .tt-catal-a-{{ sid }} {
    color: var(--tt-catal-cta);
    font-weight: 500;
  }

  /* --- Butonlar --- */
  .tt-catal-btns-{{ sid }} {
    margin-top: var(--tt-catal-s6);
  }
  .tt-catal-btn-{{ sid }} {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: var(--tt-catal-s3) var(--tt-catal-s4);
    background: var(--tt-catal-cta);
    border-radius: 10px;
    font-size: var(--tt-catal-fs-btn);
    line-height: 1.2;
    font-weight: 500;
    color: var(--tt-catal-btn-text);
    text-align: center;
    text-decoration: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .tt-catal-btn-{{ sid }}:hover { opacity: .85; }
  }

  /* --- Tablet --- */
  @media (min-width: 768px) {
    .tt-catal-{{ sid }} {
      --tt-catal-gap: var(--tt-catal-s4);
      --tt-catal-fs-h: 28px;
      --tt-catal-fs-sub: 18px;
      --tt-catal-fs-pill: 12px;
      --tt-catal-fs-name: 17px;
      --tt-catal-fs-q: 13px;
      --tt-catal-fs-a: 15px;
      --tt-catal-fs-btn: 15px;
    }
  }

  /* --- Masaustu --- */
  @media (min-width: 1024px) {
    .tt-catal-{{ sid }} {
      --tt-catal-fs-h: 32px;
      --tt-catal-fs-sub: 20px;
      --tt-catal-fs-name: 18px;
      --tt-catal-fs-q: 14px;
      --tt-catal-fs-a: 16px;
      --tt-catal-fs-btn: 16px;
      padding-top: 48px;
      padding-bottom: 48px;
    }
    .tt-catal-inner-{{ sid }} {
      padding-left: var(--tt-catal-s6);
      padding-right: var(--tt-catal-s6);
    }
    .tt-catal-cols-{{ sid }},
    .tt-catal-rows-{{ sid }},
    .tt-catal-btns-{{ sid }} {
      margin-top: var(--tt-catal-s8);
    }
    .tt-catal-card-{{ sid }} {
      padding: var(--tt-catal-s4);
    }
    .tt-catal-row-{{ sid }} {
      padding-top: var(--tt-catal-s4);
      padding-bottom: var(--tt-catal-s4);
    }
  }
</style>

<div class="tt-catal-{{ sid }}">
  <div class="tt-catal-inner-{{ sid }}">

    {%- if s.heading != blank or s.subheading != blank -%}
      <div class="tt-catal-head-{{ sid }}">
        {%- if s.heading != blank -%}
          <h2 class="tt-catal-title-{{ sid }}">{{ s.heading }}</h2>
        {%- endif -%}
        {%- if s.subheading != blank -%}
          <p class="tt-catal-sub-{{ sid }}">{{ s.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} Ust blok: iki kolon, esit genislik. {%- endcomment -%}
    <div class="tt-catal-cols-{{ sid }}">

      <div class="tt-catal-card-{{ sid }}">
        {%- if s.label_a != blank -%}
          <p class="tt-catal-pill-{{ sid }}">{{ s.label_a }}</p>
        {%- endif -%}
        <div class="tt-catal-media-{{ sid }}">
          {%- if s.image_a != blank -%}
            {{ s.image_a | image_url: width: 800 | image_tag: loading: 'lazy', alt: s.name_a }}
          {%- else -%}
            {%- comment -%} Yer tutucu: tek kapsul + kilit. {%- endcomment -%}
            <span class="tt-catal-ph-{{ sid }}">
              <svg viewBox="0 0 96 72" fill="none" stroke="currentColor" stroke-width="1.5"
                   stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <rect x="34" y="19" width="15" height="34" rx="7.5"/>
                <path d="M34 36h15"/>
                <rect x="59" y="34" width="13" height="10" rx="2"/>
                <path d="M62.5 34v-3.5a3 3 0 0 1 6 0V34"/>
              </svg>
            </span>
          {%- endif -%}
        </div>
        {%- if s.name_a != blank -%}
          <p class="tt-catal-name-{{ sid }}">{{ s.name_a }}</p>
        {%- endif -%}
      </div>

      <div class="tt-catal-card-{{ sid }}">
        {%- if s.label_b != blank -%}
          <p class="tt-catal-pill-{{ sid }}">{{ s.label_b }}</p>
        {%- endif -%}
        <div class="tt-catal-media-{{ sid }}">
          {%- if s.image_b != blank -%}
            {{ s.image_b | image_url: width: 800 | image_tag: loading: 'lazy', alt: s.name_b }}
          {%- else -%}
            {%- comment -%} Yer tutucu: iki kapsul + birlesme. {%- endcomment -%}
            <span class="tt-catal-ph-{{ sid }}">
              <svg viewBox="0 0 96 72" fill="none" stroke="currentColor" stroke-width="1.5"
                   stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <rect x="25" y="19" width="15" height="34" rx="7.5"/>
                <path d="M25 36h15"/>
                <rect x="56" y="19" width="15" height="34" rx="7.5"/>
                <path d="M56 36h15"/>
                <path d="M44.5 32.5 48 36l-3.5 3.5"/>
                <path d="M51.5 32.5 48 36l3.5 3.5"/>
              </svg>
            </span>
          {%- endif -%}
        </div>
        {%- if s.name_b != blank -%}
          <p class="tt-catal-name-{{ sid }}">{{ s.name_b }}</p>
        {%- endif -%}
      </div>

    </div>

    {%- comment -%}
      Karsilastirma satirlari. Her satir: ortalanmis soru + iki kolon cevap.
      Kolonlar ust bloktakiyle ayni izgarada, cevaplar alt alta hizali.
    {%- endcomment -%}
    <div class="tt-catal-rows-{{ sid }}">

      <div class="tt-catal-row-{{ sid }}">
        {%- if s.q1 != blank -%}<p class="tt-catal-q-{{ sid }}">{{ s.q1 }}</p>{%- endif -%}
        <div class="tt-catal-pair-{{ sid }}">
          <p class="tt-catal-a-{{ sid }}">{{ s.a1_a }}</p>
          <p class="tt-catal-a-{{ sid }}">{{ s.a1_b }}</p>
        </div>
      </div>

      <div class="tt-catal-row-{{ sid }}">
        {%- if s.q2 != blank -%}<p class="tt-catal-q-{{ sid }}">{{ s.q2 }}</p>{%- endif -%}
        <div class="tt-catal-pair-{{ sid }}">
          <p class="tt-catal-a-{{ sid }}">{{ s.a2_a }}</p>
          <p class="tt-catal-a-{{ sid }}">{{ s.a2_b }}</p>
        </div>
      </div>

      {%- comment -%} Tek vurgulu satir. {%- endcomment -%}
      <div class="tt-catal-row-{{ sid }} tt-catal-row-vurgu-{{ sid }}">
        {%- if s.q3 != blank -%}<p class="tt-catal-q-{{ sid }}">{{ s.q3 }}</p>{%- endif -%}
        <div class="tt-catal-pair-{{ sid }}">
          <p class="tt-catal-a-{{ sid }}">{{ s.a3_a }}</p>
          <p class="tt-catal-a-{{ sid }}">{{ s.a3_b }}</p>
        </div>
      </div>

      <div class="tt-catal-row-{{ sid }}">
        {%- if s.q4 != blank -%}<p class="tt-catal-q-{{ sid }}">{{ s.q4 }}</p>{%- endif -%}
        <div class="tt-catal-pair-{{ sid }}">
          <p class="tt-catal-a-{{ sid }}">{{ s.a4_a }}</p>
          <p class="tt-catal-a-{{ sid }}">{{ s.a4_b }}</p>
        </div>
      </div>

    </div>

    {%- comment -%} Butonlar kolonlarla ayni izgarada hizali. {%- endcomment -%}
    <div class="tt-catal-btns-{{ sid }} tt-catal-pair-{{ sid }}">
      <a class="tt-catal-btn-{{ sid }}" href="{{ s.btn_a_link | default: '#' }}">{{ s.btn_a_label }}</a>
      <a class="tt-catal-btn-{{ sid }}" href="{{ s.btn_b_link | default: '#' }}">{{ s.btn_b_label }}</a>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Çatal Karşılaştırma",
  "tag": "section",
  "class": "tt-catal-section",
  "settings": [
    { "type": "header", "content": "Bölüm başlığı" },
    {
      "type": "text",
      "id": "heading",
      "label": "Başlık",
      "default": "Sana en uygun kapsülü seç."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Alt başlık",
      "default": "İki farklı deneyim."
    },

    { "type": "header", "content": "Sol kolon" },
    {
      "type": "text",
      "id": "label_a",
      "label": "Etiket",
      "default": "Hediye et"
    },
    {
      "type": "image_picker",
      "id": "image_a",
      "label": "Mekanizma görseli",
      "info": "Seçilmezse tek kapsül + kilit yer tutucusu gösterilir. Sağ kolonla aynı oranda (4:3) kırpılır."
    },
    {
      "type": "text",
      "id": "name_a",
      "label": "Kart adı",
      "default": "Single Kapsül"
    },
    {
      "type": "text",
      "id": "btn_a_label",
      "label": "Buton metni",
      "default": "Single'ı seç"
    },
    {
      "type": "url",
      "id": "btn_a_link",
      "label": "Buton linki"
    },

    { "type": "header", "content": "Sağ kolon" },
    {
      "type": "text",
      "id": "label_b",
      "label": "Etiket",
      "default": "Birlikte kullan"
    },
    {
      "type": "image_picker",
      "id": "image_b",
      "label": "Mekanizma görseli",
      "info": "Seçilmezse iki kapsül + birleşme yer tutucusu gösterilir. Sol kolonla aynı oranda (4:3) kırpılır."
    },
    {
      "type": "text",
      "id": "name_b",
      "label": "Kart adı",
      "default": "Couple Kapsül"
    },
    {
      "type": "text",
      "id": "btn_b_label",
      "label": "Buton metni",
      "default": "Couple'ı seç"
    },
    {
      "type": "url",
      "id": "btn_b_link",
      "label": "Buton linki"
    },

    { "type": "header", "content": "1. satır" },
    {
      "type": "text",
      "id": "q1",
      "label": "Soru",
      "default": "Kutuda kaç kapsül var?"
    },
    {
      "type": "text",
      "id": "a1_a",
      "label": "Sol cevap",
      "default": "1 kapsül"
    },
    {
      "type": "text",
      "id": "a1_b",
      "label": "Sağ cevap",
      "default": "2 kapsül"
    },

    { "type": "header", "content": "2. satır" },
    {
      "type": "text",
      "id": "q2",
      "label": "Soru",
      "default": "İçeriği kim yükler?"
    },
    {
      "type": "text",
      "id": "a2_a",
      "label": "Sol cevap",
      "default": "Sen"
    },
    {
      "type": "text",
      "id": "a2_b",
      "label": "Sağ cevap",
      "default": "İkiniz"
    },

    {
      "type": "header",
      "content": "3. satır (vurgulu)",
      "info": "Bölümdeki tek vurgulu satır: cevaplar CTA renginde ve 500 ağırlıkta görünür."
    },
    {
      "type": "text",
      "id": "q3",
      "label": "Soru",
      "default": "Ne zaman açılır?"
    },
    {
      "type": "text",
      "id": "a3_a",
      "label": "Sol cevap",
      "default": "Belirlediğin tarihte"
    },
    {
      "type": "text",
      "id": "a3_b",
      "label": "Sağ cevap",
      "default": "Yan yana geldiğinizde"
    },

    { "type": "header", "content": "4. satır" },
    {
      "type": "text",
      "id": "q4",
      "label": "Soru",
      "default": "Nasıl tekrar kilitlenir?"
    },
    {
      "type": "text",
      "id": "a4_a",
      "label": "Sol cevap",
      "default": "Sen kilitlersin"
    },
    {
      "type": "text",
      "id": "a4_b",
      "label": "Sağ cevap",
      "default": "Uzaklaşınca kendi kilitlenir"
    },

    {
      "type": "header",
      "content": "Renkler",
      "info": "Varsayılanlar temanın Apple paletiyle aynı. Bir rengi boş bırakırsanız varsayılanına döner."
    },
    {
      "type": "color",
      "id": "c_name",
      "label": "Kart adı",
      "default": "#0071e3"
    },
    {
      "type": "color",
      "id": "c_cta",
      "label": "Vurgulu satır ve buton zemini",
      "info": "\"Ne zaman açılır?\" satırının cevapları ile butonların zemini bu rengi kullanır.",
      "default": "#0071e3"
    },
    {
      "type": "color",
      "id": "c_btn_text",
      "label": "Buton metni",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "c_text",
      "label": "Ana metin",
      "info": "Kart etiketleri, başlık ve normal cevaplar.",
      "default": "#f5f5f7"
    },
    {
      "type": "color",
      "id": "c_muted",
      "label": "İkincil metin",
      "info": "Alt başlık ve soru satırları.",
      "default": "#86868b"
    },
    {
      "type": "color",
      "id": "c_bg",
      "label": "Bölüm zemini",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "c_surface",
      "label": "Kart zemini",
      "default": "#1d1d1f"
    },
    {
      "type": "color",
      "id": "c_media",
      "label": "Görsel zemini",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "c_line",
      "label": "Ayırıcı çizgi ve kenarlık",
      "default": "#2a2a2c"
    },
    {
      "type": "color",
      "id": "c_pill_bg",
      "label": "Etiket zemini",
      "default": "#2d2d2f"
    }
  ],
  "presets": [
    {
      "name": "Çatal Karşılaştırma",
      "settings": {
        "heading": "Sana en uygun kapsülü seç.",
        "subheading": "İki farklı deneyim.",
        "label_a": "Hediye et",
        "name_a": "Single Kapsül",
        "btn_a_label": "Single'ı seç",
        "btn_a_link": "https://texttonext.com/pages/hediye-daha-fazla-bilgi-al",
        "label_b": "Birlikte kullan",
        "name_b": "Couple Kapsül",
        "btn_b_label": "Couple'ı seç",
        "btn_b_link": "https://texttonext.com/pages/couple-daha-fazla-bilgi-al",
        "q1": "Kutuda kaç kapsül var?",
        "a1_a": "1 kapsül",
