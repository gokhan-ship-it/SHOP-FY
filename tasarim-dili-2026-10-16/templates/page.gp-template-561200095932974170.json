        "ggTdrw1cLfz_text": "<p>Not</p>",
        "ggWk1zn4AdE_text": "<span style=\"color:#000000;\">Telefonuna dokundur.</span>",
        "ggbPjJkkuPn_text": "<p><span style=\"color:#111111;\">Zaman kapsülleri </span><span style=\"color:#000000;\"><strong>ikiniz arasında şifrelenir</strong></span><span style=\"color:#111111;\">. Çipi okutan </span><span style=\"color:#000000;\"><strong>üçüncü kişiler</strong></span><span style=\"color:#111111;\"> içeriklere </span><span style=\"color:#000000;\"><strong>görüntüleyemezler</strong></span><span style=\"color:#111111;\">.</span></p>",
        "ggcP0Ke2_pj_text": "<p><span style=\"color:#111111;\">Kolye veya bilekliği</span><span style=\"color:#000000;\"> <strong>telefonuna</strong> <strong>dokundurarak</strong> </span><span style=\"color:#111111;\">zaman kapsülüne bağlan.</span></p>",
