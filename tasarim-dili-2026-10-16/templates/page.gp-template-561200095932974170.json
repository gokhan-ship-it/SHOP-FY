    "gp_section_588198910976066134": {
      "settings": {
        "checksum": "f2a63200d945d5c6c35e79234ff205efc47ba5c88342021ea57b862c688c9c4d_1_1_0_0__1",
        "gg3z6-kzfLK_text": "<p><span style=\"background-color:rgb(255,255,255);color:rgb(28,28,28);font-size:14px;\">Hayır, zaman kapsülü kilit açıldıktan sonra kilitlenebilir, ve tekrar kullanılabilir.</span></p>",
        "gg9MdndBfV6_text": "<p>Aklına takılan farklı bir soru mu var?</p>",
        "ggHEzqwsoc2_childItem_0": "<p>Kapsülüme başkaları erişebilir mi?</p>",
        "ggHEzqwsoc2_childItem_1": "<p>Çipler sudan etkilenir mi?</p>",
        "ggHEzqwsoc2_childItem_2": "<p>Ürün kilitliyken yükleme yapılabilir mi?</p>",
        "ggHEzqwsoc2_childItem_3": "<p>Kapsül tek kullanımlık mı?</p>",
        "ggc6svSUEN-_text": "<p><span style=\"background-color:rgb(255,255,255);color:rgb(28,28,28);font-size:14px;\">Hayır, kullandığımız çipler hiçbir şekilde sudan zarar görmez.</span></p>",
        "ggkKmN4lxpk_label": "<p><span style=\"color:#3C96EE;\"><strong>Bize ulaşın.</strong></span></p>",
        "ggobnJkJY1y_text": "<p><span style=\"background-color:rgb(255,255,255);color:rgb(28,28,28);font-size:14px;\">Hayır, zaman kapsülleri sen ve hediye ettiğin kişi arasında şifrelenir, üçüncü kişiler kapsülüne erişemez.</span></p>",
        "ggvaGnVmWhE_text": "<p><span style=\"background-color:rgb(255,255,255);color:rgb(28,28,28);font-size:14px;\">Evet, geri sayım devam ederken ürün yanında olmasa da uzaktan yükleme yapabilir yada içeriklerinizi düzenleyebilirsiniz.</span></p>",
        "ggxjShv5yRL_text": "Sıkça Sorulan Sorular"
      },
      "type": "gp-section-588198910976066134"
    },
