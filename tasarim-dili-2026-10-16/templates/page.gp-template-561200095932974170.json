    "gp_section_588198824925725270": {
      "settings": {
        "checksum": "8366f602e310fa47504bcdb1d9b18f2e1fb4d980c354f115cbf102ecf5f01716_1_1_0_0__1",
        "ggF1dW51OIR_text": "<p><span style=\"color:#111111;\">Kolye veya bilekliği</span><span style=\"color:#000000;\"> <strong>telefonuna</strong> <strong>dokundurarak</strong> </span><span style=\"color:#111111;\">zaman kapsülüne bağlan.</span></p>",
        "ggK4Wiqkr07_text": "<span style=\"color:#000000;font-size:33px;\">Kilitle ve&nbsp;</span><br><span style=\"color:#000000;font-size:33px;\">geri sayım&nbsp;</span><br><span style=\"color:#000000;font-size:33px;\">başlasın.</span>",
        "ggKeyTNRMfc_text": "<span style=\"color:#000000;font-size:33px;\">Anılarını</span><br><span style=\"color:#000000;font-size:33px;\">&nbsp;yükle.</span>",
        "ggKgKPmcFLe_text": "<p><span style=\"color:#111111;\">Hediye &nbsp;ettiğin kişi, </span><span style=\"color:#000000;\"><strong>belirlediğin tarih geldiğinde</strong></span><span style=\"color:#111111;\"> kolye veya bileklikteki </span><span style=\"color:#000000;\"><strong>çipi kullanarak</strong></span><span style=\"color:#111111;\"> zaman kapsülünü açar ve kapsüle </span><span style=\"color:#000000;\"><strong>yüklediklerini görebilir</strong></span><span style=\"color:#111111;\">.</span></p>",
        "ggKsl2nohrU_text": "<span style=\"color:#000000;font-size:33px;\">Tekrar kullan.</span>",
        "ggNgvmykY5q_text": "<p>Adım 2</p>",
        "ggR4e24d9IM_text": "Nasıl Çalışır?",
        "ggS4QRhl2YA_text": "<p><span style=\"color:#111111;\">Zaman kapsülleri </span><span style=\"color:#000000;\"><strong>ikiniz arasında şifrelenir</strong></span><span style=\"color:#111111;\">. Çipi okutan </span><span style=\"color:#000000;\"><strong>üçüncü kişiler</strong></span><span style=\"color:#111111;\"> içeriklere </span><span style=\"color:#000000;\"><strong>görüntüleyemezler</strong></span><span style=\"color:#111111;\">.</span></p>",
        "ggTHgdq2FAm_text": "<span style=\"color:#000000;font-size:33px;\">Şifreleme.</span>",
        "ggUpiHptFwa_text": "<p><span style=\"color:#000000;\"><strong>Yüklediğin içerikleri</strong> </span><span style=\"color:#111111;\">sizin için özel bir tarihe </span><span style=\"color:#000000;\"><strong>kilitle</strong></span><span style=\"color:#111111;\">. Hediye ettiğin kişi, belirlediğin </span><span style=\"color:#000000;\"><strong>tarihe kadar </strong></span><span style=\"color:#111111;\">sadece </span><span style=\"color:#000000;\"><strong>geri sayım</strong></span><span style=\"color:#111111;\"> görebilir.</span></p>",
        "ggVCRCq2sto_background_desktop_image_src": "https://ucarecdn.com/46d5a88e-90ac-48f6-9cb5-b666cd138e46/-/format/auto/",
        "ggVCRCq2sto_background_desktop_video": "https://www.youtube.com/watch?v=cyzh48XRS4M",
        "ggVCRCq2sto_background_desktop_videoHtml5": "https://media.w3.org/2010/05/sintel/trailer.mp4",
        "ggVCRCq2sto_background_mobile_video": "https://www.youtube.com/watch?v=cyzh48XRS4M",
        "ggVCRCq2sto_background_mobile_videoHtml5": "https://media.w3.org/2010/05/sintel/trailer.mp4",
        "ggVYPt_BRoA_text": "<p><span style=\"color:#111111;\">Kapsülü yeni bir tarihe </span><span style=\"color:#000000;\"><strong>tekrar</strong></span><span style=\"color:#111111;\"> kilitleyebilir, </span><span style=\"color:#000000;\"><strong>dilediğin kadar</strong></span><span style=\"color:#111111;\"> kullanabilirsin.</span></p>",
