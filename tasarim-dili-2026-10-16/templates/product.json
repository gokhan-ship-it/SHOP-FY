= document.getElementById('TTStickyATCBtn');\n    if (!bar || !btn) return;\n    document.body.appendChild(bar);\n    function realBtn() {\n      var list = document.querySelectorAll('button[name=\"add\"]');\n      for (var i = 0; i < list.length; i++) {\n        if (!list[i].closest('.product-sticky-form') && !list[i].closest('.tt-sticky-atc')) return list[i];\n      }\n      return null;\n    }\n    function update() {\n      var target = realBtn();\n      if (!target) { bar.classList.remove('is-visible'); return; }\n      var r = target.getBoundingClientRect();\n      if (r.bottom < 0) bar.classList.add('is-visible');\n      else bar.classList.remove('is-visible');\n    }\n    btn.addEventListener('click', function () {\n      var target = realBtn();\n      if (target) target.click();\n    });\n    window.addEventListener('scroll', update, { passive: true });\n    window.addEventListener('resize', update);\n    setInterval(update, 400);\n    update();\n  })();\n</script>"
