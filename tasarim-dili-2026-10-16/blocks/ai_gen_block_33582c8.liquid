<script>
  (function() {
    class TtnHowItWorks{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.slider = this.querySelector('[data-slider]');
        this.dots = this.querySelectorAll('[data-dot]');
        this.cards = this.querySelectorAll('[data-card]');

        if (!this.slider || this.dots.length === 0) return;

        this.setupScrollListener();
        this.setupDotListeners();
        this.noktalariTazele();
      }

      /* Apple kipinde genis ekranda dort kart tam sigiyor ve kaydiracak
         bir sey kalmiyor. O durumda noktalar islevsiz kaliyor, gizliyoruz.
         Yalnizca data-oto-nokta varken calisir; klasik kipin davranisi
         hic degismiyor. */
      noktalariTazele() {
        if (!this.hasAttribute('data-oto-nokta')) return;
        const pag = this.querySelector('[data-pagination]');
        if (!pag) return;
        const bak = () => {
          const kaydirilir = this.slider.scrollWidth > this.slider.clientWidth + 2;
          pag.style.display = kaydirilir ? '' : 'none';
        };
        bak();
        if (window.ResizeObserver) {
          this.gozlemci = new ResizeObserver(bak);
          this.gozlemci.observe(this.slider);
        } else {
          window.addEventListener('resize', bak);
        }
      }

      disconnectedCallback() {
        if (this.gozlemci) { this.gozlemci.disconnect(); this.gozlemci = null; }
      }

      setupScrollListener() {
        let scrollTimeout;
        this.slider.addEventListener('scroll', () => {
          clearTimeout(scrollTimeout);
          scrollTimeout = setTimeout(() => {
            this.updateActiveDot();
          }, 100);
        });
      }

      setupDotListeners() {
        this.dots.forEach((dot) => {
          dot.addEventListener('click', () => {
            const index = parseInt(dot.getAttribute('data-dot'));
            const card = this.cards[index];
            if (card) {
              card.scrollIntoView({
                behavior: 'smooth',
                block: 'nearest',
                inline: 'start'
              });
            }
          });
        });
      }

      updateActiveDot() {
        const scrollLeft = this.slider.scrollLeft;
        const cardWidth = this.cards[0].offsetWidth;
        const gap = parseInt(getComputedStyle(this.slider).gap) || 0;
        const activeIndex = Math.round(scrollLeft / (cardWidth + gap));

        this.dots.forEach((dot, index) => {
          if (index === activeIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }
    }

    customElements.define('ttn-how-it-works-{{ ai_gen_id }}', TtnHowItWorks{{ ai_gen_id }});
  })();
</script>

