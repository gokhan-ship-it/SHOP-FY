        {% else %}
          <div></div>
        {% endif %}

        {% if s.couple_button_text != blank %}
          <a href="{{ s.couple_button_link | default: '#' }}" class="ai-comparison-button-{{ ai_gen_id }} ai-btn-couple-{{ ai_gen_id }}">
            {{ s.couple_button_text }}
          </a>
        {% else %}
          <div></div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

{% if s.anim_ac %}
  <script>
    (function () {
      var kok = document.querySelector('.ai-comparison-{{ ai_gen_id }}');
      if (!kok) return;

      var ogeler = kok.querySelectorAll('[data-ai-anim]');
      if (!ogeler.length) return;

      var ara = {{ s.anim_ara }};
      for (var i = 0; i < ogeler.length; i++) {
        ogeler[i].style.setProperty('--ai-gecikme', (i * ara) + 'ms');
      }

      kok.classList.add('ai-hazir');

      function goster(oge) {
        oge.classList.add('is-gorunur');
        oge.addEventListener('transitionend', function son(e) {
          if (e.propertyName !== 'transform') return;
          oge.removeEventListener('transitionend', son);
          oge.classList.add('anim-bitti');
          oge.style.removeProperty('--ai-gecikme');
        });
      }

      var azHareket = window.matchMedia
        && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (azHareket || !('IntersectionObserver' in window)) {
        for (var a = 0; a < ogeler.length; a++) goster(ogeler[a]);
        return;
      }

      var goz = new IntersectionObserver(function (girisler) {
        for (var g = 0; g < girisler.length; g++) {
          if (!girisler[g].isIntersecting) continue;
          goster(girisler[g].target);
          goz.unobserve(girisler[g].target);
        }
      }, { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });

      for (var b = 0; b < ogeler.length; b++) goz.observe(ogeler[b]);
    })();
  </script>
{% endif %}

{% liquid
  assign bol_js = false
  if s.gift_split and s.gift_split_1_text != blank and s.gift_split_2_text != blank
    assign bol_js = true
  endif
%}
{% if bol_js %}
  <script>
    (function () {
      var yuva = document.querySelector('.ai-btn-yuva-{{ ai_gen_id }}');
      if (!yuva) return;
      var tetik = yuva.querySelector('[data-ai-bol]');
      if (!tetik) return;

      // Gizli baslangic durumunu ancak burada aciyoruz: JS yoksa iki
      // baglanti da dogrudan gorunur kalir.
      yuva.classList.add('ai-bol-hazir');

      function ayarla(acik) {
        yuva.classList.toggle('is-bolundu', acik);
        tetik.setAttribute('aria-expanded', acik ? 'true' : 'false');
      }

      tetik.addEventListener('click', function (e) {
        e.preventDefault();
        ayarla(!yuva.classList.contains('is-bolundu'));
      });

      document.addEventListener('click', function (e) {
        if (!yuva.classList.contains('is-bolundu')) return;
        if (yuva.contains(e.target)) return;
        ayarla(false);
      });

      document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape' && e.keyCode !== 27) return;
        if (yuva.classList.contains('is-bolundu')) ayarla(false);
      });
    })();
  </script>
{% endif %}

