              </div>
            {% endif %}
          </div>
        </div>
        {% if s.couple_product_title != blank %}
          <h3 class="ai-comparison-product-title-{{ ai_gen_id }}">{{ s.couple_product_title }}</h3>
        {% endif %}
      </div>
    </div>

    <div class="ai-comparison-features-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign gift_title_key = 'feature_' | append: i | append: '_gift_title'
          assign couple_title_key = 'feature_' | append: i | append: '_couple_title'
          assign gift_title = s[gift_title_key]
          assign couple_title = s[couple_title_key]
        %}

        {% comment %}
          Iki taraf da bossa satiri hic basmiyoruz: bos kart cifti
          karsilastirmada anlamsiz bir bosluk birakiyordu.
        {% endcomment %}
        {% if gift_title != blank or couple_title != blank %}
          <div class="ai-comparison-feature-row-{{ ai_gen_id }}" data-ai-anim>
            <div class="ai-comparison-feature-card-{{ ai_gen_id }}">
              {% if gift_title != blank %}
                <div class="ai-comparison-feature-title-{{ ai_gen_id }}">{{ gift_title }}</div>
              {% endif %}
            </div>

            <div class="ai-comparison-feature-card-{{ ai_gen_id }}">
              {% if couple_title != blank %}
                <div class="ai-comparison-feature-title-{{ ai_gen_id }}">{{ couple_title }}</div>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if s.gift_button_text != blank or s.couple_button_text != blank %}
      <div class="ai-comparison-buttons-{{ ai_gen_id }}" data-ai-anim>
        {% liquid
          assign bol_var = false
          if s.gift_split and s.gift_split_1_text != blank and s.gift_split_2_text != blank
            assign bol_var = true
          endif
        %}
        {% if s.gift_button_text != blank and bol_var %}
          <div class="ai-btn-yuva-{{ ai_gen_id }}" data-ai-yuva>
