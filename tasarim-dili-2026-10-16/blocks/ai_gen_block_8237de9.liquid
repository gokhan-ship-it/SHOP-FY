<div class="ai-comparison-{{ ai_gen_id }}" data-ai-kok {{ block.shopify_attributes }}>
  <div class="ai-comparison-container-{{ ai_gen_id }}">
    {% if s.category != blank or s.title != blank or s.subtitle != blank %}
      <div class="ai-comparison-header-{{ ai_gen_id }}" data-ai-anim>
        {% if s.category != blank %}
          <div class="ai-comparison-category-{{ ai_gen_id }}">{{ s.category }}</div>
        {% endif %}

        {% if s.title != blank %}
          <h2 class="ai-comparison-title-{{ ai_gen_id }}">{{ s.title }}</h2>
        {% endif %}

        {% if s.subtitle != blank %}
          <div class="ai-comparison-subtitle-{{ ai_gen_id }}">{{ s.subtitle }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-comparison-products-{{ ai_gen_id }}" data-ai-anim>
      <div class="ai-comparison-product-{{ ai_gen_id }}">
        <div class="ai-comparison-product-image-wrapper-{{ ai_gen_id }}">
          <div class="ai-comparison-product-image-{{ ai_gen_id }}">
            {% if s.gift_image_desktop %}
              <div class="ai-comparison-desktop-image-{{ ai_gen_id }}">
                <img
                  src="{{ s.gift_image_desktop | image_url: width: 800 }}"
                  alt="{{ s.gift_image_alt | escape }}"
                  loading="lazy"
                  decoding="async"
                  width="{{ s.gift_image_desktop.width }}"
                  height="{{ s.gift_image_desktop.height }}"
                >
              </div>
            {% else %}
              <div class="ai-comparison-desktop-image-{{ ai_gen_id }}">
                <div class="ai-comparison-product-image-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              </div>
            {% endif %}

            {% if s.gift_image_mobile %}
              <div class="ai-comparison-mobile-image-{{ ai_gen_id }}">
                <img
                  src="{{ s.gift_image_mobile | image_url: width: 600 }}"
                  alt="{{ s.gift_image_alt | escape }}"
                  loading="lazy"
                  decoding="async"
                  width="{{ s.gift_image_mobile.width }}"
                  height="{{ s.gift_image_mobile.height }}"
                >
              </div>
            {% elsif s.gift_image_desktop %}
              <div class="ai-comparison-mobile-image-{{ ai_gen_id }}">
                <img
                  src="{{ s.gift_image_desktop | image_url: width: 600 }}"
                  alt="{{ s.gift_image_alt | escape }}"
                  loading="lazy"
                  decoding="async"
                  width="{{ s.gift_image_desktop.width }}"
                  height="{{ s.gift_image_desktop.height }}"
                >
              </div>
            {% else %}
              <div class="ai-comparison-mobile-image-{{ ai_gen_id }}">
                <div class="ai-comparison-product-image-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              </div>
            {% endif %}
          </div>
        </div>
        {% if s.gift_product_title != blank %}
          <h3 class="ai-comparison-product-title-{{ ai_gen_id }}">{{ s.gift_product_title }}</h3>
        {% endif %}
      </div>

      <div class="ai-comparison-product-{{ ai_gen_id }}">
        <div class="ai-comparison-product-image-wrapper-{{ ai_gen_id }}">
          <div class="ai-comparison-product-image-{{ ai_gen_id }}">
            {% if s.couple_image_desktop %}
              <div class="ai-comparison-desktop-image-{{ ai_gen_id }}">
                <img
                  src="{{ s.couple_image_desktop | image_url: width: 800 }}"
                  alt="{{ s.couple_image_alt | escape }}"
                  loading="lazy"
                  decoding="async"
                  width="{{ s.couple_image_desktop.width }}"
                  height="{{ s.couple_image_desktop.height }}"
                >
              </div>
            {% else %}
              <div class="ai-comparison-desktop-image-{{ ai_gen_id }}">
                <div class="ai-comparison-product-image-placeholder-{{ ai_gen_id }}">
                  {{ 'product-2' | placeholder_svg_tag }}
                </div>
              </div>
            {% endif %}

            {% if s.couple_image_mobile %}
              <div class="ai-comparison-mobile-image-{{ ai_gen_id }}">
                <img
                  src="{{ s.couple_image_mobile | image_url: width: 600 }}"
                  alt="{{ s.couple_image_alt | escape }}"
                  loading="lazy"
                  decoding="async"
                  width="{{ s.couple_image_mobile.width }}"
                  height="{{ s.couple_image_mobile.height }}"
                >
              </div>
            {% elsif s.couple_image_desktop %}
              <div class="ai-comparison-mobile-image-{{ ai_gen_id }}">
                <img
                  src="{{ s.couple_image_desktop | image_url: width: 600 }}"
                  alt="{{ s.couple_image_alt | escape }}"
                  loading="lazy"
                  decoding="async"
                  width="{{ s.couple_image_desktop.width }}"
                  height="{{ s.couple_image_desktop.height }}"
                >
              </div>
            {% else %}
              <div class="ai-comparison-mobile-image-{{ ai_gen_id }}">
                <div class="ai-comparison-product-image-placeholder-{{ ai_gen_id }}">
                  {{ 'product-2' | placeholder_svg_tag }}
