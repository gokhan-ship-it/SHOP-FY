              type="button"
              class="ai-comparison-button-{{ ai_gen_id }} ai-btn-tetik-{{ ai_gen_id }} ai-btn-hediye-{{ ai_gen_id }}"
              data-ai-bol
              aria-expanded="false"
              aria-controls="ai-bol-{{ ai_gen_id }}"
            >{{ s.gift_button_text }}</button>

            <div class="ai-bol-secenekler-{{ ai_gen_id }}" id="ai-bol-{{ ai_gen_id }}">
              <a href="{{ s.gift_split_1_link | default: '#' }}" class="ai-comparison-button-{{ ai_gen_id }} ai-kucuk-{{ ai_gen_id }} ai-btn-hediye-{{ ai_gen_id }}">
                {{ s.gift_split_1_text }}
              </a>
              <a href="{{ s.gift_split_2_link | default: '#' }}" class="ai-comparison-button-{{ ai_gen_id }} ai-kucuk-{{ ai_gen_id }} ai-btn-hediye-{{ ai_gen_id }}">
                {{ s.gift_split_2_text }}
