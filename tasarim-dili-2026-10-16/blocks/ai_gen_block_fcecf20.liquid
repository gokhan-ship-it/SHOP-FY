      "id": "button_radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Button corner radius",
      "default": 24
    },
    {
      "type": "range",
      "id": "buttons_spacing",
      "min": 20,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Buttons bottom spacing",
      "default": 40
    },
    {
      "type": "header",
      "content": "Colors"
