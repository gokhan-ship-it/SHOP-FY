    {
      "type": "range",
      "id": "empty_image_height_mobile",
      "min": 150,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Empty image height (mobile)",
      "default": 300
    }
  ],
  "presets": [
    {
      "name": "Hero Category Card"
    }
  ]
}
{% endschema %}