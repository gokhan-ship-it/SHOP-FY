</highlight-cards-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class HighlightCardsSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.track = this.querySelector('[data-slider-track]');
        this.slides = Array.from(this.querySelectorAll('[data-slide]'));
        this.dotsContainer = this.querySelector('[data-dots]');
        this.progressBar = this.querySelector('[data-progress-bar]');
        this.prevButton = this.querySelector('[data-arrow-prev]');
        this.nextButton = this.querySelector('[data-arrow-next]');
        this.playPauseButton = this.querySelector('[data-play-pause]');
        this.playIcon = this.querySelector('[data-play-icon]');
        this.pauseIcon = this.querySelector('[data-pause-icon]');
        
        this.currentIndex = 0;
        this.isDragging = false;
        this.startX = 0;
        this.scrollLeft = 0;
        this.autoplayEnabled = this.dataset.autoplay === 'true';
        this.autoplaySpeed = parseInt(this.dataset.autoplaySpeed) * 1000;
        this.autoplayInterval = null;
        this.isPlaying = false;
      }

      connectedCallback() {
        this.init();
      }

      init() {
        this.createDots();
        this.updateActiveSlide();
        this.setupEventListeners();
        
        if (this.autoplayEnabled) {
          this.startAutoplay();
        }
      }

      createDots() {
        if (!this.dotsContainer) return;
        
        this.slides.forEach((slide, index) => {
          const dot = document.createElement('button');
          dot.type = 'button';
          dot.classList.add('ai-highlight-slider__dot-{{ ai_gen_id }}');
          dot.setAttribute('aria-label', 'Go to slide ' + (index + 1));
          dot.addEventListener('click', () => this.handleDotClick(index));
          this.dotsContainer.appendChild(dot);
        });
      }

      setupEventListeners() {
        this.track.addEventListener('scroll', () => this.handleScroll());
        
        this.track.addEventListener('mousedown', (e) => this.startDragging(e));
        this.track.addEventListener('mousemove', (e) => this.drag(e));
        this.track.addEventListener('mouseup', () => this.stopDragging());
        this.track.addEventListener('mouseleave', () => this.stopDragging());
        
        this.track.addEventListener('touchstart', (e) => this.startDragging(e), { passive: true });
        this.track.addEventListener('touchmove', (e) => this.drag(e), { passive: true });
        this.track.addEventListener('touchend', () => this.stopDragging());

        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.handleArrowClick('prev'));
        }
        
        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.handleArrowClick('next'));
        }

        if (this.playPauseButton) {
          this.playPauseButton.addEventListener('click', (e) => {
            e.preventDefault();
            this.togglePlayPause();
          });
        }

        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (!entry.isIntersecting && this.isPlaying) {
              this.pauseAutoplay();
            }
          });
        });
        observer.observe(this);
      }

      startDragging(e) {
        this.isDragging = true;
        this.track.classList.add('is-dragging');
        this.startX = e.type === 'mousedown' ? e.pageX : e.touches[0].pageX;
        this.scrollLeft = this.track.scrollLeft;
        
        if (this.isPlaying) {
          this.resetAutoplay();
        }
      }

      drag(e) {
        if (!this.isDragging) return;
        e.preventDefault();
        const x = e.type === 'mousemove' ? e.pageX : e.touches[0].pageX;
        const walk = (x - this.startX) * 2;
        this.track.scrollLeft = this.scrollLeft - walk;
      }

      stopDragging() {
        this.isDragging = false;
        this.track.classList.remove('is-dragging');
      }

      handleScroll() {
        const scrollPosition = this.track.scrollLeft;
        const slideWidth = this.slides[0].offsetWidth + 20;
        const newIndex = Math.round(scrollPosition / slideWidth);
        
        if (newIndex !== this.currentIndex) {
          this.currentIndex = newIndex;
          this.updateActiveSlide();
        }
        
        this.updateProgress();
      }

      updateActiveSlide() {
        this.slides.forEach((slide, index) => {
          if (index === this.currentIndex) {
            slide.classList.add('active');
            slide.classList.remove('inactive');
          } else {
            slide.classList.remove('active');
            slide.classList.add('inactive');
          }
        });

        if (this.dotsContainer) {
          const dots = this.dotsContainer.querySelectorAll('.ai-highlight-slider__dot-{{ ai_gen_id }}');
          dots.forEach((dot, index) => {
            if (index === this.currentIndex) {
              dot.classList.add('active');
            } else {
              dot.classList.remove('active');
            }
          });
        }

        if (this.prevButton) {
          this.prevButton.disabled = this.currentIndex === 0;
        }
        
        if (this.nextButton) {
          this.nextButton.disabled = this.currentIndex === this.slides.length - 1;
        }
      }

      updateProgress() {
        const maxScroll = this.track.scrollWidth - this.track.clientWidth;
        const progress = (this.track.scrollLeft / maxScroll) * 100;
        if (this.progressBar) {
          this.progressBar.style.width = progress + '%';
        }
      }

      goToSlide(index) {
        const slideWidth = this.slides[0].offsetWidth + 20;
        this.track.scrollTo({
          left: slideWidth * index,
          behavior: 'smooth'
        });
      }

      handleDotClick(index) {
        this.goToSlide(index);
        if (this.isPlaying) {
          this.resetAutoplay();
        }
      }

      handleArrowClick(direction) {
        if (direction === 'prev') {
          this.prev();
        } else {
          this.next();
        }
        if (this.isPlaying) {
          this.resetAutoplay();
        }
      }

      prev() {
        if (this.currentIndex > 0) {
          this.goToSlide(this.currentIndex - 1);
        }
      }

      next() {
        if (this.currentIndex < this.slides.length - 1) {
          this.goToSlide(this.currentIndex + 1);
        } else {
          this.goToSlide(0);
        }
      }

      startAutoplay() {
        this.isPlaying = true;
        this.updatePlayPauseButton();
        
        this.autoplayInterval = setInterval(() => {
          this.next();
        }, this.autoplaySpeed);
      }

      pauseAutoplay() {
        this.isPlaying = false;
        this.updatePlayPauseButton();
        
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }

      resetAutoplay() {
        this.pauseAutoplay();
        this.startAutoplay();
      }

      togglePlayPause() {
        if (this.isPlaying) {
          this.pauseAutoplay();
        } else {
          this.startAutoplay();
        }
      }

      updatePlayPauseButton() {
        if (!this.playPauseButton || !this.playIcon || !this.pauseIcon) return;
        
        if (this.isPlaying) {
          this.playIcon.style.display = 'none';
          this.pauseIcon.style.display = 'block';
          this.playPauseButton.classList.add('is-playing');
          this.playPauseButton.setAttribute('aria-label', 'Pause slider');
        } else {
          this.playIcon.style.display = 'block';
          this.pauseIcon.style.display = 'none';
          this.playPauseButton.classList.remove('is-playing');
          this.playPauseButton.setAttribute('aria-label', 'Play slider');
        }
      }

      disconnectedCallback() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
        }
      }
    }

    customElements.define('highlight-cards-slider-{{ ai_gen_id }}', HighlightCardsSlider{{ ai_gen_id }});
  })();
</script>

