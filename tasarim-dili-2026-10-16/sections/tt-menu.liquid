{%- comment -%}
  TT MENU -- hamburger menusu (tam ekran / masaustunde soldan panel)

  Her sayfada tek bilesen: layout/theme.liquid icinde bolum grubu
  olarak cagriliyor ({% sections 'tt-menu-grup' %}), ayarlari
  sections/tt-menu-grup.json'da. Iki farkli hamburger ayni menuyu
  aciyor:
    - TT Baslik cubugu (tt-baslik.liquid)     [data-tth-menu-ac]
    - temanin kendi header'i (header-icons)   .menu-drawer-button
  Tiklama document'ta CAPTURE asamasinda yakalaniyor; eski cekmeceler
  (tt-baslik'in kendi menusu, temanin MenuDrawer'i) bu yuzden hic
  acilmiyor, dosyalarina dokunulmadi.

  Icerik Shopify Navigation'dan DEGIL, bu bolumun ayarlarindan
  geliyor. "main-menu" silinmedi ve degistirilmedi.

  Davranis: acilis/kapanis 220ms (prefers-reduced-motion'da yok),
  sayfa kaydirma kilidi, Esc / X / karartma ile kapanma, odak menude
  donuyor ve kapaninca acan dugmeye geri veriliyor.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign yol = request.path

  assign b1 = s.satir_1_bag | default: '/collections/zaman-kapsulu-kolyeler'
  assign b2 = s.satir_2_bag | default: '/collections/zaman-kapsulu-bileklik'
  assign b3 = s.satir_3_bag | default: '/collections/couple-urunler'
  assign k1 = s.kart_1_bag | default: '/pages/hediye-daha-fazla-bilgi-al'
  assign k2 = s.kart_2_bag | default: '/pages/couple-daha-fazla-bilgi-al'
  assign a1 = s.alt_1_bag | default: '/pages/event-daha-fazla-bilgi-al'
  assign a2 = s.alt_2_bag | default: '/pages/iletisimsayfasi'
-%}
{%- if s.aktif -%}
<style>
  #TtMenu {
    --ttm-ink: #0a0a0a;
    --ttm-siyah: #000000;
    --ttm-kart: #141414;
    --ttm-cizgi: #262624;
    --ttm-etiket: #8a8a85;
    --ttm-ikincil: #a3a39e;
    --ttm-ok: #5c5c57;
    --ttm-lime: #d6ff00;
    --ttm-sure: 220ms;
    position: fixed;
    inset: 0;
    z-index: 1150;
    visibility: hidden;
    pointer-events: none;
    font-family: var(--font-body-family);
    transition: visibility 0s linear var(--ttm-sure);
  }
  #TtMenu.is-acik {
    visibility: visible;
    pointer-events: auto;
    transition: visibility 0s;
  }
  #TtMenu *, #TtMenu *::before, #TtMenu *::after { box-sizing: border-box; }

  .ttm-ortu {
    /* Temanin "div:empty { display: none }" kurali karartmayi gizliyordu. */
    display: block !important;
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    opacity: 0;
    transition: opacity var(--ttm-sure) cubic-bezier(0.4, 0, 0.2, 1);
  }
  .ttm-panel {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    background: var(--ttm-siyah);
    color: #ffffff;
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity var(--ttm-sure) cubic-bezier(0.4, 0, 0.2, 1),
      transform var(--ttm-sure) cubic-bezier(0.4, 0, 0.2, 1);
  }
  #TtMenu.is-acik .ttm-ortu,
  #TtMenu.is-acik .ttm-panel { opacity: 1; transform: none; }

  /* ---------- ust cubuk ---------- */
  .ttm-bar {
    position: relative;
    flex: 0 0 auto;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 8px 0 14px;
    background: var(--ttm-ink);
    border-bottom: 1px solid var(--ttm-cizgi);
  }
  .ttm-dugme {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: #ffffff;
    cursor: pointer;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }
  .ttm-dugme svg { display: block; }
  /* Hamburger -> X: menu acilirken ayni yerde cizgiler capraz duruyor. */
  .ttm-kapat span {
    position: relative;
    display: block;
    width: 18px;
    height: 18px;
  }
  .ttm-kapat i {
    position: absolute;
    left: 0;
    right: 0;
    top: 8px;
    height: 2px;
    border-radius: 2px;
    background: #ffffff;
    transition: transform var(--ttm-sure) cubic-bezier(0.4, 0, 0.2, 1), opacity 140ms linear;
  }
  .ttm-kapat i:nth-child(1) { transform: translateY(-5px); }
  .ttm-kapat i:nth-child(3) { transform: translateY(5px); }
  #TtMenu.is-acik .ttm-kapat i:nth-child(1) { transform: rotate(45deg); }
  #TtMenu.is-acik .ttm-kapat i:nth-child(2) { opacity: 0; transform: scaleX(0.4); }
  #TtMenu.is-acik .ttm-kapat i:nth-child(3) { transform: rotate(-45deg); }

  .ttm-logo {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: inline-flex;
    line-height: 0;
  }
  .ttm-logo img { display: block; height: {{ s.logo_yuk }}px; width: auto; }
  .ttm-logo-yazi { font-weight: 700; font-size: 18px; letter-spacing: -0.3px; color: #ffffff; line-height: 1; }
  .ttm-ikonlar { display: inline-flex; align-items: center; }
  .ttm-sepet { position: relative; }
  .ttm-sayi {
    position: absolute;
    top: 5px;
    right: 4px;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: 999px;
    background: var(--ttm-lime);
    color: var(--ttm-ink);
    font-size: 10px;
    font-weight: 700;
    line-height: 16px;
    text-align: center;
  }
  .ttm-sayi[hidden] { display: none; }

  /* ---------- icerik ---------- */
  .ttm-govde {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    display: flex;
    flex-direction: column;
    padding: 28px 24px 24px;
  }
  .ttm-nav { display: flex; flex-direction: column; flex: 1 0 auto; }
  .ttm-etiket {
    margin: 0 0 6px;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 1.4px;
    line-height: 1.3;
    color: var(--ttm-etiket);
  }
  .ttm-liste { list-style: none; margin: 0; padding: 0; }
  .ttm-liste li + li { border-top: 1px solid var(--ttm-cizgi); }
  .ttm-satir {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 64px;
    color: #ffffff;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }
  .ttm-satir-sol { display: inline-flex; align-items: center; gap: 12px; min-width: 0; flex-wrap: wrap; }
  .ttm-satir-yazi {
    font-family: var(--font-heading-family);
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.8px;
    line-height: 1.1;
  }
  .ttm-rozet {
    display: inline-block;
    padding: 5px 10px;
    border-radius: 999px;
    background: var(--ttm-lime);
    color: var(--ttm-ink);
    font-size: 11.5px;
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
  }
  .ttm-ok { flex: 0 0 auto; color: var(--ttm-ok); }
  .ttm-satir[aria-current="page"] .ttm-ok { color: #ffffff; }

  .ttm-etiket--nasil { margin-top: 32px; margin-bottom: 12px; }
  .ttm-kartlar {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .ttm-kart {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
    height: 100%;
    min-height: 132px;
    padding: 16px 14px 16px 16px;
    border: 1px solid var(--ttm-cizgi);
    border-radius: 18px;
    background: var(--ttm-kart);
    color: #ffffff;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }
  .ttm-kart-ust { display: flex; align-items: flex-start; justify-content: space-between; }
  .ttm-kart-ust svg { display: block; }
  .ttm-kart-capraz { color: var(--ttm-etiket); }
  .ttm-kart-bas {
    display: block;
    font-family: var(--font-heading-family);
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.4px;
    line-height: 1.15;
    color: #ffffff;
  }
  .ttm-kart-alt {
    display: block;
    margin-top: 4px;
    font-size: 12.5px;
    line-height: 1.35;
    color: var(--ttm-ikincil);
  }

  /* En alt: menunun dibine yasli; icerik uzunsa normal akista. */
  .ttm-dip { margin-top: auto; padding-top: 24px; }
  .ttm-kucuk { list-style: none; margin: 0; padding: 0; }
  .ttm-kucuk a {
    display: flex;
    align-items: center;
    min-height: 48px;
    font-size: 17px;
    font-weight: 500;
    color: #ffffff;
    text-decoration: none;
  }
  .ttm-destek {
    margin: 0;
    padding-top: 14px;
    border-top: 1px solid var(--ttm-cizgi);
    font-size: 12.5px;
    line-height: 1.4;
    color: var(--ttm-ikincil);
  }
  .ttm-destek a { color: inherit; text-decoration: none; }

  #TtMenu a:focus-visible,
  #TtMenu button:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 2px;
    border-radius: 6px;
  }
  .ttm-gizli {
    position: absolute !important;
    width: 1px; height: 1px; margin: -1px; padding: 0; border: 0;
    overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap;
  }

  /* Masaustu: soldan 420px panel, sag taraf karartma. */
  @media (min-width: 750px) {
    .ttm-panel {
      width: 420px;
      transform: translateX(-24px);
      border-right: 1px solid var(--ttm-cizgi);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    #TtMenu, #TtMenu * { transition: none !important; }
  }

  html.ttm-kilit, html.ttm-kilit body { overflow: hidden !important; }
</style>

<div id="TtMenu" class="ttm" data-ttm role="dialog" aria-modal="true" aria-label="{{ s.menu_etiket | escape }}">
  <div class="ttm-ortu" data-ttm-kapat aria-hidden="true"></div>
  <div class="ttm-panel">
    <div class="ttm-bar">
      <button class="ttm-dugme ttm-kapat" type="button" data-ttm-kapat aria-label="{{ s.kapat_etiket | escape }}">
        <span aria-hidden="true"><i></i><i></i><i></i></span>
      </button>

      <a class="ttm-logo" href="{{ routes.root_url }}">
        {%- if s.logo != blank -%}
          <img src="{{ s.logo | image_url: height: 120 }}" alt="{{ shop.name | escape }}" width="{{ s.logo.width | times: 120 | divided_by: s.logo.height }}" height="120" loading="lazy">
        {%- else -%}
          <span class="ttm-logo-yazi">{{ shop.name }}</span>
        {%- endif -%}
      </a>

      <div class="ttm-ikonlar">
        <a class="ttm-dugme" href="{{ routes.search_url }}" data-ttm-ara>
          <span class="ttm-gizli">{{ 'general.search.title' | t }}</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
        </a>
        <a class="ttm-dugme ttm-sepet" href="{{ routes.cart_url }}" data-ttm-sepet data-no-instant>
          <span class="ttm-gizli">{{ 'general.cart.title' | t }}</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8h12l-1 12H7L6 8z"></path><path d="M9 8V6a3 3 0 0 1 6 0v2"></path></svg>
          <cart-count class="ttm-sayi" data-ttm-sayi aria-hidden="true"{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</cart-count>
        </a>
      </div>
    </div>

    <div class="ttm-govde">
      <nav class="ttm-nav" aria-label="{{ s.nav_etiket | escape }}">
        {%- if s.urun_etiket != blank -%}<p class="ttm-etiket">{{ s.urun_etiket }}</p>{%- endif -%}
        <ul class="ttm-liste">
          {%- for i in (1..3) -%}
            {%- liquid
              case i
                when 1
                  assign metin = s.satir_1_metin
                  assign bag = b1
                  assign rozet = s.satir_1_rozet
                when 2
                  assign metin = s.satir_2_metin
                  assign bag = b2
                  assign rozet = s.satir_2_rozet
                when 3
                  assign metin = s.satir_3_metin
                  assign bag = b3
                  assign rozet = s.satir_3_rozet
              endcase
              assign bag_yol = bag | split: '?' | first | remove: shop.url
            -%}
            {%- if metin != blank -%}
            <li>
              <a class="ttm-satir" href="{{ bag }}"{% if bag_yol == yol %} aria-current="page"{% endif %}>
                <span class="ttm-satir-sol">
                  <span class="ttm-satir-yazi">{{ metin }}</span>
                  {%- if rozet != blank %} <span class="ttm-rozet">{{ rozet }}</span>{%- endif -%}
                </span>
                <svg class="ttm-ok" width="10" height="16" viewBox="0 0 10 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 2l6 6-6 6"></path></svg>
              </a>
            </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>

        {%- if s.nasil_etiket != blank -%}<p class="ttm-etiket ttm-etiket--nasil">{{ s.nasil_etiket }}</p>{%- endif -%}
        <ul class="ttm-kartlar">
          <li>
            {%- assign k1_yol = k1 | split: '?' | first | remove: shop.url -%}
            <a class="ttm-kart" href="{{ k1 }}"{% if k1_yol == yol %} aria-current="page"{% endif %}>
              <span class="ttm-kart-ust">
                <svg width="30" height="30" viewBox="-15 -15 30 30" fill="none" aria-hidden="true"><circle r="12.5" stroke="#3A3A38" stroke-width="1.6"/><path d="M0 -12.5 A12.5 12.5 0 1 1 -10.8 6.25" stroke="#FFFFFF" stroke-width="1.6" stroke-linecap="round"/><circle cx="-10.8" cy="6.25" r="2.4" fill="#D6FF00"/><path d="M-2.6 -1v-1.8a2.6 2.6 0 0 1 5.2 0v1.8" stroke="#FFFFFF" stroke-width="1.4"/><rect x="-4.2" y="-1.2" width="8.4" height="6.4" rx="1.5" fill="#FFFFFF"/></svg>
                <svg class="ttm-kart-capraz" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10L10 4M5 4h5v5"/></svg>
              </span>
              <span>
                <span class="ttm-kart-bas">{{ s.kart_1_baslik }}</span>
                <span class="ttm-kart-alt">{{ s.kart_1_aciklama }}</span>
              </span>
            </a>
          </li>
          <li>
            {%- assign k2_yol = k2 | split: '?' | first | remove: shop.url -%}
            <a class="ttm-kart" href="{{ k2 }}"{% if k2_yol == yol %} aria-current="page"{% endif %}>
              <span class="ttm-kart-ust">
                <svg width="36" height="26" viewBox="-17 -12 34 24" fill="none" aria-hidden="true"><defs><clipPath id="ttm-cp-{{ sid }}"><circle cx="-5.5" r="9.5"/></clipPath></defs><circle cx="5.5" r="9.5" fill="#D6FF00" clip-path="url(#ttm-cp-{{ sid }})"/><circle cx="-5.5" r="9.5" stroke="#FFFFFF" stroke-width="1.6"/><circle cx="5.5" r="9.5" stroke="#FFFFFF" stroke-width="1.6"/></svg>
                <svg class="ttm-kart-capraz" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10L10 4M5 4h5v5"/></svg>
              </span>
              <span>
                <span class="ttm-kart-bas">{{ s.kart_2_baslik }}</span>
                <span class="ttm-kart-alt">{{ s.kart_2_aciklama }}</span>
              </span>
            </a>
          </li>
        </ul>

        <div class="ttm-dip">
          <ul class="ttm-kucuk">
            {%- assign a1_yol = a1 | split: '?' | first | remove: shop.url -%}
            {%- assign a2_yol = a2 | split: '?' | first | remove: shop.url -%}
            {%- if s.alt_1_metin != blank -%}<li><a href="{{ a1 }}"{% if a1_yol == yol %} aria-current="page"{% endif %}>{{ s.alt_1_metin }}</a></li>{%- endif -%}
            {%- if s.alt_2_metin != blank -%}<li><a href="{{ a2 }}"{% if a2_yol == yol %} aria-current="page"{% endif %}>{{ s.alt_2_metin }}</a></li>{%- endif -%}
          </ul>
          {%- if s.destek_metni != blank or s.destek_tel_metni != blank -%}
          <p class="ttm-destek">
            {{- s.destek_metni -}}
            {%- if s.destek_metni != blank and s.destek_tel_metni != blank %} · {% endif -%}
            {%- if s.destek_tel_metni != blank -%}
              {%- if s.destek_tel != blank -%}<a href="tel:{{ s.destek_tel | remove: ' ' }}">{{ s.destek_tel_metni }}</a>{%- else -%}{{ s.destek_tel_metni }}{%- endif -%}
            {%- endif -%}
          </p>
          {%- endif -%}
        </div>
      </nav>
    </div>
  </div>
</div>

<script>
  (function () {
    'use strict';
    var menu = document.getElementById('TtMenu');
    if (!menu || menu.__ttm) return;
    menu.__ttm = true;

    var TETIK = '[data-tth-menu-ac], .menu-drawer-button, [data-tt-menu-ac]';
    var acik = false, acan = null;

    function tetikler() { return document.querySelectorAll(TETIK); }
    function tetikleriAyarla() {
      tetikler().forEach(function (b) {
        b.setAttribute('aria-controls', 'TtMenu');
        b.setAttribute('aria-expanded', acik ? 'true' : 'false');
      });
    }

    function odaklanabilir() {
      return Array.prototype.filter.call(
        menu.querySelectorAll('a[href], button:not([disabled])'),
        function (el) { return el.offsetParent !== null || el === document.activeElement; }
      );
    }

    function sayiyiYenile() {
      var sayi = menu.querySelector('[data-ttm-sayi]');
      if (!sayi || !window.fetch) return;
      fetch('{{ routes.cart_url }}.js', { credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (c) {
          sayi.textContent = c.item_count;
          sayi.hidden = !c.item_count;
        })
        .catch(function () {});
    }

    function ac(kaynak) {
      if (acik) return;
      acik = true;
      acan = kaynak || document.activeElement;
      menu.classList.add('is-acik');
      document.documentElement.classList.add('ttm-kilit');
      tetikleriAyarla();
      sayiyiYenile();
      window.setTimeout(function () {
        var k = menu.querySelector('.ttm-kapat');
        if (k) k.focus();
      }, 60);
    }

    function kapat(odakVer) {
      if (!acik) return;
      acik = false;
      menu.classList.remove('is-acik');
      document.documentElement.classList.remove('ttm-kilit');
      tetikleriAyarla();
      if (odakVer !== false && acan && acan.focus) acan.focus();
    }

    /* Iki hamburger de bu menuyu acsin. Capture asamasi: eski
       cekmecelerin kendi dinleyicilerine olay hic ulasmiyor. */
    document.addEventListener('click', function (e) {
      var t = e.target && e.target.closest ? e.target.closest(TETIK) : null;
      if (!t || menu.contains(t)) return;
      e.preventDefault();
      e.stopImmediatePropagation();
      e.stopPropagation();
      if (acik) kapat(); else ac(t);
    }, true);

    menu.addEventListener('click', function (e) {
      var t = e.target;
      if (!t || !t.closest) return;
      if (t.closest('[data-ttm-kapat]')) { kapat(); return; }

      var sepet = t.closest('[data-ttm-sepet]');
      if (sepet) {
        var c = document.getElementById('CartDrawer') || document.querySelector('cart-drawer');
        if (c && typeof c.show === 'function') {
          e.preventDefault();
          kapat(false);
          window.setTimeout(function () { c.show(acan || sepet); }, 30);
        }
        return;
      }
      var ara = t.closest('[data-ttm-ara]');
      if (ara) {
        var d = document.getElementById('SearchDrawer') || document.querySelector('search-drawer');
        if (d && typeof d.show === 'function') {
          e.preventDefault();
          kapat(false);
          window.setTimeout(function () { d.show(acan || ara); }, 30);
        }
        return;
      }
      /* Diger baglantilar: menu kapansin (ayni sayfa ici bag da olabilir). */
      if (t.closest('a[href]')) kapat(false);
    });

    document.addEventListener('keydown', function (e) {
      if (!acik) return;
      if (e.key === 'Escape') { e.preventDefault(); kapat(); return; }
      if (e.key !== 'Tab') return;
      var o = odaklanabilir();
      if (!o.length) return;
      var ilk = o[0], son = o[o.length - 1];
      if (!menu.contains(document.activeElement)) { e.preventDefault(); ilk.focus(); return; }
      if (e.shiftKey && document.activeElement === ilk) { e.preventDefault(); son.focus(); }
      else if (!e.shiftKey && document.activeElement === son) { e.preventDefault(); ilk.focus(); }
    });

    tetikleriAyarla();
    document.addEventListener('DOMContentLoaded', tetikleriAyarla);
    window.addEventListener('load', tetikleriAyarla);

    document.addEventListener('shopify:section:unload', function (e) {
      if (e.detail && e.detail.sectionId === '{{ sid }}') document.documentElement.classList.remove('ttm-kilit');
    });
  })();
</script>
{%- endif -%}

