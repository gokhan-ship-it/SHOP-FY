{%- comment -%}
  TT FOOTER YASAL (17.10.2026: A duzeni secildi)

  Newsletter bolumunun (#000000) hemen altina, ayni koyu blogun devami
  gibi gelir. Iki duzen tek dosyada, "Duzen" ayariyla secilir:
    A) Tam: 1px #262624 cizgi, "YASAL" etiketi, linkler alt alta
       (telefonda tek sutun, masaustunde 2-3 sutun), en altta cizgi + telif.
    B) Minimal: ince cizgi, linkler yan yana kucuk (nokta ayracli), telif.

  Linkler footer-yasal menusunden okunur (merkez sayfa + 7 belge);
  tema editorunde "Menu" ayarindan degistirilebilir. A'da menunun
  sonuna "Iletisim" linki eklenir (ayri ayar; menu degismez).

  Tasarim dili (TEXT-TO-NEXT-TASARIM-DILI.md). Footer dosyada
  "belirlenmedi"; degerler mevcut kurallardan turetildi:
  - Zemin #000000 (newsletter), cizgiler 1px #262624 (koyu zemin cizgisi).
  - Etiket: label 11px 600 +1.3px BUYUK HARF #8A8A85 (koyu zemin ust etiketi).
  - A linkleri: beyaz Poppins 500; boyut menu alt linklerinin (17px) footer
    icin kucultulmus hali olarak body olcegi 15px. Satir yuksekligi 44px
    (en kucuk dokunma alani).
  - B linkleri ve telif: 12.5px #A3A39E (menu destek satiri olcegi).
    B linkleri de 44px yuksekliginde (dokunma alani).
  - Kenar boslugu ve genislik newsletter ile ayni: temanin page-width
    --narrow'u (telefonda 20px). Dikey araliklar 24 / 12 / 16px
    (space-6 / space-3 / space-4).
  - Odak halkasi koyu zeminde #FFFFFF. Hover yok (belirlenmedi).
  - Bulunulan sayfanin linki aria-current="page".
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign s = section.settings
  assign menu = linklists[s.menu]
  assign iletisim_bag = s.iletisim_bag | default: '/pages/iletisim'
  assign yol = request.path
-%}

<style>
  .ttf-{{ sid }} {
    background: #000000;
    color: #ffffff;
    font-family: var(--font-body-family);
  }
  .ttf-{{ sid }} ul { list-style: none; margin: 0; padding: 0; }
  .ttf-{{ sid }} a { color: inherit; text-decoration: none; }
  .ttf-{{ sid }} a:focus-visible { outline: 2px solid #ffffff; outline-offset: 2px; border-radius: 4px; }
  .ttf-{{ sid }} .ttf-telif {
    margin: 0;
    font-size: 12.5px;
    line-height: 1.4;
    color: #a3a39e;
  }

  /* A: tam */
  .ttf-{{ sid }} .ttf-a-ust { border-top: 1px solid #262624; padding: 24px 0 12px; }
  .ttf-{{ sid }} .ttf-etiket {
    margin: 0 0 4px;
    font-size: 11px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 1.3px;
    text-transform: uppercase;
    color: #8a8a85;
  }
  .ttf-{{ sid }} .ttf-a-liste a {
    display: flex;
    align-items: center;
    min-height: 44px;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.3;
    color: #ffffff;
  }
  @media screen and (min-width: 768px) {
    .ttf-{{ sid }} .ttf-a-liste { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 24px; }
  }
  @media screen and (min-width: 1024px) {
    .ttf-{{ sid }} .ttf-a-liste { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .ttf-{{ sid }} .ttf-a-alt {
    border-top: 1px solid #262624;
    padding: 16px 0 calc(24px + env(safe-area-inset-bottom, 0px));
  }

  /* B: minimal */
  .ttf-{{ sid }} .ttf-b {
    border-top: 1px solid #262624;
    padding: 12px 0 calc(24px + env(safe-area-inset-bottom, 0px));
  }
  /* Ogeler satir ici blok; satir yalnizca ogeler arasinda kirilir. Nokta
     ayrac her ogenin solunda; satir basina dusen nokta, liste 17px sola
     kaydirilip nav'da overflow:hidden ile kesilerek gizlenir (satir basinda
     tek basina nokta kalmaz). */
  .ttf-{{ sid }} .ttf-b nav { overflow: hidden; }
  .ttf-{{ sid }} .ttf-b-liste { margin: 0 0 4px -17px; font-size: 0; }
  .ttf-{{ sid }} .ttf-b-liste li { display: inline-block; white-space: nowrap; }
  .ttf-{{ sid }} .ttf-b-liste li::before {
    content: "\00B7";
    display: inline-block;
    width: 17px;
    text-align: center;
    font-size: 12.5px;
    line-height: 44px;
    vertical-align: top;
    color: #a3a39e;
  }
  .ttf-{{ sid }} .ttf-b-liste a {
    display: inline-block;
    vertical-align: top;
    font-size: 12.5px;
    line-height: 44px;
    color: #a3a39e;
  }
  .ttf-{{ sid }} .ttf-b-liste a[aria-current="page"] { color: #ffffff; }
</style>

<div class="ttf-{{ sid }}">
  <div class="page-width page-width--narrow">
    {%- if s.duzen == 'b' -%}
      <div class="ttf-b">
        {%- if menu.links.size > 0 -%}
          <nav aria-label="{{ s.etiket | escape }}">
            <ul class="ttf-b-liste">
              {%- for link in menu.links -%}
                <li><a href="{{ link.url }}"{% if link.url == yol %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}
        {%- if s.telif != blank -%}<p class="ttf-telif">{{ s.telif }}</p>{%- endif -%}
      </div>
    {%- else -%}
      <div class="ttf-a-ust">
        {%- if s.etiket != blank -%}<p class="ttf-etiket" id="ttf-etiket-{{ sid }}">{{ s.etiket }}</p>{%- endif -%}
        <nav{% if s.etiket != blank %} aria-labelledby="ttf-etiket-{{ sid }}"{% endif %}>
          <ul class="ttf-a-liste">
            {%- for link in menu.links -%}
              <li><a href="{{ link.url }}"{% if link.url == yol %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
            {%- endfor -%}
            {%- if s.iletisim_metin != blank -%}
              <li><a href="{{ iletisim_bag }}"{% if iletisim_bag == yol %} aria-current="page"{% endif %}>{{ s.iletisim_metin }}</a></li>
            {%- endif -%}
          </ul>
        </nav>
      </div>
      {%- if s.telif != blank -%}
        <div class="ttf-a-alt"><p class="ttf-telif">{{ s.telif }}</p></div>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Footer (yasal)",
  "tag": "footer",
  "class": "tt-footer-yasal",
  "settings": [
    {
      "type": "select",
      "id": "duzen",
      "label": "Düzen",
      "options": [
        { "value": "a", "label": "A: Tam" },
        { "value": "b", "label": "B: Minimal" }
      ],
      "default": "a"
    },
    { "type": "link_list", "id": "menu", "label": "Menü", "default": "footer" },
    { "type": "text", "id": "etiket", "label": "Etiket (A)", "default": "Yasal" },
    { "type": "text", "id": "iletisim_metin", "label": "İletişim linki metni (A)", "default": "İletişim" },
    { "type": "url", "id": "iletisim_bag", "label": "İletişim linki adresi (A)", "info": "Boşsa /pages/iletisim" },
    { "type": "text", "id": "telif", "label": "Telif / unvan satırı", "default": "© 2026 Text To Next Mücevherat Sanayi ve Ticaret Ltd. Şti." }
  ],
  "presets": [{ "name": "Footer (yasal)" }]
}
{% endschema %}
