{%- comment -%}
  PayTR taksit tablosu - urun sayfasi paneli.

  NEDEN BOLUM, NEDEN BLOK DEGIL:
  Bu tema, yapiskan "Sepete Ekle" dugmesi icin urun formunun IKINCI bir
  kopyasini basiyor (.product-sticky-form). "Urun bilgileri" bolumunun
  icindeki her blok o kopyada tekrar ciziliyor. Panel bir blok oldugunda
  sayfada iki tane olusuyordu; kod ilkini buluyor, o da payment_trust
  blogundaki ".product-sticky-form { display:none }" kurali yuzunden
  gizli bir kutunun icinde kaliyordu. Panel aciliyor ama gorunmuyordu.
  Bolumler kopyalanmadigi icin bu sorun kaynagindan kalkiyor.

  RAKAMLAR NEREDEN GELIYOR:
  Liquid yalnizca FIYATI veriyor (secili varyant + tum varyant haritasi).
  Vade farki oranlari ve taksit tutarlari PayTR'den CANLI geliyor; boylece
  panelde oran degistiginde modal kendiliginden guncelleniyor ve musteriye
  odeme adiminda cikacak tutardan farkli bir sey gosterme riski olmuyor.
  "Tek cekim" satiri PayTR'den gelmiyorsa urun fiyatindan uretiliyor.

  PayTR script'i AYRI BIR IFRAME icinde calistiriliyor: bu tur gomme
  script'ler document.write kullanabiliyor ve sayfa yuklendikten sonra
  calisan bir document.write butun belgeyi siler.

  TURKCE BUYUK HARF:
  Bu bolumde text-transform: uppercase KULLANILMIYOR. Sebep: "taksit"
  kelimesinin "TAKSIT" degil "TAKSIT" (noktali I) olmasi tarayicinin
  lang="tr" bilgisini dogru yorumlamasina bagli ve bu her tarayicida
  guvenilir degil. Etiketler oldugu gibi yaziliyor.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign sid = section.id
-%}

{%- if s.aktif and s.token != blank and s.merchant_id != blank -%}
<style>
  .tt-tk-{{ sid }} {
    --tk-zemin: {{ s.zemin }};
    --tk-grup: {{ s.grup_zemin }};
    --tk-metin: {{ s.metin_renk }};
    --tk-ikincil: {{ s.ikincil_renk }};
    --tk-silik: {{ s.silik_renk }};
    --tk-cizgi: {{ s.cizgi_renk }};
    --tk-kapat: {{ s.kapat_zemin }};
    --tk-rozet-zemin: {{ s.vurgu_zemin }};
    --tk-rozet-metin: {{ s.vurgu_metin }};
    --tk-rozet-cizgi: {{ s.vurgu_metin | color_modify: 'alpha', 0.18 }};
    --tk-rozet-kod: {{ s.vurgu_metin | color_modify: 'alpha', 0.10 }};
    --tk-bilgi-zemin: {{ s.bilgi_zemin }};
    --tk-bilgi-cizgi: {{ s.metin_renk | color_modify: 'alpha', 0.07 }};
    --tk-bilgi-kod: {{ s.metin_renk | color_modify: 'alpha', 0.06 }};
    --tk-odak: {{ s.vurgu }};

    position: fixed;
    border: 0;
    padding: 0;
    margin: auto;
    width: calc(100vw - 32px);
    max-width: 400px;
    max-height: min(88vh, 720px);
    overflow-y: auto;
    overscroll-behavior: contain;
    border-radius: 20px;
    background: var(--tk-zemin);
    color: var(--tk-metin);
    box-shadow: 0 24px 60px rgba(0, 0, 0, .22);
    -webkit-font-smoothing: antialiased;
  }
  .tt-tk-{{ sid }}::backdrop { background: rgba(0, 0, 0, .42); }
  .tt-tk-{{ sid }} * { box-sizing: border-box; }
  .tt-tk-{{ sid }} .tt-tk-ic { padding: 24px 20px 20px; }
  .tt-tk-{{ sid }} .tt-tk-ic:focus { outline: none; }

  {%- comment -%} Mobilde alttan acilan sheet {%- endcomment -%}
  @media (max-width: 480px) {
    .tt-tk-{{ sid }} {
      width: 100%;
      max-width: none;
      margin: 0;
      inset: auto 0 0 0;
      max-height: 88vh;
      border-radius: 20px 20px 0 0;
    }
    .tt-tk-{{ sid }} .tt-tk-ic { padding-bottom: max(20px, env(safe-area-inset-bottom)); }
  }

  {%- comment -%} ---------- Baslik ---------- {%- endcomment -%}
  .tt-tk-{{ sid }} .tt-tk-ust {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
  }
  .tt-tk-{{ sid }} .tt-tk-baslik {
    margin: 0;
    font-size: 22px;
    font-weight: 700;
    font-family: var(--font-heading-family);
    letter-spacing: -0.8px;
    line-height: 1.18;
    color: var(--tk-metin);
    text-transform: none;
  }
  .tt-tk-{{ sid }} .tt-tk-fiyat {
    margin: 4px 0 0;
    font-size: 15px;
    line-height: 1.33;
    letter-spacing: -.01em;
    color: var(--tk-ikincil);
  }
  .tt-tk-{{ sid }} .tt-tk-fiyat b { font-weight: 600; color: var(--tk-metin); }
  .tt-tk-{{ sid }} .tt-tk-kapat {
    flex: 0 0 auto;
    width: 30px;
    height: 30px;
    border: 0;
    border-radius: 50%;
    background: var(--tk-kapat);
    color: var(--tk-ikincil);
    font-size: 15px;
    line-height: 1;
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: background .15s ease;
  }
  .tt-tk-{{ sid }} .tt-tk-kapat:hover { background: rgba(138, 138, 133, .28); }
  .tt-tk-{{ sid }} .tt-tk-kapat:focus-visible { outline: 2px solid var(--tk-odak); outline-offset: 2px; }

  {%- comment -%}
    ---------- Indirim bandi ----------
    Sayfadaki tek renkli oge. Kod okunamazsa JS bu blogu HIC basmiyor,
    yani indirim yokken panel eskisi gibi sade kaliyor.
  {%- endcomment -%}
  .tt-tk-{{ sid }} .tt-tk-indirim {
    background: var(--tk-rozet-zemin);
    border: .5px solid var(--tk-rozet-cizgi);
    border-radius: 14px;
    padding: 12px 14px;
    margin-bottom: 12px;
  }
  .tt-tk-{{ sid }} .tt-tk-ind-ust {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .tt-tk-{{ sid }} .tt-tk-ind-etiket {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -.014em;
    color: var(--tk-rozet-metin);
  }
  .tt-tk-{{ sid }} .tt-tk-ind-kod {
    font-size: 12px;
    font-weight: 500;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: .02em;
    color: var(--tk-rozet-metin);
    background: var(--tk-rozet-kod);
    padding: 4px 8px;
    border-radius: 6px;
    white-space: nowrap;
  }
  .tt-tk-{{ sid }} .tt-tk-ind-not {
    margin: 6px 0 0;
    font-size: 13px;
    line-height: 1.4;
    letter-spacing: -.006em;
    color: var(--tk-rozet-metin);
    opacity: .85;
  }
  {%- comment -%}
    Gri "bilgi" varyanti: kod var ama indirim tutari bilinmiyor.
    Temel kurallar yesil olani ciziyor, buradakiler uzerine yaziyor.
  {%- endcomment -%}
  .tt-tk-{{ sid }} .tt-tk-indirim.tt-tk-ind-bilgi {
    background: var(--tk-bilgi-zemin);
    border-color: var(--tk-bilgi-cizgi);
  }
  .tt-tk-{{ sid }} .tt-tk-ind-bilgi .tt-tk-ind-etiket { color: var(--tk-metin); }
  .tt-tk-{{ sid }} .tt-tk-ind-bilgi .tt-tk-ind-kod {
    color: var(--tk-ikincil);
    background: var(--tk-bilgi-kod);
  }
  .tt-tk-{{ sid }} .tt-tk-ind-bilgi .tt-tk-ind-not { color: var(--tk-ikincil); opacity: 1; }

  {%- comment -%} Sabit genislik: sayac her saniye tikledikce satir oynamasin {%- endcomment -%}
  .tt-tk-{{ sid }} .tt-tk-sayac {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    display: inline-block;
    min-width: 5.2ch;
  }

  {%- comment -%} ---------- Secenek listesi ---------- {%- endcomment -%}
  .tt-tk-{{ sid }} .tt-tk-grup {
    background: var(--tk-grup);
    border: .5px solid var(--tk-cizgi);
    border-radius: 14px;
    overflow: hidden;
  }
  .tt-tk-{{ sid }} .tt-tk-grup + .tt-tk-grup { margin-top: 14px; }
  .tt-tk-{{ sid }} .tt-tk-satir {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 16px;
  }
  .tt-tk-{{ sid }} .tt-tk-satir + .tt-tk-satir { border-top: .5px solid var(--tk-cizgi); }
  .tt-tk-{{ sid }} .tt-tk-etiket {
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -.014em;
    line-height: 1.2;
    color: var(--tk-metin);
    text-transform: none;
  }
  .tt-tk-{{ sid }} .tt-tk-alt {
    margin-top: 3px;
    font-size: 13px;
    letter-spacing: -.006em;
    color: var(--tk-silik);
  }
  .tt-tk-{{ sid }} .tt-tk-sag { text-align: right; }
  .tt-tk-{{ sid }} .tt-tk-tutar-satir {
    display: flex;
    align-items: baseline;
    justify-content: flex-end;
    gap: 6px;
  }
  {%- comment -%} Ustu cizili eski tutar: tasarrufu her satirda somutlastirir {%- endcomment -%}
  .tt-tk-{{ sid }} .tt-tk-eski {
    font-size: 13px;
    color: var(--tk-silik);
    text-decoration: line-through;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .tt-tk-{{ sid }} .tt-tk-tutar {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -.02em;
    line-height: 1.2;
    color: var(--tk-metin);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .tt-tk-{{ sid }} .tt-tk-toplam {
    margin-top: 3px;
    font-size: 13px;
    color: var(--tk-silik);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  {%- comment -%} ---------- Notlar ve kartlar ---------- {%- endcomment -%}
  {%- comment -%}
    Maddeli not listesi. Tik gri: yesil yalnizca indirim bandina ait
    kalsin, sayfada tek renkli oge o olsun.
  {%- endcomment -%}
  .tt-tk-{{ sid }} .tt-tk-liste { list-style: none; margin: 16px 0 0; padding: 0; }
  .tt-tk-{{ sid }} .tt-tk-liste li {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    font-size: 13px;
    line-height: 1.45;
    letter-spacing: -.006em;
    color: var(--tk-ikincil);
  }
  .tt-tk-{{ sid }} .tt-tk-liste li + li { margin-top: 9px; }
  .tt-tk-{{ sid }} .tt-tk-tik {
    flex: 0 0 auto;
    width: 14px;
    height: 14px;
    margin-top: 2px;
    stroke: var(--tk-silik);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    fill: none;
  }
  .tt-tk-{{ sid }} .tt-tk-uyari {
    margin: 14px 2px 0;
    font-size: 13px;
    line-height: 1.5;
    font-weight: 600;
    letter-spacing: -.006em;
    color: var(--tk-metin);
  }
  .tt-tk-{{ sid }} .tt-tk-kartlar {
    margin-top: 20px;
    padding-top: 16px;
    border-top: .5px solid var(--tk-cizgi);
  }
  .tt-tk-{{ sid }} .tt-tk-kartlar-baslik {
    margin: 0 2px 10px;
    font-size: 13px;
    letter-spacing: -.006em;
    color: var(--tk-silik);
    text-transform: none;
  }
  .tt-tk-{{ sid }} .tt-tk-logolar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; }
  .tt-tk-{{ sid }} .tt-tk-logolar img {
    height: 16px;
    width: auto;
    filter: grayscale(1);
    opacity: .7;
  }
  {%- comment -%} Aileler farkli oran verdiginde her grubun ustundeki logo {%- endcomment -%}
  .tt-tk-{{ sid }} .tt-tk-aile { margin: 0 2px 8px; display: flex; align-items: center; gap: 8px; }
  .tt-tk-{{ sid }} .tt-tk-aile img { height: 16px; width: auto; filter: grayscale(1); opacity: .7; }
  .tt-tk-{{ sid }} .tt-tk-aile + .tt-tk-grup { margin-top: 0; }
  .tt-tk-{{ sid }} .tt-tk-bolum + .tt-tk-bolum { margin-top: 16px; }

  .tt-tk-{{ sid }} .tt-tk-durum {
    margin: 0;
    padding: 22px 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--tk-ikincil);
    text-align: center;
  }

  {%- comment -%}
    Dar ekranda satirlarin sikilastirilmasi. Indirim varken sag tarafta
    ustu cizili tutar da bulundugu icin "+... vade farki" satiri aksi
    halde iki satira kaciyor.
  {%- endcomment -%}
  @media (max-width: 430px) {
    .tt-tk-{{ sid }} .tt-tk-ic { padding-left: 16px; padding-right: 16px; }
    .tt-tk-{{ sid }} .tt-tk-satir { gap: 12px; padding-left: 14px; padding-right: 14px; }
    .tt-tk-{{ sid }} .tt-tk-alt { font-size: 12px; }
    .tt-tk-{{ sid }} .tt-tk-eski { font-size: 12px; }
    .tt-tk-{{ sid }} .tt-tk-tutar-satir { gap: 5px; }
  }

  {%- comment -%}
    Cok dar ekran: indirim varken ustu cizili tutar sagda yan yana
    sigmiyor, "+... vade farki" satirini iki satira itiyordu. Burada
    ustu cizili tutar kendi satirina aliniyor ve bant dikey yerlesime
    geciyor -- hicbir bilgi kirpilmiyor.
  {%- endcomment -%}
  @media (max-width: 400px) {
    .tt-tk-{{ sid }} .tt-tk-tutar-satir { flex-direction: column; align-items: flex-end; gap: 0; }
    .tt-tk-{{ sid }} .tt-tk-eski { line-height: 1.3; }
    .tt-tk-{{ sid }} .tt-tk-ind-ust { flex-direction: column; align-items: flex-start; gap: 8px; }
  }

{%- if s.karanlik_mod %}
  {%- comment -%}
    Karanlik mod: yalnizca bu ayar acikken. Magaza her zaman acik temada
    calisiyorsa kapali birakin, yoksa acik sayfanin ustunde koyu bir
    pencere acilir.
  {%- endcomment -%}
  @media (prefers-color-scheme: dark) {
    .tt-tk-{{ sid }} {
      --tk-zemin: #0A0A0A;
      --tk-grup: #141414;
      --tk-metin: #FFFFFF;
      --tk-ikincil: #A3A39E;
      --tk-silik: #A3A39E;
      --tk-cizgi: rgba(255, 255, 255, .12);
      --tk-kapat: #262624;
      --tk-odak: #FFFFFF;
      --tk-rozet-zemin: #141414;
      --tk-rozet-metin: #FFFFFF;
      --tk-rozet-cizgi: rgba(255, 255, 255, .22);
      --tk-rozet-kod: rgba(255, 255, 255, .12);
      --tk-bilgi-zemin: #141414;
      --tk-bilgi-cizgi: rgba(255, 255, 255, .08);
      --tk-bilgi-kod: rgba(255, 255, 255, .10);
    }
    .tt-tk-{{ sid }} .tt-tk-logolar img,
    .tt-tk-{{ sid }} .tt-tk-aile img { filter: grayscale(1) invert(1); opacity: .75; }
  }
{%- endif %}
</style>

{%- comment -%}
  ---------- Urun sayfasi fiyat blogu ----------
  Bu kurallar panelin icinde degil, sayfanin kendisinde duruyor; bu yuzden
  bolum kimligine baglanmadi. Tema urun formunun ikinci bir kopyasini
  bastigi icin blok DOM'da iki kez olusabiliyor, JS hepsini guncelliyor.
{%- endcomment -%}
<style>
  .tt-fb { margin: 10px 0 0; }
  .tt-fb a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }

  {%- comment -%} Indirim seridi: kod yoksa hic basilmaz {%- endcomment -%}
  .tt-fb-serit {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin: 12px 0 0;
    padding: 9px 12px;
    border-radius: 12px;
    background: {{ s.vurgu_zemin }};
    border: .5px solid {{ s.vurgu_metin | color_modify: 'alpha', 0.18 }};
  }
  .tt-fb-serit[hidden] { display: none; }
  {%- comment -%} Tutar bilinmiyorsa (Durum B) serit gri: rakamsiz bilgi {%- endcomment -%}
  .tt-fb-serit.tt-fb-serit-bilgi {
    background: {{ s.bilgi_zemin }};
    border-color: {{ s.metin_renk | color_modify: 'alpha', 0.07 }};
  }
  .tt-fb-serit-bilgi .tt-fb-serit-metin { color: {{ s.metin_renk }}; }
  .tt-fb-serit-bilgi .tt-fb-serit-saat { color: {{ s.ikincil_renk }}; opacity: 1; }
  .tt-fb-serit-metin {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -.01em;
    color: {{ s.vurgu_metin }};
  }
  .tt-fb-serit-saat {
    font-size: 12px;
    color: {{ s.vurgu_metin }};
    opacity: .8;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  {%- comment -%} Sabit genislik: her tik satiri oynatmasin {%- endcomment -%}
  .tt-fb-serit-saat [data-tt-tk-sayac] { display: inline-block; min-width: 5.2ch; }

  {%- comment -%}
    Taksit satiri iki vurgu seviyesinde.
    s3 (kod YOK): kendi zemininde, 18px -- yarisacagi bir sey yok.
    s2 (kod VAR): duz metin -- vurguyu yesil serit tasiyor.
  {%- endcomment -%}
  .tt-fb-satir {
    font-variant-numeric: tabular-nums;
    letter-spacing: -.01em;
    color: {{ s.metin_renk }};
  }
  .tt-fb-buyuk { font-weight: 600; letter-spacing: -.02em; }
  .tt-fb-silik { color: {{ s.ikincil_renk }}; }
  .tt-fb-ayrac { color: {{ s.ikincil_renk }}; }

  .tt-fb-satir.tt-fb-s3 {
    margin: 12px 0 0;
    padding: 11px 13px;
    border-radius: 12px;
    background: {{ s.fb_zemin }};
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    font-size: 15px;
  }
  .tt-fb-s3 .tt-fb-buyuk { font-size: 18px; }
  .tt-fb-s3 .tt-fb-ayrac { display: none; }
  .tt-fb-s3 .tt-fb-link { font-size: 13px; color: {{ s.ikincil_renk }}; white-space: nowrap; }

  .tt-fb-satir.tt-fb-s2 {
    display: block;
    margin: 5px 0 0;
    padding: 0;
    background: none;
    font-size: 15px;
  }
  .tt-fb-s2 .tt-fb-buyuk { font-size: 17px; }
  .tt-fb-s2 .tt-fb-link { color: {{ s.ikincil_renk }}; }

  {%- comment -%}
    Dar ekran: "Ayda 773,54 TL × 3 taksit — Taksit tablosu" 375px'te iki
    satira kaciyordu. Punto bir kademe dusuyor, satir tek kaliyor.
  {%- endcomment -%}
  @media (max-width: 400px) {
    .tt-fb-satir.tt-fb-s2 { font-size: 13.5px; }
    .tt-fb-s2 .tt-fb-buyuk { font-size: 15.5px; }
    .tt-fb-satir.tt-fb-s3 { padding: 10px 12px; font-size: 13.5px; gap: 8px; }
    .tt-fb-s3 .tt-fb-buyuk { font-size: 16px; }
    .tt-fb-s3 .tt-fb-link { font-size: 12px; }
  }

  {%- comment -%} En dar telefonlar (iPhone SE vb.) {%- endcomment -%}
  @media (max-width: 370px) {
    .tt-fb-satir.tt-fb-s3 { font-size: 12.5px; padding: 10px 11px; }
    .tt-fb-s3 .tt-fb-buyuk { font-size: 15px; }
    .tt-fb-s3 .tt-fb-link { font-size: 11.5px; }
  }
</style>

{%- comment -%}
  ---------- Koleksiyon sayfasi ----------
  Izgaranin ustunde TEK indirim seridi + her kartin fiyatinin altinda
  aylik tutar. Serit bolumun kendi yerinde ciziliyor, yani sablonda
  urun izgarasinin hemen ustune konularak konumlaniyor; JS'in izgarayi
  bulmasi gerekmiyor. Kart satirlari ise ".price" ogesinden sonra
  ekleniyor (kartlar da ayni product-price snippet'ini kullaniyor).
{%- endcomment -%}
{%- if s.koleksiyon_modu %}
<style>
  .tt-kol { max-width: {{ s.kol_genislik }}px; margin: 0 auto; padding: 0 {{ s.kol_kenar_m }}px; }
  @media (min-width: 768px) { .tt-kol { padding: 0 {{ s.kol_kenar_d }}px; } }
  .tt-kol-serit {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 10px 13px;
    border-radius: 12px;
    background: {{ s.vurgu_zemin }};
    border: .5px solid {{ s.vurgu_metin | color_modify: 'alpha', 0.18 }};
  }
  .tt-kol-serit[hidden] { display: none; }
  .tt-kol-metin { font-size: 14px; font-weight: 600; letter-spacing: -.01em; color: {{ s.vurgu_metin }}; }
  .tt-kol-saat {
    font-size: 12px;
    color: {{ s.vurgu_metin }};
    opacity: .8;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    text-align: right;
  }
  .tt-kol-saat [data-tt-tk-sayac] { display: inline-block; min-width: 5.2ch; }
  {%- comment -%} Tutar bilinmiyorsa gri {%- endcomment -%}
  .tt-kol-serit.tt-kol-bilgi {
    background: {{ s.bilgi_zemin }};
    border-color: {{ s.metin_renk | color_modify: 'alpha', 0.07 }};
  }
  .tt-kol-bilgi .tt-kol-metin { color: {{ s.metin_renk }}; }
  .tt-kol-bilgi .tt-kol-saat { color: {{ s.ikincil_renk }}; opacity: 1; }

  {%- comment -%} Kart fiyatinin altindaki aylik satiri {%- endcomment -%}
  .tt-kol-aylik {
    margin: 2px 0 0;
    font-size: 12.5px;
    letter-spacing: -.005em;
    color: {{ s.ikincil_renk }};
    font-variant-numeric: tabular-nums;
  }
</style>
<div class="tt-kol" data-tt-kol data-tt-kol-oran="{{ s.kol_oran }}" data-tt-kol-taksit="{{ s.en_cok_taksit }}">
  <div class="tt-kol-serit" data-tt-kol-serit hidden>
    <span class="tt-kol-metin" data-tt-kol-metin></span>
    <span class="tt-kol-saat" data-tt-kol-saat></span>
  </div>
</div>
{%- endif %}

{%- capture tt_veri -%}
{
  "varsayilan": {{ product.selected_or_first_available_variant.price | default: 0 }},
