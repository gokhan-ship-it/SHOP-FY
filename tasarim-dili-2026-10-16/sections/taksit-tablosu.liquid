{% schema %}
{
  "name": "Taksit Tablosu",
  "tag": "section",
  "class": "taksit-tablosu-section",
  "settings": [
    { "type": "checkbox", "id": "aktif", "label": "Bölümü çalıştır", "default": true },
    {
      "type": "checkbox",
      "id": "tani",
      "label": "Teşhis kutusunu göster (geçici)",
      "info": "Açıkken sayfanın sol altında siyah bir bilgi kutusu çıkar. Sorun çözülünce kapatın.",
      "default": false
    },
    {
      "type": "paragraph",
      "content": "Bu bölüm sayfada yer kaplamaz. Ürün bilgilerindeki \"Taksit tablosu\" bağlantısına tıklandığında açılan pencereyi çalıştırır. Şablonda nereye koyduğunuz görünümü etkilemez."
    },
    {
      "type": "paragraph",
      "content": "Taksit tutarları ve vade farkı oranları PayTR'den canlı gelir. Oranları buradan girmezsiniz: PayTR panelinizde değişen oran, pencereye kendiliğinden yansır."
    },

    { "type": "header", "content": "PayTR" },
    { "type": "text", "id": "token", "label": "Taksit tablosu token", "info": "PayTR mağaza panelinden alınır." },
    { "type": "text", "id": "merchant_id", "label": "Mağaza numarası (merchant_id)" },
    {
      "type": "range",
      "id": "en_cok_taksit",
      "label": "En fazla taksit",
      "info": "0 seçilirse PayTR'nin döndürdüğü bütün taksitler gösterilir.",
      "min": 0, "max": 12, "step": 1, "default": 3
    },
    {
      "type": "select",
      "id": "tablo_kapsam",
      "label": "PayTR tablo kapsamı",
      "info": "PayTR'nin \"tumu\" parametresi. \"Yalnızca avantajlı\" seçilirse PayTR bazı taksit adetlerini hiç göndermez (2 taksitin kaybolmasının sebebi buydu).",
      "options": [
        { "value": "tum", "label": "Tüm taksitler (önerilen)" },
        { "value": "avantajli", "label": "Yalnızca avantajlı taksitler" }
      ],
      "default": "tum"
    },
    {
      "type": "range",
      "id": "alt_limit",
      "label": "Taksit alt limiti",
      "info": "Bu tutarın altındaki ürünlerde pencere açılmaz. 0 = sınır yok.",
      "min": 0, "max": 5000, "step": 50, "unit": "₺", "default": 0
    },

    { "type": "header", "content": "Bağlantı" },
    {
      "type": "text",
      "id": "baglanti_metni",
      "label": "Bağlantı metni",
      "info": "Ürün bilgilerindeki metin bağlantısıyla BİREBİR aynı olmalı; pencere bu metinden tanınıyor.",
      "default": "Taksit tablosu"
    },

    { "type": "header", "content": "Pencere metinleri" },
    { "type": "text", "id": "baslik", "label": "Başlık", "default": "Taksit seçenekleri" },
    { "type": "text", "id": "fiyat_on_ek", "label": "Fiyat satırı ön eki", "default": "Ürün fiyatı" },
    { "type": "text", "id": "para_birim", "label": "Para birimi eki", "default": "TL" },
    {
      "type": "text",
      "id": "tek_cekim",
      "label": "Tek çekim satırı",
      "info": "Listenin ilk satırı. PayTR tek çekim döndürmezse ürün fiyatından üretilir.",
      "default": "Tek çekim"
    },
    { "type": "text", "id": "vade_yok", "label": "Vade farksız etiketi", "default": "Vade farkı yok" },
    {
      "type": "text",
      "id": "vade_fark",
      "label": "Vade farkı satırı",
      "info": "{TUTAR} yerine hesaplanan fark yazılır.",
      "default": "+{TUTAR} vade farkı"
    },
    { "type": "text", "id": "toplam_on", "label": "Toplam ön eki", "default": "Toplam" },
    {
      "type": "text",
      "id": "taksit_ek",
      "label": "Taksit satırı eki",
      "info": "Örnek: \"3 taksit\" yazması için buraya \"taksit\" yazın.",
      "default": "taksit"
    },
    {
      "type": "textarea",
      "id": "not_maddeleri",
      "label": "Liste altı maddeler",
      "info": "Her satır bir madde olarak, önünde tik işaretiyle gösterilir. Boş satırlar atlanır.",
      "default": "Ödeme adımında kart bilgilerinizi girdiğinizde kartınıza uygun taksit seçenekleri listelenir.\nYukarıdaki tutarlara vade farkı dahildir, ödeme adımında ek ücret çıkmaz."
    },
    { "type": "text", "id": "logo_notu", "label": "Kart listesi başlığı", "default": "Taksit yapılabilen kartlar" },
    {
      "type": "textarea",
      "id": "kart_notu",
      "label": "Kart listesi altı uyarı",
      "info": "Kalın gösterilir. Anlaşmalı olmayan kartlarda taksit çıkmadığı için müşteriyi önden bilgilendirir.",
      "default": "Diğer banka kartlarında ödeme tek çekim olarak alınır."
    },
    { "type": "text", "id": "yukleniyor", "label": "Yükleniyor metni", "default": "Taksit tablosu yükleniyor…" },
    { "type": "text", "id": "taksit_yok", "label": "Taksit yoksa", "default": "Bu tutar için taksit seçeneği bulunmuyor." },
    { "type": "text", "id": "hata_metni", "label": "Tablo gelmezse", "default": "Taksit tablosu şu an görüntülenemiyor. Taksit seçeneklerini ödeme adımında görebilirsiniz." },
    { "type": "text", "id": "kapat_etiket", "label": "Kapat düğmesi etiketi", "default": "Kapat" },

    { "type": "header", "content": "İndirim kodu katmanı" },
    {
      "type": "paragraph",
      "content": "İndirim kodu çark uygulamasının yazdığı çerezlerden okunur; kod çubuğunun ekranda olmasına gerek yoktur. Kod varsa ve süresi dolmamışsa pencerede bir bant çıkar. Çerezlerden biri bile okunamazsa hiçbir bant basılmaz."
    },
    { "type": "checkbox", "id": "indirim_aktif", "label": "İndirim katmanını çalıştır", "default": false },
    {
      "type": "text",
      "id": "indirim_tutar",
      "label": "İndirim tutarı (₺)",
      "info": "Çarkın verdiği sabit tutar. Boş veya 0 ise kod yine duyurulur ama tutarlar indirimsiz gösterilir — yanlış rakam gösterilmez.",
      "default": "0"
    },
    {
      "type": "text",
      "id": "indirim_etiket",
      "label": "Bant başlığı (tutar biliniyorsa)",
      "info": "{TUTAR} yerine indirim tutarı yazılır.",
      "default": "{TUTAR} indirim uygulanacak"
    },
    {
      "type": "text",
      "id": "indirim_sayac_metni",
      "label": "Geri sayım cümlesi",
      "info": "{SURE} yerine kalan süre yazılır.",
      "default": "Kodunuz {SURE} içinde geçerliliğini yitiriyor."
    },
    {
      "type": "text",
      "id": "indirim_not",
      "label": "İndirim varken eklenecek madde",
      "info": "Yalnızca indirim tutarı biliniyorken (yeşil bant) listeye eklenir.",
      "default": "İndirim kodunuz sepette otomatik uygulanır, elle girmenize gerek yok."
    },
    {
      "type": "text",
      "id": "indirim_b_etiket",
      "label": "Bant başlığı (tutar bilinmiyorsa)",
      "default": "İndirim kodunuz sepette uygulanacak"
    },
    {
      "type": "text",
      "id": "indirim_b_not",
      "label": "Bant uyarısı (tutar bilinmiyorsa)",
      "default": "Aşağıdaki tutarlar indirim öncesi fiyat üzerindendir."
    },

    { "type": "header", "content": "Ürün sayfası fiyat bloğu" },
    {
      "type": "paragraph",
      "content": "Fiyatın altındaki taksit satırı ve indirim şeridi. Vade farkı oranı bloğun kendi kodunda duruyor (Özel Liquid alanı); sayfa açıldıktan sonra PayTR'den gerçek oran çekilip gerekiyorsa sessizce düzeltilir."
    },
    {
      "type": "text",
      "id": "fb_ayda",
      "label": "Aylık tutar metni",
      "info": "{TUTAR} yerine hesaplanan aylık tutar yazılır.",
      "default": "Ayda {TUTAR}"
    },
    {
      "type": "text",
      "id": "fb_taksit_ek",
      "label": "Taksit adedi metni",
      "info": "{ADET} yerine taksit sayısı yazılır.",
      "default": "× {ADET} taksit"
    },
    {
      "type": "text",
      "id": "fb_kodlu",
      "label": "İndirim şeridi metni",
      "info": "{TUTAR} yerine indirimli fiyat yazılır. Tutar bilinmiyorsa bunun yerine \"Bant başlığı (tutar bilinmiyorsa)\" kullanılır.",
      "default": "Kodunuzla {TUTAR}"
    },
    {
      "type": "text",
      "id": "fb_saat",
      "label": "Şerit sayaç metni",
      "info": "{SURE} yerine geri sayım yazılır.",
      "default": "{SURE} kaldı"
    },
    { "type": "color", "id": "fb_zemin", "label": "Taksit satırı zemini (kod yokken)", "default": "#F4F4F4" },

    { "type": "header", "content": "Koleksiyon sayfası" },
    {
      "type": "paragraph",
      "content": "Bu bölümü koleksiyon şablonunda ürün ızgarasının hemen üstüne koyun. Izgaranın üstünde tek bir indirim şeridi, her kartın fiyatının altında da aylık tutar gösterir."
    },
    { "type": "checkbox", "id": "koleksiyon_modu", "label": "Koleksiyon modu", "default": false },
    {
      "type": "text",
      "id": "kol_oran",
      "label": "Vade farkı oranı (%)",
      "info": "İlk boyamada kullanılır; sayfa açıldıktan sonra PayTR'den gelen gerçek oranla sessizce düzeltilir.",
      "default": "10.5583"
    },
    { "type": "text", "id": "kol_metni", "label": "Şerit metni", "info": "{TUTAR} yerine indirim tutarı yazılır.", "default": "{TUTAR} indirim kodunuz aktif" },
    { "type": "text", "id": "kol_saat", "label": "Şerit sayaç metni", "info": "{SURE} yerine geri sayım yazılır.", "default": "{SURE} kaldı" },
    { "type": "text", "id": "kol_aylik", "label": "Kart aylık satırı", "info": "{TUTAR} aylık tutar, {ADET} taksit sayısı.", "default": "Ayda {TUTAR} × {ADET}" },
    { "type": "range", "id": "kol_genislik", "label": "Şerit en fazla genişlik", "min": 600, "max": 1600, "step": 20, "unit": "px", "default": 1400 },
    { "type": "range", "id": "kol_kenar_m", "label": "Yan boşluk (mobil)", "min": 0, "max": 48, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "kol_kenar_d", "label": "Yan boşluk (masaüstü)", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 40 },

    { "type": "header", "content": "İndirim çerez adları" },
    {
      "type": "paragraph",
      "content": "Çark uygulaması bu adları değiştirirse katman sessizce kapanır. Değiştirmeniz gerekmiyorsa dokunmayın."
    },
    { "type": "text", "id": "cerez_kod", "label": "Kod çerezi", "default": "wlo-codebar-code" },
    { "type": "text", "id": "cerez_sure", "label": "Süre çerezi (saniye)", "default": "wlo-codebar-counter" },
    { "type": "text", "id": "cerez_zaman", "label": "Başlangıç çerezi (ms)", "default": "wlo-codebar-time" },

    { "type": "header", "content": "Renkler" },
    {
      "type": "checkbox",
      "id": "karanlik_mod",
      "label": "Karanlık modu destekle",
      "info": "Ziyaretçinin cihazı karanlık moddaysa pencere koyu görünür. Mağazanız her zaman açık temada çalışıyorsa kapalı bırakın.",
      "default": false
    },
    { "type": "color", "id": "zemin", "label": "Pencere zemini", "default": "#FFFFFF" },
    { "type": "color", "id": "grup_zemin", "label": "Liste zemini", "default": "#FFFFFF" },
    { "type": "color", "id": "metin_renk", "label": "Metin", "default": "#0A0A0A" },
    { "type": "color", "id": "ikincil_renk", "label": "İkincil metin", "default": "#5C5C57" },
    { "type": "color", "id": "silik_renk", "label": "Dipnot ve toplam", "default": "#5C5C57" },
    { "type": "color", "id": "cizgi_renk", "label": "Ayırıcı çizgi", "default": "#D2D2CD" },
    { "type": "color", "id": "kapat_zemin", "label": "Kapat düğmesi zemini", "default": "#F4F4F4" },
    { "type": "color", "id": "vurgu_zemin", "label": "İndirim bandı zemini (tutar biliniyorsa)", "default": "#F4F4F4" },
    { "type": "color", "id": "vurgu_metin", "label": "İndirim bandı metni (tutar biliniyorsa)", "default": "#0A0A0A" },
    { "type": "color", "id": "bilgi_zemin", "label": "İndirim bandı zemini (tutar bilinmiyorsa)", "default": "#F4F4F4" },
    { "type": "color", "id": "vurgu", "label": "Odak halkası", "default": "#0A0A0A" }
  ],
  "presets": [
    { "name": "Taksit Tablosu" }
  ]
}
{% endschema %}
