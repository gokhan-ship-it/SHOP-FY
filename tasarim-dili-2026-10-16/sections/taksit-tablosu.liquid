  "enCokTaksit": {{ s.en_cok_taksit }},
  "altLimit": {{ s.alt_limit | times: 100 }},
  "metin": {{ s.baglanti_metni | downcase | json }},
  "fiyatOnEk": {{ s.fiyat_on_ek | json }},
  "paraBirim": {{ s.para_birim | json }},
  "tekCekim": {{ s.tek_cekim | json }},
  "vadeYok": {{ s.vade_yok | json }},
  "vadeFark": {{ s.vade_fark | json }},
  "toplamOn": {{ s.toplam_on | json }},
  "taksitEk": {{ s.taksit_ek | json }},
  "indirimAktif": {{ settings.tt_indirim_aktif | json }},
  "cKod": {{ settings.tt_cerez_kod | json }},
  "cSure": {{ settings.tt_cerez_sure | json }},
  "cZaman": {{ settings.tt_cerez_zaman | json }},
  "indTutar": {{ settings.tt_indirim_tutar | json }},
  "indEtiket": {{ s.indirim_etiket | json }},
  "indBEtiket": {{ s.indirim_b_etiket | json }},
  "indBNot": {{ s.indirim_b_not | json }},
  "indSayacMetni": {{ s.indirim_sayac_metni | json }},
  "indNot": {{ s.indirim_not | json }},
  "kolMetni": {{ s.kol_metni | json }},
  "kolSaat": {{ s.kol_saat | json }},
  "kolAylik": {{ s.kol_aylik | json }},
  "fbKodlu": {{ s.fb_kodlu | json }},
  "fbSaat": {{ s.fb_saat | json }},
  "fbAyda": {{ s.fb_ayda | json }},
  "fbTaksitEk": {{ s.fb_taksit_ek | json }},
  "maddeler": {{ s.not_maddeleri | json }},
  "logoNot": {{ s.logo_notu | json }},
  "kartNot": {{ s.kart_notu | json }},
  "yok": {{ s.taksit_yok | json }},
  "hata": {{ s.hata_metni | json }},
  "yukleniyor": {{ s.yukleniyor | json }},
  "kaynak": "https://www.paytr.com/odeme/taksit-tablosu/v2?token={{ s.token | escape }}&merchant_id={{ s.merchant_id | escape }}&amount={TUTAR}&taksit=0&tumu={% if s.tablo_kapsam == 'avantajli' %}0{% else %}1{% endif %}"
}
{%- endcapture -%}
<dialog class="tt-tk-{{ sid }} tt-taksit-panel" data-tt-tk data-tt-tk-veri="{{ tt_veri | strip | escape }}" aria-labelledby="tt-tk-baslik-{{ sid }}">
  <div class="tt-tk-ic" tabindex="-1">
    <div class="tt-tk-ust">
      <div>
        <h2 class="tt-tk-baslik" id="tt-tk-baslik-{{ sid }}">{{ s.baslik | escape }}</h2>
        <p class="tt-tk-fiyat" data-tt-tk-fiyat></p>
      </div>
