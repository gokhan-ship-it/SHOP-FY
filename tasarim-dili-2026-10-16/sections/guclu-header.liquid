<script>
  (function () {
    var bolum = document.getElementById('shopify-section-{{ sid }}');
    if (!bolum) return;
    var kok = bolum.querySelector('[data-gh-kok]');
    if (!kok) return;

    var azHareket = window.matchMedia
      && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* --- cam cubuk: bir sonraki bolume kaydir --- */
    var kaydirBtn = kok.querySelector('[data-gh-kaydir]');
    if (kaydirBtn) {
      kaydirBtn.addEventListener('click', function () {
        var hedef = bolum.nextElementSibling;
        // Bos sarmalayicilari atla: bazi bolumler hic yukseklik uretmiyor
        while (hedef && hedef.getBoundingClientRect().height < 4) {
          hedef = hedef.nextElementSibling;
        }
        if (!hedef) return;

        var ofset = parseInt(kok.getAttribute('data-gh-ofset'), 10);
        if (isNaN(ofset)) ofset = 0;

        var y = hedef.getBoundingClientRect().top + window.pageYOffset - ofset;
        var enCok = (document.documentElement.scrollHeight || 0)
          - (window.innerHeight || document.documentElement.clientHeight);
        if (y > enCok) y = enCok;
        if (y < 0) y = 0;

        window.scrollTo({ top: Math.round(y), behavior: azHareket ? 'auto' : 'smooth' });
      });
    }

    {%- if s.kompakt %}
    /* --- ustteki header'in yuksekligini olc --- */
    /* getBoundingClientRect().top + pageYOffset = bolumun belge
       icindeki konumu, yani ustunde ne kadar yer kaplandigi. Kaydirma
       konumundan bagimsizdir. Header sabit (fixed) ve icerigin uzerine
       biniyorsa bu deger zaten 0 cikar, o zaman dusulecek bir sey yok. */
    var ustOlc = function () {
      {%- if s.ust_oto %}
      var y = kok.getBoundingClientRect().top + window.pageYOffset;
      if (!isFinite(y) || y < 0) y = 0;
      // Akil saglig~i siniri: absurt bir deger yuzunden bolum yok olmasin.
      if (y > 320) y = 320;
      kok.style.setProperty('--gh-ust', Math.round(y) + 'px');
      {%- else %}
      kok.style.setProperty('--gh-ust', '{{ s.ust_ofset }}px');
      {%- endif %}
    };

    ustOlc();
    window.addEventListener('load', ustOlc);

    var ustZaman = null;
    window.addEventListener('resize', function () {
      if (ustZaman) window.clearTimeout(ustZaman);
      ustZaman = window.setTimeout(ustOlc, 120);
    });
    {%- endif %}

    /* --- ana dugme ikiye bolunsun --- */
    var yuva = kok.querySelector('[data-gh-yuva]');
    if (yuva) {
      var tetik = yuva.querySelector('[data-gh-bol]');
      if (tetik) {
        // Gizli baslangic durumunu ancak burada aciyoruz: JS yoksa
        // iki baglanti da dogrudan gorunur kalir.
        yuva.classList.add('gh-bol-hazir');

        var bolAyarla = function (acik) {
          yuva.classList.toggle('is-bolundu', acik);
          tetik.setAttribute('aria-expanded', acik ? 'true' : 'false');
        };

        tetik.addEventListener('click', function (e) {
          e.preventDefault();
          bolAyarla(!yuva.classList.contains('is-bolundu'));
        });

        document.addEventListener('click', function (e) {
          if (!yuva.classList.contains('is-bolundu')) return;
          if (yuva.contains(e.target)) return;
          bolAyarla(false);
        });

        document.addEventListener('keydown', function (e) {
          if (e.key !== 'Escape' && e.keyCode !== 27) return;
          if (yuva.classList.contains('is-bolundu')) bolAyarla(false);
        });
      }
    }

    {%- if s.bas_tek_satir %}
    /* --- basligi tek satira sigdir --- */
    /* CSS'teki min(...px, ...vw) zaten tasmayi onluyor; burada punto,
       kalan bosluga gore mumkun olan en buyuk degere cekiliyor. Boylece
       her ekran genisliginde tek satir kalir ama gereksiz kucuk olmaz. */
    var basEl = kok.querySelector('.gh-bas');
    var basSigdir = function () {
      if (!basEl) return;
      basEl.style.fontSize = '';
      var mevcut = parseFloat(window.getComputedStyle(basEl).fontSize);
      if (!mevcut) return;
      var yer = basEl.clientWidth;
      var gerek = basEl.scrollWidth;
      if (!yer || !gerek || gerek <= yer) return;
      // 0.995: scrollWidth tam sayiya yuvarlandigi icin kucuk bir pay.
      var yeni = Math.floor(mevcut * (yer / gerek) * 0.995 * 100) / 100;
      if (yeni < 12) yeni = 12;
      basEl.style.fontSize = yeni + 'px';
    };

    basSigdir();
    if (document.fonts && document.fonts.ready && document.fonts.ready.then) {
      document.fonts.ready.then(basSigdir);
    }
    window.addEventListener('load', basSigdir);

    var basZaman = null;
    window.addEventListener('resize', function () {
      if (basZaman) window.clearTimeout(basZaman);
      basZaman = window.setTimeout(basSigdir, 120);
    });
    {%- endif %}

    {%- if parallax_var %}
    /* --- parallax --- */
    var pKutu = kok.querySelector('.gh-medya');
    var pOge = pKutu ? pKutu.querySelector('img, video') : null;
    if (pOge) {
      var pGuc = {{ s.parallax_guc }};
      var pGenis = window.matchMedia ? window.matchMedia('(min-width: 750px)') : null;
      var pBekliyor = false;

      var pCiz = function () {
        pBekliyor = false;
        if (azHareket || (pGenis && !pGenis.matches)) {
          pOge.style.transform = '';
          return;
        }
        var r = pKutu.getBoundingClientRect();
        var vy = window.innerHeight || document.documentElement.clientHeight;
        if (!vy) return;
        // -1 = serit ekranin ustunde, 0 = tam ortada, 1 = altinda
        var t = ((r.top + r.height / 2) - vy / 2) / (vy / 2 + r.height / 2);
        if (t > 1) t = 1;
        if (t < -1) t = -1;
        pOge.style.transform = 'translate3d(0, ' + (t * pGuc).toFixed(1) + 'px, 0)';
      };

      var pIste = function () {
        if (pBekliyor) return;
        pBekliyor = true;
        window.requestAnimationFrame(pCiz);
      };

      pCiz();
      window.addEventListener('scroll', pIste, { passive: true });
      window.addEventListener('resize', pIste);
      if (pGenis && pGenis.addEventListener) pGenis.addEventListener('change', pCiz);
    }
    {%- endif %}

    /* --- video: gorununce oynat, cikinca durdur --- */
    var video = kok.querySelector('[data-gh-video]');
    if (video) {
      // Kaynagi burada atiyoruz: boylece gizli kalan kirilimin videosu
      // hic indirilmez. <source media="..."> video icinde calismiyor.
      var genis = window.matchMedia && window.matchMedia('(min-width: 750px)').matches;
      var src = genis
        ? video.getAttribute('data-gh-src-d')
        : (video.getAttribute('data-gh-src-m') || video.getAttribute('data-gh-src-d'));
      if (src) video.src = src;
    }

    if (video && !azHareket) {
      video.muted = true;
      var oynat = function () {
        var p = video.play();
        if (p && p.catch) p.catch(function () {});
      };
      if ('IntersectionObserver' in window) {
        var vg = new IntersectionObserver(function (girisler) {
          for (var i = 0; i < girisler.length; i++) {
            if (girisler[i].isIntersecting) { oynat(); } else { video.pause(); }
          }
        }, { threshold: 0.2 });
        vg.observe(video);
      } else {
        oynat();
      }
    }

    /* --- giris animasyonu --- */
    {%- if s.anim_ac %}
    var ogeler = kok.querySelectorAll('[data-gh-anim]');
    if (ogeler.length) {
      var ara = {{ s.anim_ara }};
      for (var i = 0; i < ogeler.length; i++) {
        ogeler[i].style.setProperty('--gh-gecikme', (i * ara) + 'ms');
      }

      kok.classList.add('gh-hazir');

      function goster(oge) {
        oge.classList.add('is-gorunur');
        oge.addEventListener('transitionend', function son(e) {
          if (e.propertyName !== 'transform') return;
          oge.removeEventListener('transitionend', son);
          oge.classList.add('anim-bitti');
          oge.style.removeProperty('--gh-gecikme');
        });
      }

      if (azHareket || !('IntersectionObserver' in window)) {
        for (var a = 0; a < ogeler.length; a++) goster(ogeler[a]);
      } else {
        // Hero sayfanin tepesinde oldugu icin hemen baslatiyoruz;
        // gozlemci yalnizca ilk kareyi beklemek icin.
        window.requestAnimationFrame(function () {
          window.requestAnimationFrame(function () {
            for (var b = 0; b < ogeler.length; b++) goster(ogeler[b]);
          });
        });
      }
    }
    {%- endif %}
  })();
</script>

