{%- comment -%}
  TT KILAVUZ -- kullanim kilavuzu sayfalari

  GemPages'ten tasinan uc sayfanin ortak bolumu:
    /pages/kullanim-kilavuzu                 -> templates/page.kilavuz.json
    /pages/bireysel-hediye-kullanim-kilavuzu -> templates/page.kilavuz-bireysel.json
    /pages/couple-hediye-kullanim-kilavuzu   -> templates/page.kilavuz-couple.json
  Metinler GemPages surumundeki ile birebir (gempages-cikis/KULLANIM-
  KILAVUZU.md); yalnizca calisma saati K5'e gore "Hafta ici 10.00–18.00".
  Basili kilavuzdaki QR bu adrese gidiyor (?_ab=0&key=... ve ?key=...
  ekleriyle). Bolum adresteki parametrelerin hicbirine bagli degil.

  Tasarim dili: TEXT-TO-NEXT-TASARIM-DILI.md (17.10.2026).
  - Yalnizca palet renkleri. Koyu kart #0A0A0A (acik zeminde koyu kart,
    "Nasil calisir?" karti gibi), bilgi kutusu #F4F4F4.
  - Tek aile Poppins, temanin degiskenleriyle (--font-heading-family,
    --font-body-family); yeni font yuklenmiyor.
  - Olcek telefon tablosundan: title-xl 32/700/1.08/-1px, title-md
    17/700/1.2/-0.3px, body 15/1.45, small 13.5/1.35, label 11/600/+1.3px.
    Masaustu olcegi tasarim dilinde belirlenmedigi icin masaustunde de ayni
    (K14: masaustunde de telefondaki gibi dar tek sutun).
  - Sutun genisligi 440px: tasarim dilinde masaustu alttan acilan
    pencerenin genisligi (bolum 4). Ayri bir "icerik genisligi" degeri
    belirlenmedi.
  - Kartlarda marka simgeleri (Single kilitli halka, Couple ic ice
    halkalar) tasarim dili bolum 6'dan birebir; menudeki gibi halka rengi
    #262624. Ekrandaki neon yalnizca bu iki simgenin kucuk parcasi (2 yer).
  - Cizgi/ok ikonlari menudeki (tt-menu) capraz okun aynisi.
  - Kose: kart 12px, bilgi kutusu 16px, video 12px. Golge yok, hover yok
    (hover tasarim dilinde belirlenmedi).
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign s = section.settings
-%}

<style>
  #shopify-section-{{ sid }} {
    --section-padding-top: {{ s.padding_top }}px;
    --section-padding-bottom: {{ s.padding_bottom }}px;
  }
  .ttk-{{ sid }} {
    padding-inline: 24px;
    background: #ffffff;
    color: #0a0a0a;
    font-family: var(--font-body-family);
    font-weight: 400;
  }
  .ttk-{{ sid }} .ttk-ic {
    max-width: 440px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* title-xl; ikinci satir iki satirli baslik kurali (32px >= 24px -> #8A8A85) */
  .ttk-{{ sid }} .ttk-h1 {
    margin: 0 0 4px;
    font-family: var(--font-heading-family);
    font-size: 32px;
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -1px;
    color: #0a0a0a;
  }
  .ttk-{{ sid }} .ttk-h1 .ttk-gri { display: block; color: #8a8a85; }

  /* title-md */
  .ttk-{{ sid }} .ttk-h2 {
    margin: 20px 0 0;
    font-family: var(--font-heading-family);
    font-size: 17px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.3px;
    color: #0a0a0a;
  }

  /* body; ikincil metin #5C5C57 */
  .ttk-{{ sid }} .ttk-metin {
    font-size: 15px;
    line-height: 1.45;
    color: #5c5c57;
  }
  .ttk-{{ sid }} .ttk-metin p { margin: 0; }
  .ttk-{{ sid }} .ttk-metin p + p { margin-top: 4px; }
  .ttk-{{ sid }} .ttk-metin strong { color: #0a0a0a; font-weight: 600; }
  /* Link: ink, alti cizili (mavi link yok). Tek basina duran link 44px. */
  .ttk-{{ sid }} .ttk-metin a {
    color: #0a0a0a;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ttk-{{ sid }} .ttk-metin p > a:only-child {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
  }

  /* Kart: #0A0A0A, 12px, ic bosluk 16px (space-4). */
  .ttk-{{ sid }} .ttk-kart {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 44px;
    padding: 16px;
    border-radius: 12px;
    background: #0a0a0a;
    color: #ffffff;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }
  .ttk-{{ sid }} .ttk-kart:focus-visible { outline: 2px solid #0a0a0a; outline-offset: 3px; }
  .ttk-{{ sid }} .ttk-simge { flex: 0 0 auto; width: 34px; height: 34px; display: grid; place-items: center; }
  .ttk-{{ sid }} .ttk-simge svg { width: 30px; height: auto; }
  .ttk-{{ sid }} .ttk-simge--nfc svg { width: 22px; }
  .ttk-{{ sid }} .ttk-kart-yazi { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: 3px; }
  /* label: 11/600/+1.3px, BUYUK HARF; koyu zeminde #8A8A85 */
  .ttk-{{ sid }} .ttk-etiket {
    font-size: 11px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 1.3px;
    text-transform: uppercase;
    color: #8a8a85;
  }
  .ttk-{{ sid }} .ttk-kart-baslik {
    font-family: var(--font-heading-family);
    font-size: 17px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.3px;
  }
  /* koyu zeminde ikincil metin #A3A39E (menu kart alt satiri 12.5px) */
  .ttk-{{ sid }} .ttk-kart-alt { font-size: 12.5px; line-height: 1.35; color: #a3a39e; }
  .ttk-{{ sid }} .ttk-kart-alt strong { color: #ffffff; font-weight: 600; }
  .ttk-{{ sid }} .ttk-ok { flex: 0 0 auto; color: #8a8a85; }

  /* Bilgi kutusu: #F4F4F4, 16px, ikon + kalin baslik yan yana. */
  .ttk-{{ sid }} .ttk-kutu {
    padding: 16px;
    border-radius: 16px;
    background: #f4f4f4;
  }
  .ttk-{{ sid }} .ttk-kutu-bas {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 6px;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.2;
    color: #0a0a0a;
  }
  .ttk-{{ sid }} .ttk-kutu-bas svg { flex: 0 0 auto; width: 20px; height: 20px; }
  .ttk-{{ sid }} .ttk-kutu-metin { font-size: 13.5px; line-height: 1.35; color: #5c5c57; }
  .ttk-{{ sid }} .ttk-kutu-metin p { margin: 0; }
  .ttk-{{ sid }} .ttk-kutu-metin strong { color: #0a0a0a; font-weight: 600; }

  .ttk-{{ sid }} .ttk-video { margin: 0; border-radius: 12px; overflow: hidden; background: #000000; }
  .ttk-{{ sid }} .ttk-video video { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; background: #000000; }
</style>

<div class="section section--padding">
  <div class="ttk-{{ sid }}" id="ttk-{{ sid }}">
    <div class="ttk-ic">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- case block.type -%}
          {%- when 'baslik' -%}
            {%- if b.metin != blank -%}
              <h1 class="ttk-h1" {{ block.shopify_attributes }}>
                {{- b.metin -}}
                {%- if b.ikinci_satir != blank %} <span class="ttk-gri">{{ b.ikinci_satir }}</span>{%- endif -%}
              </h1>
            {%- endif -%}

          {%- when 'ara_baslik' -%}
            {%- if b.metin != blank -%}
              <h2 class="ttk-h2" {{ block.shopify_attributes }}>{{ b.metin }}</h2>
            {%- endif -%}

          {%- when 'metin' -%}
            {%- if b.metin != blank -%}
              <div class="ttk-metin" {{ block.shopify_attributes }}>{{ b.metin }}</div>
            {%- endif -%}

          {%- when 'kart' -%}
            {%- comment -%}
              Kartlar art arda geldiginde tek liste gibi aralikli dursun diye
              ayri sarmalayici yok; aralik .ttk-ic'in gap'i (12px).
            {%- endcomment -%}
            <a
              class="ttk-kart"
              href="{{ b.bag | default: '#' }}"
              {% if b.onizleme_view != blank %}data-ttk-view="{{ b.onizleme_view | escape }}"{% endif %}
              {{ block.shopify_attributes }}
            >
              <span class="ttk-simge{% if b.ikon == 'nfc' %} ttk-simge--nfc{% endif %}" aria-hidden="true">
                {%- case b.ikon -%}
                  {%- when 'couple' -%}
                    <svg viewBox="-17 -12 34 24" fill="none"><defs><clipPath id="ttk-cp-{{ block.id }}"><circle cx="-5.5" r="9.5"/></clipPath></defs><circle cx="5.5" r="9.5" fill="#D6FF00" clip-path="url(#ttk-cp-{{ block.id }})"/><circle cx="-5.5" r="9.5" stroke="#FFFFFF" stroke-width="1.6"/><circle cx="5.5" r="9.5" stroke="#FFFFFF" stroke-width="1.6"/></svg>
                  {%- when 'nfc' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="18" r="1.6"/><path d="M6 12.5a5.5 5.5 0 0 1 5.5 5.5"/><path d="M6 7.5A10.5 10.5 0 0 1 16.5 18"/><path d="M6 2.5A15.5 15.5 0 0 1 21.5 18"/></svg>
                  {%- else -%}
                    <svg viewBox="-15 -15 30 30" fill="none"><circle r="12.5" stroke="#262624" stroke-width="1.6"/><path d="M0 -12.5 A12.5 12.5 0 1 1 -10.8 6.25" stroke="#FFFFFF" stroke-width="1.6" stroke-linecap="round"/><circle cx="-10.8" cy="6.25" r="2.4" fill="#D6FF00"/><path d="M-2.6 -1v-1.8a2.6 2.6 0 0 1 5.2 0v1.8" stroke="#FFFFFF" stroke-width="1.4"/><rect x="-4.2" y="-1.2" width="8.4" height="6.4" rx="1.5" fill="#FFFFFF"/></svg>
                {%- endcase -%}
              </span>
              <span class="ttk-kart-yazi">
                {%- if b.etiket != blank -%}<span class="ttk-etiket">{{ b.etiket }}</span>{%- endif -%}
                <span class="ttk-kart-baslik">{{ b.baslik }}</span>
                {%- if b.alt_metin != blank -%}<span class="ttk-kart-alt">{{ b.alt_metin }}</span>{%- endif -%}
              </span>
              <svg class="ttk-ok" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10L10 4M5 4h5v5"/></svg>
            </a>

          {%- when 'uyari' -%}
            <div class="ttk-kutu" role="note" {{ block.shopify_attributes }}>
              {%- if b.baslik != blank -%}
                <p class="ttk-kutu-bas">
                  <svg viewBox="0 0 24 24" fill="none" stroke="#0A0A0A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5.5"/><path d="M12 7.6v.1"/></svg>
                  {{ b.baslik }}
                </p>
              {%- endif -%}
              <div class="ttk-kutu-metin">{{ b.metin }}</div>
            </div>

          {%- when 'video' -%}
            {%- if b.video_url != blank -%}
              <figure class="ttk-video" {{ block.shopify_attributes }}>
                {%- comment -%}
                  #t=0.1: kapak gorseli yokken iOS Safari'nin ilk kareyi
                  gostermesi icin. preload=metadata yalnizca ilk kareyi ve
                  sureyi indirir, videonun tamamini degil.
                {%- endcomment -%}
                <video
                  src="{{ b.video_url }}{% if b.kapak == blank %}#t=0.1{% endif %}"
                  {% if b.kapak != blank %}poster="{{ b.kapak | image_url: width: 1200 }}"{% endif %}
                  controls
                  playsinline
                  preload="metadata"
                  {% if b.baslik != blank %}aria-label="{{ b.baslik | escape }}"{% endif %}
                ></video>
              </figure>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{%- comment -%}
  ONIZLEME YARDIMCISI -- GECICI.

  Kartlarin linkleri her zaman TEMIZ (/pages/bireysel-hediye-kullanim-
  kilavuzu, /pages/couple-hediye-kullanim-kilavuzu). Sayfa ?view=kilavuz
  ile acildiysa (yani sablon henuz sayfaya baglanmadan onizleniyorsa) bu
  betik data-ttk-view tasiyan kartlarin linkine ?view=... ekler; boylece
  onizlemede alt kilavuzlarin da yeni sablonu acilir. Normal ziyarette
  (view yokken) hicbir sey yapmaz. preview_theme_id hicbir zaman eklenmez.

  SUFFIX DEGISIKLIGINDEN SONRA KALDIRILACAK: bu <script> blogu ve
  kart blogundaki "onizleme_view" ayari ile data-ttk-view niteligi.
{%- endcomment -%}
<script>
  (function () {
    if (new URLSearchParams(location.search).get('view') !== 'kilavuz') return;
    var kok = document.getElementById('ttk-{{ sid }}');
    if (!kok) return;
    kok.querySelectorAll('a[data-ttk-view]').forEach(function (a) {
      var u = new URL(a.getAttribute('href'), location.origin);
      u.searchParams.set('view', a.getAttribute('data-ttk-view'));
      a.setAttribute('href', u.pathname + u.search + u.hash);
    });
  })();
</script>

{% schema %}
{
  "name": "Kullanım kılavuzu",
  "tag": "section",
  "class": "tt-kilavuz",
  "settings": [
    { "type": "range", "id": "padding_top", "label": "Üst boşluk", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Alt boşluk", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 120 }
  ],
  "blocks": [
    {
      "type": "baslik",
      "name": "Sayfa başlığı",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "metin", "label": "Metin" },
        { "type": "text", "id": "ikinci_satir", "label": "Gri ikinci satır", "info": "İki satırlı başlık: ikinci kısım gri (#8A8A85)." }
      ]
    },
    {
      "type": "ara_baslik",
      "name": "Adım başlığı",
      "settings": [ { "type": "text", "id": "metin", "label": "Metin" } ]
    },
    {
      "type": "metin",
      "name": "Metin",
      "settings": [ { "type": "richtext", "id": "metin", "label": "Metin" } ]
    },
    {
      "type": "kart",
      "name": "Kart (bağlantı)",
      "settings": [
        { "type": "select", "id": "ikon", "label": "Simge", "default": "single", "options": [ { "value": "single", "label": "Single (kilitli halka)" }, { "value": "couple", "label": "Couple (iç içe halkalar)" }, { "value": "nfc", "label": "Çip (NFC)" } ] },
        { "type": "text", "id": "etiket", "label": "Üst etiket" },
        { "type": "text", "id": "baslik", "label": "Başlık" },
        { "type": "inline_richtext", "id": "alt_metin", "label": "Alt metin" },
        { "type": "url", "id": "bag", "label": "Bağlantı", "info": "Temiz adres yazın; ?view= veya preview_theme_id eklemeyin." },
        { "type": "text", "id": "onizleme_view", "label": "Önizleme şablonu (geçici)", "info": "Yalnızca sayfa ?view=kilavuz ile açıldığında linke eklenir. Şablon değişikliğinden sonra silinecek." }
      ]
    },
    {
      "type": "uyari",
      "name": "Bilgi kutusu",
      "settings": [
        { "type": "text", "id": "baslik", "label": "Başlık" },
        { "type": "richtext", "id": "metin", "label": "Metin" }
      ]
    },
    {
      "type": "video",
      "name": "Video",
      "settings": [
        { "type": "text", "id": "video_url", "label": "Video adresi (mp4)", "info": "Shopify'a yüklenmiş videonun cdn.shopify.com adresi." },
        { "type": "text", "id": "baslik", "label": "Erişilebilirlik adı" },
        { "type": "image_picker", "id": "kapak", "label": "Kapak görseli" }
      ]
    }
  ]
}
{% endschema %}
