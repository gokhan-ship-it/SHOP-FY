{%- comment -%}
  TT BELGE LISTESI -- /pages/sozlesmeler

  GemPages'teki "Sozlesmeler" sayfasinin yerine gecen sade liste.
  Sablon: templates/page.sozlesmeler-liste.json. Sayfanin adresi ve
  handle'i ayni kaliyor; yalnizca sablonu degisecek (yayindan sonra).

  Ust kisim bir menuyu listeliyor (sablonda footer-yasal: merkez sayfa +
  7 yasal metin). Menuye eklenen belge burada da gorunur.
  Alttaki "Onceki surumler" bloklari eski PDF'ler icin. PDF'ler Shopify
  Files'ta duruyor ve silinmiyor.

  Tasarim dili (TEXT-TO-NEXT-TASARIM-DILI.md):
  - Genislik ve bolum bosluklari temanin sayfa duzeni (page-width
    --narrow, section--padding); tasarim dilinde ayri deger belirlenmedi.
  - Baslik title-xl 32/700/1.08/-1px; ara baslik title-md 17/700/-0.3px;
    satirlar mobil menu alt linkleri gibi 17px 500 (acik zeminde ink);
    aciklama ve tarih #5C5C57; ayraclar 1px #D2D2CD.
  - Ok: menudeki satir okunun aynisi (10x16, 2px, #5C5C57).
  - Hover yok (tasarim dilinde belirlenmedi).
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign s = section.settings
  assign menu = linklists[s.menu]
-%}

<style>
  #shopify-section-{{ sid }} {
    --section-padding-top: {{ s.padding_top }}px;
    --section-padding-bottom: {{ s.padding_bottom }}px;
  }
  .ttb-{{ sid }} { color: #0a0a0a; }
  .ttb-{{ sid }} h1 {
    margin: 0 0 12px;
    font-family: var(--font-heading-family);
    font-size: 32px;
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -1px;
  }
  /* Buyuk baslik: telefonda title-xl 32px, 768px ve ustunde 40px (17.10.2026 karari). */
  @media screen and (min-width: 768px) { .ttb-{{ sid }} h1 { font-size: 40px; } }
  .ttb-{{ sid }} .ttb-aciklama { margin-bottom: 24px; color: #5c5c57; font-size: 15px; line-height: 1.45; }
  .ttb-{{ sid }} .ttb-aciklama p { margin: 0; }
  .ttb-{{ sid }} ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid #d2d2cd; }
  .ttb-{{ sid }} li { border-bottom: 1px solid #d2d2cd; }
  .ttb-{{ sid }} li a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 56px;
    padding: 8px 0;
    color: #0a0a0a;
    text-decoration: none;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.3;
  }
  .ttb-{{ sid }} li a:focus-visible { outline: 2px solid #0a0a0a; outline-offset: 2px; }
  .ttb-{{ sid }} .ttb-ok { flex: 0 0 auto; color: #5c5c57; }
  .ttb-{{ sid }} h2 {
    margin: 40px 0 8px;
    font-family: var(--font-heading-family);
    font-size: 17px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.3px;
  }
  .ttb-{{ sid }} .ttb-not { margin-bottom: 12px; color: #5c5c57; font-size: 13.5px; line-height: 1.35; }
  .ttb-{{ sid }} .ttb-not p { margin: 0; }
  .ttb-{{ sid }} .ttb-sag { display: inline-flex; align-items: center; gap: 12px; }
  .ttb-{{ sid }} .ttb-tarih { color: #5c5c57; font-size: 13.5px; font-weight: 400; white-space: nowrap; }
</style>

<div class="section section--padding">
  <div class="ttb-{{ sid }} page-width page-width--narrow relative">
    {%- if s.baslik != blank -%}<h1>{{ s.baslik }}</h1>{%- endif -%}
    {%- if s.aciklama != blank -%}<div class="ttb-aciklama">{{ s.aciklama }}</div>{%- endif -%}

    {%- if menu.links.size > 0 -%}
      <ul>
        {%- for link in menu.links -%}
          <li>
            <a href="{{ link.url }}">
              <span>{{ link.title }}</span>
              <svg class="ttb-ok" width="10" height="16" viewBox="0 0 10 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 2l6 6-6 6"/></svg>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      {%- if s.arsiv_baslik != blank -%}<h2>{{ s.arsiv_baslik }}</h2>{%- endif -%}
      {%- if s.arsiv_not != blank -%}<div class="ttb-not">{{ s.arsiv_not }}</div>{%- endif -%}
      <ul>
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <a href="{{ block.settings.bag }}" target="_blank" rel="noopener">
              <span>{{ block.settings.ad }} (PDF)</span>
              <span class="ttb-sag">
                {%- if block.settings.tarih != blank -%}<span class="ttb-tarih">{{ block.settings.tarih }}</span>{%- endif -%}
                <svg class="ttb-ok" width="10" height="16" viewBox="0 0 10 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 2l6 6-6 6"/></svg>
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Belge listesi",
  "tag": "section",
  "class": "tt-belge-listesi",
  "settings": [
    { "type": "text", "id": "baslik", "label": "Başlık", "default": "Sözleşmeler" },
    { "type": "richtext", "id": "aciklama", "label": "Açıklama" },
    { "type": "link_list", "id": "menu", "label": "Belgeler (menü)", "default": "footer" },
    { "type": "text", "id": "arsiv_baslik", "label": "Arşiv başlığı", "default": "Önceki sürümler (arşiv, yürürlükte değildir)" },
    { "type": "richtext", "id": "arsiv_not", "label": "Arşiv notu" },
    { "type": "range", "id": "padding_top", "label": "Üst boşluk", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Alt boşluk", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 120 }
  ],
  "blocks": [
    {
      "type": "pdf",
      "name": "Arşiv PDF",
      "settings": [
        { "type": "text", "id": "ad", "label": "Belge adı" },
        { "type": "url", "id": "bag", "label": "PDF bağlantısı" },
        { "type": "text", "id": "tarih", "label": "Tarih notu" }
      ]
    }
  ]
}
{% endschema %}
