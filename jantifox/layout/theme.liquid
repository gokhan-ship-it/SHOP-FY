<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{% render 'direction' %}">
  <head>
    <meta charset="utf-8">
    {%- comment -%}
      Kişiselleştirme gizli ölçüm modu: yalnızca adreste ?kp_olcum=1 varsa (ya da ölçüm modunda "Kişiselleştir"e basılıp
      ?kisisellestir=1 ile gelindiyse) açılır, oturumun sonraki sayfalarında da açık kalır (?kp_olcum=0 kapatır).
      Normal ziyaretçide adres metnine ve oturum deposuna tek bir bakıştan başka bir şey çalışmaz.
      Açılış süreleri ve gönderilen olaylar (Meta, GA4, temanın Shopify olayları) köşedeki kutuda görünür.
    {%- endcomment -%}
    <script>
      (function () {
        var q = location.search;
        var acik = /[?&]kp_olcum=1/.test(q);
        if (!acik && /[?&]kisisellestir=1/.test(q)) { try { acik = !!sessionStorage.getItem('kp_olcum_tik'); } catch (e) {} }
        // Bir kez açılınca oturum boyunca diğer sayfalarda da açık (sepet, normal ürün); ?kp_olcum=0 kapatır
        try {
          if (/[?&]kp_olcum=0/.test(q)) sessionStorage.removeItem('kp_olcum_acik');
          else if (acik) sessionStorage.setItem('kp_olcum_acik', '1');
          else acik = !!sessionStorage.getItem('kp_olcum_acik');
        } catch (e) {}
        if (!acik) return;
        document.documentElement.classList.add('kp-olcum');
        try { performance.setResourceTimingBufferSize(3000); } catch (e) {}
        var kuyruk = [];
        window.kpOlcum = function (ad) { kuyruk.push([ad, performance.now()]); };
        window.kpOlcum.kuyruk = kuyruk;
        window.kpOlcum.editor = /[?&]kisisellestir=1/.test(q);
        // Sayfanın ilk karesi ve kare akışı: Safari boyamayı bekletirse ilk kare ve kareler arasındaki boşluk bunu gösterir
        var kareler = [];
        window.kpOlcum.kareler = kareler;
        var kare = function (t) { kareler.push(performance.now()); if (kareler.length < 3000) requestAnimationFrame(kare); };
        requestAnimationFrame(kare);
        // Gönderilen olaylar (Meta fbq, GA4 gtag, temanın Shopify olayları): ad, değer, event_id; oturum boyunca saklanır.
        // fbq ve dataLayer.push yalnızca okunur, çağrı aynen geçer.
        var olaylar = [];
        try { olaylar = JSON.parse(sessionStorage.getItem('kp_olcum_olaylar') || '[]'); } catch (e) {}
        window.kpOlcum.olaylar = olaylar;
        window.kpOlcum.olay = function (o) {
          o.z = Date.now();
          o.sayfa = location.pathname;
          olaylar.push(o);
          if (olaylar.length > 80) olaylar.shift();
          try { sessionStorage.setItem('kp_olcum_olaylar', JSON.stringify(olaylar)); } catch (e) {}
          if (window.kpOlcum.olayCiz) window.kpOlcum.olayCiz();
        };
        var kaydet = function (o) { try { window.kpOlcum.olay(o); } catch (e) {} };
        var fbqIcinde = false;
        var fbqSar = function (f) {
          if (!f || f.__kpOlcum) return f;
          var s = function () {
            if (fbqIcinde) return f.apply(this, arguments);
            fbqIcinde = true;
            try {
              var a = arguments, y = a[0], tek = /Single/.test(y) || y === 'trackShopify';
              if (/^track/.test(y)) {
                var v = (tek ? a[3] : a[2]) || {}, sec = (tek ? a[4] : a[3]) || {};
                kaydet({ kanal: 'Meta', ad: tek ? a[2] : a[1], deger: v.value, kimlik: sec.eventID, kaynak: y === 'trackShopify' ? 'F&I uygulaması' : 'tema' });
              }
            } catch (e) {}
            try { return f.apply(this, arguments); } finally { fbqIcinde = false; }
          };
          Object.keys(f).forEach(function (k) { s[k] = f[k]; });
          ['callMethod', 'queue', 'loaded', 'version'].forEach(function (k) { Object.defineProperty(s, k, { get: function () { return f[k]; }, set: function (v) { f[k] = v; } }); });
          s.__kpOlcum = true;
          return s;
        };
        var fbqAsil;
        try { Object.defineProperty(window, 'fbq', { configurable: true, get: function () { return fbqAsil; }, set: function (v) { fbqAsil = fbqSar(v); } }); } catch (e) {}
        // gtag çağrıları dataLayer'a ['event', ad, parametre] olarak düşer. GTM ve gtag push'u kendi işlevleriyle
        // sarar (eskisini saklayıp çağırır): her okuma o anki işlevi bağlar (döngü olmaz), kayıt yalnızca en dıştaki
        // çağrıda yapılır (iç içe sarmalarda tekrar yazılmaz).
        var dl = window.dataLayer = window.dataLayer || [];
        var pushAsil = dl.push;
        var dlIcinde = false;
        try {
          Object.defineProperty(dl, 'push', {
            configurable: true,
            get: function () {
              var hedef = pushAsil;
              return function () {
                if (dlIcinde) return hedef.apply(dl, arguments);
                dlIcinde = true;
                try {
                  for (var i = 0; i < arguments.length; i++) {
                    var x = arguments[i];
                    if (x && x[0] === 'event' && typeof x[1] === 'string') {
                      var p = x[2] || {};
                      kaydet({ kanal: 'GA4', ad: x[1], deger: p.value, kimlik: p.event_id, kaynak: p.shopify_event_name ? 'Google uygulaması' : 'tema', hedef: [].concat(p.send_to || []).join(' ') });
                    }
                  }
                } catch (e) {}
                try { return hedef.apply(dl, arguments); } finally { dlIcinde = false; }
              };
            },
            set: function (v) { pushAsil = v; }
          });
        } catch (e) {}
        var s = document.createElement('script');
        s.src = {{ 'kisisel-olcum.js' | asset_url | json }};
        s.async = true;
        document.head.appendChild(s);
      })();
    </script>
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.settings.body_bg }}">
    <link rel="stylesheet" href="https://use.typekit.net/tmo3swe.css">
    
    <!-- Google Tag Manager -->
<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-THFJHXN6');</script>
<!-- End Google Tag Manager -->
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% else %}
      <meta name="description" content="{{ shop.description | escape }}">
    {% endif %}

    {% render 'preload' %}
    {% render 'meta-tags' %}
    
    {{ content_for_header }}

    {% render 'css-variables' %}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    
    {% render 'scripts-tag' %} 
    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      if (Shopify.designMode) {
        document.documentElement.classList.add('shopify-design-mode');
      }
    </script>
    

    {%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
      {{ 'component-localization-form.css' | asset_url | stylesheet_tag: preload: true }}
      <script src="{{ 'localization-form.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
    {%- if settings.predictive_search_enabled -%}
      <link rel="stylesheet" href="{{ 'component-predictive-search.css' | asset_url }}" media="print" onload="this.media='all'" >
    {%- endif -%}

    {%- comment -%}
      Kişiselleştirme: "Kişiselleştir" ile gelindiyse (?kisisellestir=1) ilk boyamadan itibaren sayfa yerine editörün
      açılış görünümü (önizleme yeri + "Tasarım ekranı hazırlanıyor…"). Editör ve önizleme görseli hazır olunca
      kisisel-editor.js sınıfı kaldırır; JS yüklenemezse 8 saniye sonra kendiliğinden kalkar.
      Ürün sayfası gizlenmez, yalnızca üstü örtülür (opak, tam ekran ::before; editör açılınca editörün kendisi opak ve
      tam ekran): iPhone Safari gövdesi görünmez olan sayfayı, sayfa tamamen yüklenene kadar (load) hiç boyamıyordu.
    {%- endcomment -%}
    {%- if request.page_type == 'product' -%}
      <script>
        if (/[?&]kisisellestir=1/.test(location.search)) {
          document.documentElement.classList.add('kp-acilis-bekle');
          setTimeout(function () { document.documentElement.classList.remove('kp-acilis-bekle'); }, 8000);
          // Üründe kişiselleştirme yoksa (kart yok) beklemeden kalkar
          document.addEventListener('DOMContentLoaded', function () {
            if (!document.querySelector('kisisel-kart')) document.documentElement.classList.remove('kp-acilis-bekle');
          });
        }
      </script>
      <style>
        .kp-acilis-bekle, .kp-acilis-bekle body { overflow: hidden; }
        .kp-acilis-bekle::before { content: ''; position: fixed; z-index: 2147483000; inset: 0; background: #fff linear-gradient(#efefef, #efefef) no-repeat 50% 12px; background-size: calc(100% - 24px) 45vh; background-size: min(860px, calc(100% - 24px)) 45dvh; }
        .kp-acilis-bekle::after { content: 'Tasarım ekranı hazırlanıyor…'; position: fixed; z-index: 2147483000; left: 0; right: 0; top: calc(45vh + 32px); top: calc(45dvh + 32px); text-align: center; font: 14px/1.4 -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; color: #6b6b6b; }
        @media (prefers-reduced-motion: no-preference) { .kp-acilis-bekle::after { animation: kp-acilis-nabiz 1.1s ease-in-out infinite alternate; } }
        @keyframes kp-acilis-nabiz { from { opacity: 1; } to { opacity: 0.45; } }
        @media (min-width: 1024px) { .kp-acilis-bekle::before { background-size: min(860px, calc(100% - 24px)) calc(100vh - 230px); } .kp-acilis-bekle::after { top: calc(100vh - 190px); } }
      </style>
    {%- endif -%}
  </head>

  <body class="template-{{ template | replace: '.', '-' | handle }} type-anim-{{ settings.animations_style }}">
    <!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-THFJHXN6"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->
    <a class="skip-to-content-link button visually-hidden" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>
    {%- if settings.show_page_transition and request.design_mode == false -%}
    <div class="loading-screen">
        <div class="loading-bar"></div>
    </div>
    {%- endif-%}
    {%- if settings.cart_type == 'drawer' and template != 'cart' -%}
      {%- render 'cart-drawer' -%}
    {%- endif -%}
    {%- render 'block-search' -%}
    
    {%- sections 'header-group' -%}
    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
    {%- sections 'footer-group' -%}
    {%- sections 'overlay-group' -%}
    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
    </ul>
    
    {% render 'js-variables' %}
    {% render 'product-quick-view' %}
    {% if settings.show_scroll_to_top %}
      {% render 'scroll-to-top' %}
    {% endif %}
    {%- if settings.predictive_search_enabled -%}
      <script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
    {%- if settings.show_free_shipping_bar -%}
      <link rel="stylesheet" href="{{ 'free-shipping.css' | asset_url }}" media="print" onload="this.media='all'">
      <script src="{{ 'free-shipping.js' | asset_url }}" defer="defer"></script> 
    {%- endif -%}
    {%- if settings.show_page_transition and request.design_mode == false -%}
    <script>
     (function() {
        var loaded = false;
        var domReady = false;

        function hideLoading() {
            if (loaded && domReady) {
                document.body.classList.add('loaded');
            }
        }
        window.addEventListener('load', function() {
            loaded = true;
            hideLoading();
        });
        document.addEventListener('DOMContentLoaded', function() {
            domReady = true;
            hideLoading();
        });

        setTimeout(function() {
            if (!loaded) {
                loaded = true;
                hideLoading();
            }
        }, 2000);
    })();
    </script>
   {%- endif -%}


   <!-- Bundle Modal -->
   {%- if request.page_type == "collection" or request.page_type == "product" and product.handle != "janti-setini-olustur" -%}
      {%- render "discount-modal" -%}
   {%- endif -%}
   
   <!-- Coupon Modal -->
   {%- render "coupon-modal" -%}
    
   {% comment %}
   <!-- Campaign Modal -->
   {%- if request.page_type == "collection" or request.page_type == "product" -%}
   {%- render "campaign-modal" -%}
   {%- endif -%}
    {% endcomment %}
   <!-- WhatsApp Sticky Button -->
   {%- render "whatsapp-sticky" -%}
   {% render 'jantifox-shipping-popup' %}
   {%- render 'jfclub-popup' -%}
   {%- render 'kisisel-sepet' -%}
   {%- if request.page_type == 'collection' -%}{%- render 'kisisel-koleksiyon' -%}{%- endif -%}
  </body>
</html>
