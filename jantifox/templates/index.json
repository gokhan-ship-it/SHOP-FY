    "j_ftestimonials_79zdKD": {
      "type": "JFtestimonials",
      "blocks": {
        "review_Jht7aw": {
          "type": "review",
          "settings": {
            "star_count": 5,
            "title": "",
            "text": "Herkesin tek tipe dönüştüğü bu dünyayı Janti’yle en cool, en kişisel ve en eğlenceli hale döndürebildiğimiz için çok şanslıyız🤟🏻 Janti ailesinden biri olabilmek benim için çok özel iyi ki varsınız Janti fam❤️",
            "customer_name": "Didem B.",
            "product_link": ""
          }
        },
        "review_Ui7hJR": {
          "type": "review",
          "settings": {
            "star_count": 5,
            "title": "",
            "text": "Uzun süredir aradığım birçok eşyamı koyabileceğim kanvas çanta ihtiyacıma JantiFox sayesinde ulaştım. Üstelik kişiselleştirme yaparak çok tatlı patchler aldımmm , teşekkür ederim♥️",
            "customer_name": "Deniz A.",
            "product_link": ""
          }
        },
        "review_NAdgCX": {
          "type": "review",
          "settings": {
            "star_count": 5,
            "title": "",
            "text": "Çantam elime ulaştı. Bu kadar hızlı teslimat beklemiyordum. Kalitesi de beni hiç şaşırtmadı, teşekkür ederim. Ancak nacizane bir önerim olacak: Kol askıları biraz daha uzun, omza asılabilecek boyutta olsa müthiş olurdu 🙏 Diğer modelinizden de alacağım. Böyle bir kaliteyi herkesin görmesini isterim.",
            "customer_name": "Esra S.",
            "product_link": ""
          }
        },
        "review_EjPL6b": {
          "type": "review",
          "settings": {
            "star_count": 4,
            "title": "",
            "text": "Jantifox’la ilk tanışmamız kızım için aldığım tişört ve plaj çantası ile oldu.  Markanın en sevdiğim tarafı, ürünlerin üzerine yapıştırılan patchlerle çocuğun kendi stilini yaratabilmesi. Kızım her gün patchleri değiştirerek farklı bir şey giyiyor gibi hissediyor; çantasını ve tişörtünü sürekli yeniden tasarlıyor. Bu da giyinmeyi eğlenceli ve yaratıcı bir oyun alanına dönüştürüyor.",
            "customer_name": "Nur T.",
            "product_link": ""
          }
        },
        "review_7cgphA": {
          "type": "review",
          "settings": {
            "star_count": 5,
            "title": "",
            "text": "Jantifox’tan aldığımız ürünlerden çok memnun kaldık. Çocuklarım kendi hobilerine ve ilgi alanlarına uygun patch’leri seçerek ürünlerini tamamen kişiselleştirebildiler. Bu süreç onlar için çok eğlenceliydi; ortaya çıkan ürünlerin kalitesi ise beklentilerimizin üzerindeydi. Hem çocukların yaratıcılığını destekleyen hem de kaliteli ürünler sunan harika bir marka.”",
            "customer_name": "Deniz Ö.",
            "product_link": ""
          }
        },
        "review_3W6fD7": {
          "type": "review",
          "settings": {
            "star_count": 5,
            "title": "",
            "text": "Benim favorim çanta oldu, her yere onunla gidiyorum artık.",
            "customer_name": "Arya S.",
            "product_link": ""
          }
        },
        "review_cdCjnD": {
          "type": "review",
          "settings": {
            "star_count": 5,
            "title": "",
            "text": "Kızıma sırt çantası alırken kendime de tote bag aldım, sanırım tüm yazı bununla geçireceğim.",
            "customer_name": "Sevda S.",
            "product_link": ""
          }
        },
        "review_Bc7YEr": {
          "type": "review",
          "settings": {
            "star_count": 5,
            "title": "",
            "text": "Anne-kız aynı şapka ve çantalarla dolaşmak çok hoşumuza gidiyor.",
            "customer_name": "Ümit K.",
            "product_link": ""
          }
        },
        "review_mXhwGe": {
          "type": "review",
          "settings": {
            "star_count": 5,
            "title": "",
            "text": "Sanırım bu sene aldığım en güzel hediye bu tişört ve şapka",
            "customer_name": "Yasemin B.",
            "product_link": ""
          }
        },
        "review_UiLDj3": {
          "type": "review",
          "settings": {
            "star_count": 5,
            "title": "",
            "text": "Artık çocuklara ne hadiye alsam diye düşünmüyorum. Jantifox’dan hem yaratıcı hem herkeste olmayan hem de çocukların çok seveceği bir hediye alıyorum",
            "customer_name": "Seda D.",
            "product_link": ""
          }
        },
        "review_nqTaL4": {
          "type": "review",
          "settings": {
            "star_count": 5,
            "title": "",
            "text": "Patch’lerle kendi tarzımı yansıtabilmek harika. Bunun yanında ürünler de beklentimin üzerinde, kesinlikle tekrar tercih ederim.",
            "customer_name": "Özlem S.",
            "product_link": ""
          }
        },
        "review_UtKqrF": {
          "type": "review",
          "settings": {
            "star_count": 5,
            "title": "",
            "text": "Kaliteli ürünler, özgün tasarımlar ve çok keyifli bir kişiselleştirme deneyimi. Çocuklar için alayım derken kendimi olayın içinde bulmam ise harika :)",
            "customer_name": "Zeynep T.",
