{%- comment -%}
  Sepette kişiselleştirilmiş tasarım kalemlerini gruplar (sepet çekmecesi ve sepet sayfası).
  layout/theme.liquid içinden, </body> öncesinde render edilir:
  {% render 'kisisel-sepet' %}
{%- endcomment -%}
<style>
  .cart-item.kp-sepet-baz { position: relative; }
  .cart-item.kp-sepet-patch { position: relative; margin-left: 1.6rem; padding-left: 1.2rem; border-left: 2px solid #d9d9d9; }
  .cart-item.kp-sepet-patch .cart-item__media { max-width: 56px; }
  .cart-item.kp-sepet-patch quantity-input { display: none !important; }
  tr.cart-item.kp-sepet-patch > td:first-child { box-shadow: inset 2px 0 0 #d9d9d9; }
  .kp-sepet-rozet { display: inline-block; margin-bottom: .4rem; padding: .2rem .8rem; border-radius: 999px; background: #111; color: #fff; font-size: 1.1rem; font-weight: 600; letter-spacing: .02em; }
  html.kp-sepet-mesgul .cart-item[data-kp-tasarim] { opacity: .5; pointer-events: none; }
  .cart-item.kp-sepet-gizli, .cart-item .kp-sepet-gizli { display: none !important; }
  .cart-item.kp-sepet-baz dl { display: none !important; }
  /* Aksesuar: çanta tasarım grubunun içinde alt grup, "+ Kalem Kutusu Kırmızı ve tasarımı" */
  .cart-item.kp-sepet-aksesuar { position: relative; margin-left: 1.6rem; padding-left: 1.2rem; border-left: 2px solid #d9d9d9; }
  .cart-item.kp-sepet-aksesuar .cart-item__media { max-width: 64px; }
  .cart-item.kp-sepet-aksesuar quantity-input, .cart-item.kp-sepet-aksesuar dl, .cart-item.kp-sepet-aksesuar .cart-item__name { display: none !important; }
  .kp-sepet-aks { margin: 0 0 0.2rem; font-weight: 600; font-size: 1.4rem; }
  .cart-item.kp-sepet-baz .cart-item__details > .cart-item__discounted-prices,
  .cart-item.kp-sepet-baz .cart-item__details > .product-option.mt-1,
  .cart-item.kp-sepet-baz .cart-item__details > .discounts { display: none !important; }
  .kp-sepet-icerik { margin: .2rem 0 0; font-size: 1.3rem; font-weight: 600; line-height: 1.35; overflow-wrap: anywhere; }
  .kp-sepet-ac { margin-top: .4rem; padding: .3rem 1rem; border: 1px solid #d9d9d9; border-radius: 999px; background: #fff; color: #111; font: inherit; font-size: 1.2rem; font-weight: 600; cursor: pointer; }
  .cart-item__media.kp-sepet-cizildi { position: relative; }
  .cart-item__media.kp-sepet-cizildi > *:not(.kp-sepet-mini) { display: none !important; }
  .kp-sepet-mini { position: relative; width: 100%; overflow: hidden; border-radius: 6px; background: #fff; }
  .kp-sepet-mini__sahne { position: absolute; }
  .kp-sepet-mini__urun { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .kp-sepet-mini__parca { position: absolute; object-fit: contain; }
  .kp-sepet-mini__parca--daire { border-radius: 50%; }
  .kp-sepet-mini__parca--jpg { background: #fff; }
</style>
<script src="{{ 'kisisel-sepet.js' | asset_url }}" defer="defer"></script>
