{%- comment -%} Text To Next PRO - ince cizgili ikon seti. icon: qr|selfie|phone|text|calendar|image|logo|clock|check {%- endcomment -%}
<svg class="pro-icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
  {%- case icon -%}
    {%- when 'qr' -%}
      <rect x="3.5" y="3.5" width="6" height="6" rx="1"/><rect x="14.5" y="3.5" width="6" height="6" rx="1"/><rect x="3.5" y="14.5" width="6" height="6" rx="1"/><path d="M14.5 14.5h2.5v2.5M20.5 14.5v.01M14.5 20.5h.01M17.5 20.5h3v-3"/>
