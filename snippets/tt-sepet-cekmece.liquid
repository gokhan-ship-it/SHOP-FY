{%- comment -%}
  SEPET: /cart SAYFASINA GITMEK YOK, HEP CEKMECE ACILSIN

  ------------------------------------------------------------------
  ISTEK

  "Sepet sayfasina hic yonlendirmesin, hep alttan sepeti acsin."

  ------------------------------------------------------------------
  ONCEKI SURUM VE NEDEN YETMEDI

  Ilk surum yalnizca aria-controls="CartDrawer" tasiyan ogeleri
  yakaliyordu. Temanin header ikonu bunu tasiyor
  (snippets/header-icons.liquid):

      <a href="{{ routes.cart_url }}" class="cart-drawer-button"
         is="magnet-link" aria-controls="CartDrawer" ...>

  Buna ragmen ikon hala /cart'a goturuyordu. Magazada header'i
  yeniden yazan uygulama gomulusu var; oge degistirildiginde ya da
  sarmalandiginda aria-controls kaybolabiliyor, o zaman eski surum
  hicbir sey yapmayip baglantiyi serbest birakiyordu.

  Bu yuzden artik TEK bir isarete bagli degiliz. Iki olcutten biri
  yeterli:

    1. aria-controls="CartDrawer" tasiyan herhangi bir oge, ya da
    2. adresi sepet sayfasi olan herhangi bir <a>

  Ikincisi istegin birebir karsiligi: sepet sayfasina goturen ne
  varsa cekmeceyi aciyor.

  ------------------------------------------------------------------
  SINIRLAR -- NELERE DOKUNULMUYOR

  - /cart/add, /cart/change, /cart/clear, /cart/checkout gibi ISLEM
    adresleri: yalnizca yol tam olarak /cart (ya da /tr/cart gibi dil
    onekli hali) ise yakalaniyor.
  - Baska alan adina giden baglantilar.
  - target ile yeni sekmede acilanlar, indirme baglantilari.
  - Ctrl/Cmd/Shift/Alt ile ya da orta tusla tiklama: tarayicinin
    kendi davranisi korunuyor.
  - Cekmece DOM'da yoksa (sepet sayfasinin kendisi, ya da
    settings.cart_type "drawer" degilse) hicbir sey yapilmiyor,
    baglanti kendi href'ine gidiyor. JS kapaliysa da ayni.

  ------------------------------------------------------------------
  NASIL

  Dinleyici dugume degil BELGEYE, yakalama evresinde takili. Boylece
  dugme kac kez degistirilirse degistirilsin tiklama yakalaniyor.
  Temanin kendi dinleyicisi hala duruyorsa cift tetikleme olmasin
  diye stopPropagation cagriliyor.

  Yapilan is temanin yaptiginin aynisi -- ayni ogenin ayni metotlari:

      onButtonClick(event) {
        event.preventDefault();
        this.open ? this.hide() : this.show(event.currentTarget);
      }

  Kapatma yalnizca temanin kendi toggle'lari icin (aria-controls
  tasiyanlar). Duz bir sepet baglantisi her zaman ACAR, kapatmaz --
  yoksa cekmece acikken icindeki bir sepet baglantisina basmak onu
  kapatirdi.

  YUKSELTME BEKLENIYOR: ozel oge tanimlanmadan once tiklanirsa
  cekmecenin show/hide metotlari henuz yoktur. 2 saniyeye kadar 50ms
  araliklarla bekleniyor; o sure icinde hazir olmazsa sepet sayfasina
  gidiliyor.

  Cekmece once kimlikle (#CartDrawer), bulunamazsa etiket adiyla
  (<cart-drawer>) araniyor -- kimlik bir tema guncellemesinde
  degisirse davranis yine ayakta kalsin diye.

  sections/header.liquid, snippets/header-icons.liquid ve
  sections/cart-drawer.liquid dosyalarina DOKUNULMADI.
{%- endcomment -%}
<script>
  (function () {
    'use strict';

    var YEDEK = {{ routes.cart_url | json }};

    function cekmeceyiBul() {
      return document.getElementById('CartDrawer') ||
             document.querySelector('cart-drawer');
    }

    /* Yol tam olarak sepet sayfasi mi? /cart, /cart/ ve /tr/cart gibi
       dil onekli haller evet; /cart/add gibi islem adresleri hayir. */
    function sepetAdresiMi(a) {
      if (a.hasAttribute('download')) return false;
      var hedefPencere = a.getAttribute('target');
      if (hedefPencere && hedefPencere !== '_self') return false;
      var u;
      try { u = new URL(a.href, location.href); } catch (e) { return false; }
      if (u.origin !== location.origin) return false;
      return /(^|\/)cart\/?$/.test(u.pathname);
    }

    function tetikleyiciBul(hedef) {
      if (!hedef || !hedef.closest) return null;
      var d = hedef.closest('[aria-controls="CartDrawer"]');
      if (d) return d;
      var a = hedef.closest('a[href]');
      if (a && sepetAdresiMi(a)) return a;
      return null;
    }

    document.addEventListener('click', function (e) {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      if (e.button !== 0) return;

      var dugme = tetikleyiciBul(e.target);
      if (!dugme) return;

      var cekmece = cekmeceyiBul();
      if (!cekmece) return;

      e.preventDefault();
      e.stopPropagation();

      var kapatabilir = dugme.hasAttribute('aria-controls');
      var deneme = 0;

      (function ac() {
        if (typeof cekmece.show === 'function') {
          if (kapatabilir && cekmece.hasAttribute('open')) cekmece.hide();
          else cekmece.show(dugme);
          return;
        }
        if (deneme++ > 40) {
          window.location.href = dugme.getAttribute('href') || YEDEK;
          return;
        }
        window.setTimeout(ac, 50);
      })();
    }, true);
  })();
</script>
