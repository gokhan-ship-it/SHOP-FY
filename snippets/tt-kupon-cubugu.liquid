{%- comment -%}
  CARK KUPON CUBUGU: HEADER'IN ALTINA OTURSUN

  ------------------------------------------------------------------
  DURUM

  Cark uygulamasi (Wheelio) kod alindiktan sonra ekrana tam genislikte
  bir serit basiyor: kupon kodu + kalan sure + kapatma. Uygulamanin
  ayarinda bu seridin yeri yalnizca UST ya da ALT olabiliyor ve ikisi
  de bir seyi kapatiyor:

    ust  -> temanin header'ini kapatiyor
    alt  -> urun sayfasindaki "Sepete ekle" dugmesini kapatiyor

  Istenen yer ikisinin arasi: header'in hemen ALTI.

  ------------------------------------------------------------------
  KOD YOKKEN DOKUNMUYORUZ  (onemli)

  Uygulama seridi DOM'da her zaman tutuyor; kod yokken ekranin
  disinda bekletiyor ve icinde doldurulmamis sablon duruyor
  ("KALAN SÜRE: dd hh mm ss", bos kod kutusu).

  Bu dosyanin ilk surumu top degerini kosulsuz eziyordu ve o bos
  iskeleti de gorunur hale getiriyordu. Artik once AKTIF BIR KOD VAR
  MI diye bakiliyor; yoksa kendi eklediklerimiz geri alinip serit
  uygulamanin kendi bicimine birakiliyor.

  Aktiflik olcutu, katmanin geri kalaniyla AYNI kaynaktan: carkin
  yazdigi uc cerez. Ikinci bir dogruluk kaynagi uretilmedi.
  Serit metnini okuyup "dd hh mm ss" mi diye bakmak da mumkundu ama
  o dile ve uygulamanin sablonuna bagimli olurdu.

  ------------------------------------------------------------------
  NASIL

  1. Aday havuzu yalnizca "wlo" gecen ogeler. Bu sinir bilincli --
     boylece yanlislikla baska bir sabit ogeyi (sohbet balonu, cerez
     uyarisi, bizim yapiskan cubugumuz) oynatma ihtimali yok. Cark
     uygulamasinin butun ogeleri wlo onekli; cerez adlari da oyle.

  2. Adaylar arasindan SERIT olani seciliyor: position fixed, ekran
     genisliginin en az %60'i kadar genis, 160px'den kisa. Carkin
     kendi penceresi bu olcuye uymuyor, disarida kaliyor.

  3. Ustteki tema kabugunun alt kenari olculuyor (header ya da bizim
     yapiskan urun cubugumuz -- hangisi gorunuyorsa). Serit oraya
     sabitleniyor: top = o deger, bottom = auto.

  Serit bulunamazsa hicbir sey yapilmiyor. Uygulama seridin adini
  degistirirse ya da kaldirirsa kural bosa duser, sayfa aynen kalir.

  Olcum tek seferlik degil: serit sayfa acildiktan sonra enjekte
  ediliyor, kodun suresi sayfa aciktayken dolabiliyor, ekran donunce
  header'in yuksekligi degisiyor. Bu yuzden dusuk maliyetli bir
  zamanlayici ve DOM gozlemcisi ile surekli tazeleniyor.

  KAPSAM: butun sayfalar. Serit her sayfada cikabildigi icin tek bir
  sablona baglanmadi. Kapisi layout/theme.liquid icinde.
{%- endcomment -%}
<script>
  (function () {
    'use strict';

    var C_KOD   = {{ settings.tt_cerez_kod | json }};
    var C_SURE  = {{ settings.tt_cerez_sure | json }};
    var C_ZAMAN = {{ settings.tt_cerez_zaman | json }};

    /* Ustte durabilecek butun kabuk ogeleri. Hangisi o sayfada
       gorunuyorsa onun alt kenari olculuyor; gorunmeyenler
       ustYukseklik() icinde eleniyor.

       [data-tth-kok] yeni baslik cubugu (sections/tt-baslik.liquid).
       [data-aln-kok] onun yerini aldigi eski cubuk; hala listede,
       cunku eski cubugun acik oldugu bir sayfa kalirsa orada da
       dogru calissin. */
    var UST_KABUK = [
      '[data-tth-kok]',
      "header[is='sticky-header']",
      '[data-aln-kok]',
      '[id$="__header"]',
      '#shopify-section-header'
    ];

    function cerez(ad) {
      if (!ad) return '';
      var hepsi = String(document.cookie || '').split(';');
      for (var i = 0; i < hepsi.length; i++) {
        var c = hepsi[i].trim();
        var esit = c.indexOf('=');
        if (esit < 0) continue;
        if (c.slice(0, esit) !== ad) continue;
        try { return decodeURIComponent(c.slice(esit + 1)); }
        catch (e) { return c.slice(esit + 1); }
      }
      return '';
    }

    /* Carkin verdigi kod duruyor ve suresi dolmamis mi? */
    function kodAktif() {
      var kod = cerez(C_KOD);
      if (!kod) return false;
      var sure = parseFloat(cerez(C_SURE));
      var basla = parseFloat(cerez(C_ZAMAN));
      if (!isFinite(sure) || !isFinite(basla)) return false;
      return basla + sure * 1000 > Date.now();
    }

    function gorunur(el) {
      var s = window.getComputedStyle(el);
      return s.display !== 'none' && s.visibility !== 'hidden' && parseFloat(s.opacity || '1') > 0;
    }

    /* Ust kenara yapisik, gorunur kabuk ogelerinin en alt kenari. */
    function ustYukseklik() {
      var en = 0;
      for (var i = 0; i < UST_KABUK.length; i++) {
        var el = document.querySelector(UST_KABUK[i]);
        if (!el || !gorunur(el)) continue;
        var r = el.getBoundingClientRect();
        if (r.height <= 0) continue;
        if (r.top > 8) continue;
        if (r.bottom > en) en = r.bottom;
      }
      return Math.max(0, Math.round(en));
    }

    var bellek = null;

    function seridiBul() {
      if (bellek && bellek.isConnected) return bellek;
      bellek = null;
      var adaylar = document.querySelectorAll('[id*="wlo" i], [class*="wlo" i]');
      for (var i = 0; i < adaylar.length; i++) {
        var el = adaylar[i];
        if (window.getComputedStyle(el).position !== 'fixed') continue;
        var r = el.getBoundingClientRect();
        if (r.height <= 0 || r.height > 160) continue;
        if (r.width < window.innerWidth * 0.6) continue;
        bellek = el;
        return el;
      }
      return null;
    }

    var uygulandi = false;

    function birak(serit) {
      if (!uygulandi) return;
      serit.style.removeProperty('top');
      serit.style.removeProperty('bottom');
      uygulandi = false;
    }

    function yerlestir() {
      var serit = seridiBul();
      if (!serit) return;

      if (!kodAktif()) { birak(serit); return; }

      var y = ustYukseklik() + 'px';
      if (uygulandi && serit.style.top === y) return;
      serit.style.setProperty('top', y, 'important');
      serit.style.setProperty('bottom', 'auto', 'important');
      uygulandi = true;
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', yerlestir);
    } else {
      yerlestir();
    }

    window.setInterval(yerlestir, 1000);
    window.addEventListener('resize', yerlestir);
    window.addEventListener('orientationchange', yerlestir);

    if (window.MutationObserver) {
      var bekleyen = false;
      new MutationObserver(function () {
        if (bekleyen) return;
        bekleyen = true;
        window.setTimeout(function () { bekleyen = false; yerlestir(); }, 200);
      }).observe(document.body, { childList: true, subtree: true });
    }
  })();
</script>
