{%- doc -%}
  SECIM KARTLARI BOLUMU -- CIZGI IKONLARI

  Ikonlar currentColor ile ciziliyor: kartin rengi degisince
  (beyaz kart / secili koyu kart) kendiliginden dogru renge
  donuyorlar, ek kurala gerek kalmiyor.

  Halkalar SVG DEGIL, CSS ile ciziliyor (bkz. .tt-sc-halkalar):
  ikinci halkanin yesili ve -5px binmesi ayardan geliyor.

  Set kutusunun ikonlari (bilgi, arti, tik) `sinif` parametresiyle
  ek sinif alabiliyor: bos/dolu slotta hangisinin gorunecegi CSS'te
  seciliyor, JS ikon uretmiyor.

  @param {string} ad - takvim | kilit-acik | kisi | kisiler | bilgi | arti | tik
  @param {string} [sinif] - svg'ye eklenecek ek sinif
{%- enddoc -%}
{%- case ad -%}
  {%- when 'takvim' -%}
    <svg class="tt-sc-ikon{% if sinif %} {{ sinif }}{% endif %}" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
         aria-hidden="true" focusable="false">
      <rect x="3.5" y="5.5" width="17" height="15" rx="2.5"/>
      <path d="M8 3.2v4.2M16 3.2v4.2M3.5 10.2h17"/>
      <circle cx="12" cy="15" r="1.5" fill="currentColor" stroke="none"/>
    </svg>
  {%- when 'kilit-acik' -%}
    <svg class="tt-sc-ikon{% if sinif %} {{ sinif }}{% endif %}" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
         aria-hidden="true" focusable="false">
      <rect x="3.5" y="11" width="12" height="9" rx="2"/>
      <path d="M8 11V7.6a4 4 0 0 1 8 0V9.2"/>
    </svg>
  {%- when 'kisi' -%}
    <svg class="tt-sc-ikon{% if sinif %} {{ sinif }}{% endif %}" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
         aria-hidden="true" focusable="false">
      <circle cx="12" cy="8" r="3.4"/>
      <path d="M5.5 20c0-3.3 2.9-5.6 6.5-5.6s6.5 2.3 6.5 5.6"/>
    </svg>
  {%- when 'kisiler' -%}
    <svg class="tt-sc-ikon{% if sinif %} {{ sinif }}{% endif %}" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
         aria-hidden="true" focusable="false">
      <circle cx="9" cy="8" r="3.1"/>
      <path d="M3 20c0-3.1 2.7-5.2 6-5.2s6 2.1 6 5.2"/>
      <path d="M16.2 5.3a3.1 3.1 0 0 1 0 5.5"/>
      <path d="M17.6 14.9c2.1.5 3.6 2.2 3.6 4.4"/>
    </svg>
  {%- when 'bilgi' -%}
    <svg class="tt-sc-ikon{% if sinif %} {{ sinif }}{% endif %}" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
         aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="9"/>
      <path d="M12 11v5.5"/>
      <circle cx="12" cy="7.8" r="1.05" fill="currentColor" stroke="none"/>
    </svg>
  {%- when 'arti' -%}
    <svg class="tt-sc-ikon{% if sinif %} {{ sinif }}{% endif %}" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
         aria-hidden="true" focusable="false">
      <path d="M12 5.5v13M5.5 12h13"/>
    </svg>
  {%- when 'tik' -%}
    <svg class="tt-sc-ikon{% if sinif %} {{ sinif }}{% endif %}" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"
         aria-hidden="true" focusable="false">
      <path d="M4.8 12.6l4.6 4.6L19.2 7.4"/>
    </svg>
{%- endcase -%}
