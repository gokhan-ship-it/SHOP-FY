{%- comment -%}
  tt-tasarim-dili — Redesign 2026-10 tasarim dili katmani (yalnizca CSS).
  layout/theme.liquid icinde </head> oncesinde tek satirla cagrilir.
  Geri almak icin o render satirini silmek yeterlidir.
  Liquid mantigina, JS'e, class/id/data- ozniteliklerine dokunmaz.
{%- endcomment -%}
<style id="tt-tasarim-dili">
/* ==========================================================================
   ADIM 1 — Tasarım token'ları (Leica paleti)
   Kural: transition, transform, animation, opacity, position, top/left/right/
   bottom, display, visibility, z-index, overflow bu dosyada HİÇ kullanılmaz.
   Kurallardaki önek  html:not(#ttd):not(#ttd-2) body  iki ID değerinde
   özgüllük sağlar; section stillerindeki tek ID'li kuralları !important
   olmadan ezer. Hiçbir öğenin id'si değişmez (#ttd diye bir öğe yoktur).
   ========================================================================== */
:root {
  /* Renkler */
  --ttd-sayfa: #FFFFFF;
  --ttd-yumusak: #F2F2F2;
  --ttd-kart: #FFFFFF;
  --ttd-murekkep: #111111;
  --ttd-soluk: #6B6B6B;
  --ttd-cizgi: #E5E5E5;
  --ttd-vurgu: #E20612;
  --ttd-koyu: #111111;
  --ttd-koyu-kart: #1E1E1E;
  --ttd-koyu-cizgi: #2E2E2E;
  --ttd-koyu-soluk: #A8A8A8;
  --ttd-koyu-metin: #F5F5F7;

  /* Köşeler */
  --ttd-r-kart: 20px;
  --ttd-r-kucuk: 16px;
  --ttd-r-gorsel: 12px;
  --ttd-r-hap: 999px;

  /* Boşluk: 390px'te mobil, 1440px'te masaüstü değerine akışkan geçiş */
  --ttd-bolum: clamp(96px, calc(72.23px + 6.095vw), 160px);
  --ttd-kenar: 16px;

  /* Tipografi ölçeği (mobil 390px → masaüstü 1440px) */
  --ttd-f-aile: Inter, sans-serif;
  --ttd-f-h1: clamp(34px, calc(22.86px + 2.857vw), 64px);
  --ttd-f-h2: clamp(28px, calc(20.57px + 1.905vw), 48px);
  --ttd-f-h3: clamp(20px, calc(18.51px + 0.381vw), 24px);
  --ttd-f-govde: clamp(17px, calc(16.26px + 0.1905vw), 19px);
  --ttd-f-kucuk: 13px;

  /* Butonlar */
  --ttd-btn-yuk: 48px;
  --ttd-btn-yuk-buyuk: 52px;
  --ttd-btn-pad: 24px;
}

/* ==========================================================================
   ADIM 2 — Tipografi
   Tek aile Inter; yalnızca 400 ve 500 (tema Inter n4/n5'i zaten yüklüyor).
   Ölçek 390px'te mobil, 1440px'te masaüstü değerine akışkan geçer.
   ui-monospace (couple-bulusma, taksit-tablosu) bilinçli öğe: dokunulmaz.
   ========================================================================== */

/* --- Tema geneli: başlık ağırlığı 500 (type_header_font inter_n7 görünürde 500) */
:root {
  --font-heading-weight: 500;
  --font-navigation-weight: 500;
  --font-button-weight: 500;
  --font-product-weight: 500;
}

/* --- tt-couple / tt-tekli token katmanı: 600 kalkar, ölçek yeni sisteme eşitlenir */
html:not(#ttd):not(#ttd-2) body #MainContent.tt-couple-page,
html:not(#ttd):not(#ttd-2) body #MainContent.tt-tekli-page {
  --tt-f-h1-size: var(--ttd-f-h1);
  --tt-f-h1-w: 500;
  --tt-f-h1-lh: 1.1;
  --tt-f-h1-ls: -0.035em;
  --tt-f-h2-size: var(--ttd-f-h2);
  --tt-f-h2-w: 500;
  --tt-f-h2-lh: 1.15;
  --tt-f-h2-ls: -0.03em;
  --tt-f-h3-size: var(--ttd-f-h3);
  --tt-f-h3-w: 500;
  --tt-f-h3-lh: 1.25;
  --tt-f-h3-ls: -0.015em;
  --tt-f-body-size: var(--ttd-f-govde);
  --tt-f-body-w: 400;
  --tt-f-body-lh: 1.5;
  --tt-f-body-lg-size: var(--ttd-f-govde);
  --tt-f-body-lg-w: 500;
  --tt-f-body-lg-lh: 1.5;
  --tt-f-body-sm-size: 15px;
  --tt-f-body-sm-w: 400;
  --tt-f-eyebrow-size: var(--ttd-f-kucuk);
  --tt-f-eyebrow-w: 500;
  --tt-f-eyebrow-lh: 1.4;
  --tt-f-eyebrow-ls: 0;
  --tt-f-caption-size: var(--ttd-f-kucuk);
  --tt-f-caption-lh: 1.4;
}

/* --- Ağırlık: başlıklar, kalın metinler ve 600/700 kullanan tüm özel sınıflar 500 */
html:not(#ttd):not(#ttd-2) body :is(h1, h2, h3, h4, h5, h6, b, strong, dt, th, legend, .heading,
  .hv-title, .hv-stat, .hv-tk,
  .gh-bas, .gh-vurgu, .gh-puan, .gh-celenk-yazi, .gh-puan *,
  .ay-vurgu, .ay-kbas, .ay-etiket, .ay-bas-metin,
  .cb-bas-yazi, .cb-bas-satir, .cb-kim-ad, .cb-sonuc-bas, .cb-buton,
  .as-bas, .as-kart-bas, .as-etiket,
  .tt-veri-baslik, .tt-veri-oran, .tt-veri-etiket,
  .ak-bas, .ak-kart-bas, .ak-pop-bas, .ak-pop-etiket,
  .ho-head, .ho-okuma, .ho-ad, .ho-ipucu, .ho-durum, .ho-final,
  .vs-head, .vs-card-title, .vs-cta,
  .mk-head, .mk-ust, .mk-isim, .mk-isim *, .mk-pop-baslik, .mk-secim-baslik, .mk-cta,
  .tt-cs-baslik, .tt-cs-rozet, .tt-cs-sira, .tt-cs-sira *,
  .tth-sayi, .tth-menu a,
  [class*="tth-cta-"], [class*="tth-btn-"], [class*="tth-sayi-"], [class*="tth-menu-"] a,
  [class*="tt-catal-title-"], [class*="tt-catal-pill-"], [class*="tt-catal-name-"],
  [class*="ai-comparison-title"], [class*="ai-comparison-category"], [class*="ai-comparison-product-title"],
  [class*="ttn-hiw-heading"], [class*="ttn-hiw-title"], [class*="ttn-hiw-step-number"],
  [class*="ai-how-it-works-heading"], [class*="ai-how-it-works-card-title"], [class*="ai-how-it-works-badge"],
  [class*="ai-hero-heading"], [class*="ai-category-card-title"],
  [class*="fh-title-"], [class*="fh-heading-"] :is(b, strong), [class*="ac-heading-"] :is(b, strong),
  [class*="dcb-pop-title-"], [class*="ugc-gallery-heading-"], [class*="ugc-gallery-rating-number-"],
  .tt-tk-baslik, .tt-tk-fiyat b, .tt-tk-ind-etiket, .tt-tk-tutar, .tt-tk-uyari, .tt-tk-sayac,
  .tt-fb-serit-metin, .tt-fb-buyuk, .tt-kol-metin, .tt-kart-yeni,
  .ttn-cark-tutar, .ttn-cark-gobek, .ttn-cark-kupon-baslik, .ttn-cark-kupon-kod, .ttn-cark-kupon-sayac, .ttn-cark-bar-sayac,
  .tt-sc-varyant-yeni, .tt-proof-score, .tt-proof-users, .ai-apple-text__content :is(b, strong, h4, h5, h6)) {
  font-weight: 500;
}

/* --- Aile: tt-veri'deki -apple-system / SF Pro yığını Inter'e döner */
html:not(#ttd):not(#ttd-2) body .tt-veri,
html:not(#ttd):not(#ttd-2) body .tt-veri * {
  font-family: var(--ttd-f-aile);
}

/* --- Büyük harf yok: buton, etiket ve başlıkların hiçbiri uppercase değil */
html:not(#ttd):not(#ttd-2) body *,
html:not(#ttd):not(#ttd-2) body *::before,
html:not(#ttd):not(#ttd-2) body *::after {
  text-transform: none;
}
html:not(#ttd):not(#ttd-2) body :is(.tt-cs-ust, .tt-cs-etiket, .tt-uk-tip, .ay-etiket, .as-etiket, .tt-veri-ust, .tt-veri-etiket,
  [class*="ai-comparison-category"], [class*="ai-how-it-works-badge"], [class*="uac-etiket-"],
  .tt-sc-nasil-etiket, .vs-cta, .mk-cta, .caption.uppercase) {
  letter-spacing: 0;
}

/* --- H1: sayfa hero başlıkları — 34 / 64, lh 1.1, -0.035em */
html:not(#ttd):not(#ttd-2) body :is(.hv-title, .gh-bas, [class*="ai-hero-heading"]) {
  font-size: var(--ttd-f-h1);
  line-height: 1.1;
  letter-spacing: -0.035em;
}
html:not(#ttd):not(#ttd-2) body .gh-vurgu {
  font-size: 1em;
}
/* guclu-header başlığı mobilde tek satıra sığsın diye nowrap + min(33px, 6vw)
   kullanıyordu; 34px ölçekte satırların dengeli kırılmasına izin verilir. */
html:not(#ttd):not(#ttd-2) body :is(.gh-bas, .gh-vurgu) {
  white-space: normal;
  text-wrap: balance;
}

/* --- H2: bölüm başlıkları — 28 / 48, lh 1.15, -0.03em */
html:not(#ttd):not(#ttd-2) body :is(.tt-cs-baslik, [class*="tt-catal-title-"], .ho-head, .vs-head, .mk-head,
  .ay-bas-metin, .ay-vurgu, .cb-bas-yazi, .as-bas, .tt-veri-baslik, [class*="ai-comparison-title"],
  .ak-bas, [class*="ttn-hiw-heading"], [class*="ai-how-it-works-heading"], .tt-sc .tt-sc-baslik,
  [class*="uac-baslik-"], [class*="ugc-gallery-heading-"], .title-wrapper .heading,
  .product__title h1) {
  font-size: var(--ttd-f-h2);
  line-height: 1.15;
  letter-spacing: -0.03em;
}

/* --- H3: kart başlıkları — 20 / 24, lh 1.25, -0.015em */
html:not(#ttd):not(#ttd-2) body :is(.vs-card-title, .vs-card.is-on .vs-card-title, .mk-ust, .as-kart-bas, .ay-kbas, .ak-kart-bas,
  [class*="ai-comparison-product-title"], [class*="ttn-hiw-title"], [class*="ai-how-it-works-card-title"],
  [class*="tt-catal-name-"], .cb-sonuc-bas, [class*="ai-category-card-title"], .tt-sc-ad,
  .mk-pop-baslik, .ak-pop-bas, [class*="dcb-pop-title-"], .tt-tk-baslik) {
  font-size: var(--ttd-f-h3);
  line-height: 1.25;
  letter-spacing: -0.015em;
}

/* --- Gövde: bölüm alt başlıkları — 17 / 19, lh 1.5 */
html:not(#ttd):not(#ttd-2) body :is(.hv-body, .gh-alt, .ho-alt, .vs-alt, .mk-metin, .ay-alt, .cb-bas-alt, .as-alt, .tt-veri-alt,
  [class*="ai-comparison-subtitle"], [class*="ttn-hiw-subheading"], [class*="ai-hero-description"],
  [class*="tt-catal-sub-"], [class*="uac-metin-"], .tt-cs-alt) {
  font-size: var(--ttd-f-govde);
  line-height: 1.5;
  font-weight: 400;
}
/* Kart metinleri: gövde ölçeğinin alt değeri (17px) */
html:not(#ttd):not(#ttd-2) body :is(.vs-card-text, .ay-kmetin, .ak-kart-metin, .as-kart-alt, [class*="ttn-hiw-text"],
  [class*="ai-how-it-works-card-description"], .tt-veri-cumle) {
  font-size: 17px;
  line-height: 1.5;
}

/* --- Küçük metin ve etiketler — 13px, lh 1.4 */
html:not(#ttd):not(#ttd-2) body :is(.gh-etiket, .gh-bilgi, .as-etiket, .tt-veri-ust, .tt-veri-etiket, .tt-veri-dipnot,
  [class*="ai-comparison-category"], .ay-etiket, .tt-cs-ust, .tt-cs-etiket, .tt-uk-tip,
  [class*="ai-how-it-works-badge"], [class*="tt-catal-pill-"], [class*="tt-catal-q-"], .hv-stat,
  .ho-eksen span, [class*="uac-etiket-"], .tt-sc-ust) {
  font-size: var(--ttd-f-kucuk);
  line-height: 1.4;
}

/* Ürün kartı üst etiketi 13px'te kesilmesin: satır kaydırmaya izin verilir */
html:not(#ttd):not(#ttd-2) body .tt-cs-ust {
  white-space: normal;
  text-overflow: clip;
}

/* ==========================================================================
   ADIM 3 — Renk kuralları
   - Apple mavisi (#0071E3 ailesi) kalkar: açık zeminde --ttd-murekkep,
     koyu zeminde (mürekkep görünmeyeceği için) --ttd-koyu-metin.
   - Leica kırmızısı (--ttd-vurgu) bu adımda yalnızca puan yıldızlarında;
     koyu bölümdeki ana butonlar Adım 4'te.
   - KORUNAN: background-clip:text gradient yazılar (.gh-vurgu, .ay-vurgu,
     .as-bas-vurgu, .cb-bas-vurgu, .cb-ipucu) ve adım rozetleri (.ay-no) —
     hiçbir renk kuralı bu seçicilere uygulanmaz.
   - KORUNAN: indirim yeşili #1A7F37 / #EDF7F0 (tt_serit_*, tt-fb-serit,
     tt-kol-serit, tt-kart-yeni/etiket, taksit modalı rozeti).
   - KORUNAN: mozaik ve apple-slayt görsel karartma gradient'leri.
   ========================================================================== */

/* --- Tema geneli (Concept rgb üçlüleri) */
:root {
  --color-base-text: 17 17 17;
  --color-base-button: 17 17 17;
  --color-base-button-gradient: #111111;
  --color-keyboard-focus: 17 17 17;
  --color-price: 17 17 17;
  --color-sale-price: 17 17 17;
  --color-sale-tag: 17 17 17;
  --color-rating: 226 6 18;
  --color-placeholder: 242 242 242;
  --color-drawer-text: 17 17 17;
  --color-drawer-button: 17 17 17;
  --color-drawer-button-background: 17 17 17;
  --color-drawer-button-gradient: #111111;
  --color-drawer-overlay: 17 17 17;
}
/* Concept açık section'lar: ön plan mürekkep */
html:not(#ttd):not(#ttd-2) body :is([id$="__header"], [id$="__main-product"], [id$="__product-recommendations"], [id*="__featured_collection"],
  [id$="__recently-viewed"], [id$="__main"], [id$="__cart-drawer"], [id$="__search-drawer"]).shopify-section {
  --color-foreground: 17 17 17;
}
/* Concept koyu section'lar (bülten, SSS): zemin --ttd-koyu */
html:not(#ttd):not(#ttd-2) body :is([id*="__newsletter"], [id$="__faq"]).shopify-section {
  --color-background: 17 17 17;
  --color-foreground: 245 245 247;
  --color-button-text: 17 17 17;
}

/* --- Puan yıldızları: Leica kırmızısı */
html:not(#ttd):not(#ttd-2) body .hv-stars svg,
html:not(#ttd):not(#ttd-2) body .hv-kanit-yildiz svg,
html:not(#ttd):not(#ttd-2) body .tt-proof .tt-stars svg {
  fill: var(--ttd-vurgu);
}
html:not(#ttd):not(#ttd-2) body .gh-yildizlar,
html:not(#ttd):not(#ttd-2) body :is(.tt-proof-stars, .tt-proof-star, .rating-star, .ugc-gallery-stars) {
  color: var(--ttd-vurgu);
}

/* --- tt_baslik (koyu cam başlık barı ve hamburger menü) */
html:not(#ttd):not(#ttd-2) body [data-tth-kok] {
  background: rgba(17, 17, 17, 0.72);
  border-bottom-color: var(--ttd-koyu-cizgi);
}
html:not(#ttd):not(#ttd-2) body [class*="tth-sayi-"] {
  background: var(--ttd-koyu-metin);
  color: var(--ttd-murekkep);
}
html:not(#ttd):not(#ttd-2) body [data-tth-menu] {
  background: var(--ttd-koyu);
}
html:not(#ttd):not(#ttd-2) body [data-tth-menu] li + li {
  border-top-color: var(--ttd-koyu-cizgi);
}
html:not(#ttd):not(#ttd-2) body [data-tth-menu] [class*="tth-alt-"] a {
  color: var(--ttd-koyu-soluk);
}

/* --- hero-video-kapsul (ana sayfa açık, koleksiyon koyu varyant) */
html:not(#ttd):not(#ttd-2) body .hv-root {
  background: var(--ttd-yumusak);
}
html:not(#ttd):not(#ttd-2) body .hv-title,
html:not(#ttd):not(#ttd-2) body .hv-stat {
  color: var(--ttd-murekkep);
}
html:not(#ttd):not(#ttd-2) body .hv-body,
html:not(#ttd):not(#ttd-2) body .hv-ph {
  color: var(--ttd-soluk);
}
html:not(#ttd):not(#ttd-2) body .hv-ticker {
  background: var(--ttd-koyu-kart);
  border-color: var(--ttd-koyu-cizgi);
}
html:not(#ttd):not(#ttd-2) body .hv-tk,
html:not(#ttd):not(#ttd-2) body .hv-tk[data-efekt="vurgu"],
html:not(#ttd):not(#ttd-2) body .hv-vurgu {
  color: var(--ttd-koyu-metin);
}
html:not(#ttd):not(#ttd-2) body .hv-tk-cizgi {
  background: var(--ttd-koyu-soluk);
}
html:not(#ttd):not(#ttd-2) body .hv-log,
html:not(#ttd):not(#ttd-2) body .hv-kanit {
  color: var(--ttd-koyu-soluk);
}
html:not(#ttd):not(#ttd-2) body .hv-media {
  background: var(--ttd-koyu-kart);
}
/* koyu varyant (koleksiyon): ticker'lı "hv-yeni" düzeni koyu zemin kullanır */
html:not(#ttd):not(#ttd-2) body .hv-root:has(.hv-yeni) {
  background: var(--ttd-koyu);
}
html:not(#ttd):not(#ttd-2) body .hv-root:has(.hv-yeni) :is(.hv-title, .hv-stat) {
  color: var(--ttd-koyu-metin);
}
html:not(#ttd):not(#ttd-2) body .hv-root:has(.hv-yeni) :is(.hv-body, .hv-ph) {
  color: var(--ttd-koyu-soluk);
}

/* --- tt-cok-satanlar (ürün rafı) */
html:not(#ttd):not(#ttd-2) body .tt-cs {
  --tt-cs-rozet: var(--ttd-murekkep);
  --tt-cs-vurgu: var(--ttd-murekkep);
  --tt-cs-etiket: var(--ttd-soluk);
  --tt-cs-fiyat: var(--ttd-murekkep);
  --tt-cs-eski: var(--ttd-soluk);
  --tt-cs-ayrac: var(--ttd-cizgi);
  --tt-cs-kenar: var(--ttd-cizgi);
  --tt-cs-koyu: var(--ttd-murekkep);
  --tt-cs-gri: var(--ttd-soluk);
  background: var(--ttd-yumusak);
}
html:not(#ttd):not(#ttd-2) body .tt-cs-gorsel {
  background: var(--ttd-yumusak);
}
html:not(#ttd):not(#ttd-2) body .tt-cs-noktalar i {
  background: var(--ttd-cizgi);
}
html:not(#ttd):not(#ttd-2) body .tt-cs-noktalar i[data-cs-aktif] {
  background: var(--ttd-murekkep);
}

/* --- tt-catal-karsilastirma (koyu bölüm) */
html:not(#ttd):not(#ttd-2) body :is([class^="tt-catal-template--"], [class^="tt-catal-sections--"]) {
  --tt-catal-bg: var(--ttd-koyu);
  --tt-catal-surface: var(--ttd-koyu-kart);
  --tt-catal-media: var(--ttd-koyu);
  --tt-catal-line: var(--ttd-koyu-cizgi);
  --tt-catal-pill-bg: var(--ttd-koyu-cizgi);
  --tt-catal-text: var(--ttd-koyu-metin);
  --tt-catal-muted: var(--ttd-koyu-soluk);
  --tt-catal-name: var(--ttd-koyu-metin);
  --tt-catal-cta: var(--ttd-koyu-metin);
}

/* --- hediye-omru (açık bölüm, liste satırları) */
html:not(#ttd):not(#ttd-2) body .ho-root {
  background: var(--ttd-yumusak);
}
html:not(#ttd):not(#ttd-2) body :is(.ho-head, .ho-okuma, .ho-ad, .ho-final) {
  color: var(--ttd-murekkep);
}
html:not(#ttd):not(#ttd-2) body :is(.ho-alt, .ho-ipucu, .ho-eksen span, .ho-durum) {
  color: var(--ttd-soluk);
}
html:not(#ttd):not(#ttd-2) body .ho-slider::-webkit-slider-runnable-track {
  background: var(--ttd-cizgi);
}
html:not(#ttd):not(#ttd-2) body .ho-slider::-moz-range-track {
  background: var(--ttd-cizgi);
}
html:not(#ttd):not(#ttd-2) body .ho-slider::-webkit-slider-thumb {
  background: var(--ttd-murekkep);
}
html:not(#ttd):not(#ttd-2) body .ho-slider::-moz-range-thumb {
  background: var(--ttd-murekkep);
}
html:not(#ttd):not(#ttd-2) body .ho-slider:focus-visible::-webkit-slider-thumb {
  box-shadow: 0 0 0 3px var(--ttd-cizgi);
}
html:not(#ttd):not(#ttd-2) body .ho-slider:focus-visible::-moz-range-thumb {
  box-shadow: 0 0 0 3px var(--ttd-cizgi);
}
html:not(#ttd):not(#ttd-2) body .ho-media {
  background: var(--ttd-yumusak);
}
/* kapsül satırı: mavi/kırmızı parlama kalkar, çerçeve ve çubuk mürekkep */
html:not(#ttd):not(#ttd-2) body .ho-row.is-kapsul .ho-media {
  box-shadow: 0 0 0 1.5px var(--ttd-murekkep);
}
html:not(#ttd):not(#ttd-2) body .ho-bar {
  background: var(--ttd-cizgi);
}
