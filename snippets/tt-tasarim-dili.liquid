html:not(#ttd):not(#ttd-2) body [data-sc-secili] .tt-uk::after {
  box-shadow: inset 0 0 0 1.5px var(--ttd-murekkep);
}

/* --- Çark (ttn-cark): nane yeşili kalkar, ikon siyah-beyaz. JS ve çerez mantığına dokunulmaz */
/* Çark renk değişkenleri section ayarından satır içi style="" ile geldiği için
   bu 5 değişkende !important zorunlu. */
html:not(#ttd):not(#ttd-2) body .ttn-cark {
  --ttn-kart-zemin: var(--ttd-kart) !important;
  --ttn-vurgu: var(--ttd-soluk) !important;
  --ttn-koyu: var(--ttd-murekkep) !important;
  --ttn-alt-yazi: var(--ttd-soluk) !important;
  --ttn-halka: var(--ttd-yumusak) !important;
}
html:not(#ttd):not(#ttd-2) body .ttn-cark-dilimler path:is([data-ttn-dilim="0"], [data-ttn-dilim="2"], [data-ttn-dilim="4"], [data-ttn-dilim="6"]) {
  fill: var(--ttd-murekkep);
}
html:not(#ttd):not(#ttd-2) body .ttn-cark-dilimler path:is([data-ttn-dilim="1"], [data-ttn-dilim="3"], [data-ttn-dilim="5"], [data-ttn-dilim="7"]) {
  fill: #FFFFFF;
}
html:not(#ttd):not(#ttd-2) body .ttn-cark-dilimler path[data-ttn-kazanan] {
  fill: var(--ttd-soluk);
}
html:not(#ttd):not(#ttd-2) body .ttn-cark-yazilar g[data-ttn-kazanan] {
  fill: #FFFFFF;
}
html:not(#ttd):not(#ttd-2) body .ttn-cark-ibre {
  border-top-color: var(--ttd-murekkep);
}
html:not(#ttd):not(#ttd-2) body .ttn-cark-kupon-ikon {
  background: var(--ttd-murekkep);
  color: #FFFFFF;
}
html:not(#ttd):not(#ttd-2) body .ttn-cark-bar {
  --ttn-bar-zemin: var(--ttd-koyu);
  --ttn-bar-yazi: var(--ttd-koyu-metin);
  --ttn-bar-vurgu: var(--ttd-koyu-metin);
  background: var(--ttd-koyu);
  color: var(--ttd-koyu-metin);
}
html:not(#ttd):not(#ttd-2) body .ttn-cark-bar-sayac {
  color: var(--ttd-koyu-metin);
}

/* --- "Nasıl çalışır?" paneli: yeşil tonlar nötre döner */
html:not(#ttd):not(#ttd-2) body .tt-nc {
  --tt-nc-zemin: var(--ttd-koyu);
  --tt-nc-cerceve: var(--ttd-koyu-cizgi);
  --tt-nc-yazi: var(--ttd-koyu-metin);
  --tt-nc-baslik-renk: var(--ttd-murekkep);
  --tt-nc-alt-renk: var(--ttd-soluk);
  --tt-nc-etiket-renk: var(--ttd-murekkep);
  --tt-nc-etiket-zemin: var(--ttd-yumusak);
  --tt-nc-halka-1: var(--ttd-murekkep);
  --tt-nc-halka-2: var(--ttd-soluk);
  --tt-nc-ikon-renk: var(--ttd-murekkep);
  --tt-nc-ikon-zemin: var(--ttd-yumusak);
  --tt-nc-kapat-zemin: var(--ttd-yumusak);
  --tt-nc-kart-kenar: var(--ttd-cizgi);
  --tt-nc-kart-zemin: var(--ttd-kart);
  --tt-nc-ok-zemin: var(--ttd-yumusak);
  --tt-nc-panel-zemin: var(--ttd-yumusak);
  --tt-nc-tutamac: var(--ttd-cizgi);
}

/* --- tt-couple / tt-tekli renk token'ları */
html:not(#ttd):not(#ttd-2) body #MainContent.tt-couple-page,
html:not(#ttd):not(#ttd-2) body #MainContent.tt-tekli-page {
  --tt-c-ink: var(--ttd-murekkep);
  --tt-c-ink-2: var(--ttd-soluk);
  --tt-c-ink-3: var(--ttd-soluk);
  --tt-c-ink-dark: var(--ttd-koyu-metin);
  --tt-c-ink-2-dark: var(--ttd-koyu-soluk);
  --tt-c-ink-3-dark: var(--ttd-koyu-soluk);
}

/* ==========================================================================
   ADIM 4 — Butonlar ve çipler
   13 farklı ölçülmüş buton stili iki stile iner:
     ANA     : 48px (ürün "Sepete ekle" ve yapışkan sepet barı 52px), yatay 24px,
               köşe 999px, Inter 500 16px, büyük harf yok.
               Açık zeminde --ttd-murekkep / beyaz; koyu zeminde --ttd-vurgu / beyaz.
     İKİNCİL : aynı ölçüler, şeffaf zemin, 1px kenarlık.
               Açık zeminde kenarlık+yazı --ttd-murekkep; koyu zeminde --ttd-koyu-metin.
     METİN LİNKİ: Inter 500 16px, --ttd-murekkep, sonunda "→" (mevcut ok ikonu korunur).
   Bilinçli istisnalar: .tt-fb-link 36px (küçük ikincil); başlık barındaki
   .tth-cta 40px (bar 52/56px yüksekliğinde, 48px sığmıyor).
   ========================================================================== */

/* --- Ortak ölçü: tüm ana ve ikincil butonlar */
html:not(#ttd):not(#ttd-2) body :is(.button.button--primary:not(.self-button), .button.button--secondary:not(.button--close):not([is="next-button"]):not([is="previous-button"]),
  .gh-dugme, .gh-cam, [class*="tt-catal-btn-"], .mk-cta, .vs-cta,
  [id*="__blocks_"] [class*="ai-comparison-button-"], .ttn-cark-dugme, .tt-nc-dugme,
  .tt-sc-cubuk-dugme, .tt-sc-nasil-onay) {
  min-height: var(--ttd-btn-yuk);
  padding: 0 var(--ttd-btn-pad);
  border-radius: var(--ttd-r-hap);
  font-family: var(--ttd-f-aile);
  font-size: 16px;
  font-weight: 500;
  line-height: 1.2;
  letter-spacing: 0;
}
/* Ürün sayfası "Sepete ekle" ve yapışkan sepet barı: 52px */
html:not(#ttd):not(#ttd-2) body :is(.product-form__submit, product-sticky-form .button.button--primary, .product-sticky-form__card .button.button--primary) {
  min-height: var(--ttd-btn-yuk-buyuk);
}

/* --- ANA / açık zemin */
html:not(#ttd):not(#ttd-2) body :is(.button.button--primary:not(.self-button), .gh-dugme:not(.is-ikincil), .mk-cta,
  [id*="__blocks_wKUYJT"] [class*="ai-btn-hediye"], .tt-sc-cubuk-dugme, .tt-sc-nasil-onay),
html:not(#ttd):not(#ttd-2) body :is(.gh-dugme:not(.is-ikincil), .mk-cta, .tt-sc-cubuk-dugme):hover {
  background: var(--ttd-murekkep);
  border: 1px solid var(--ttd-murekkep);
  color: #FFFFFF;
  box-shadow: none;
}

/* --- ANA / koyu zemin: Leica kırmızısı (bölüm başına tek ana buton) */
html:not(#ttd):not(#ttd-2) body :is([class*="tt-catal-btn-"][href*="couple"], :is([class^="tth-cta-template--"], [class^="tth-cta-sections--"]), :is([class^="tth-btn-template--"], [class^="tth-btn-sections--"]).is-dolu,
  :is([id*="__blocks_HATjRq"], [id*="__blocks_BHFjY3"]) [class*="ai-btn-couple"], .vs-cta),
html:not(#ttd):not(#ttd-2) body :is([class*="tt-catal-btn-"][href*="couple"], :is([class^="tth-cta-template--"], [class^="tth-cta-sections--"]), :is([class^="tth-btn-template--"], [class^="tth-btn-sections--"]).is-dolu,
  :is([id*="__blocks_HATjRq"], [id*="__blocks_BHFjY3"]) [class*="ai-btn-couple"], .vs-cta):hover {
  background: var(--ttd-vurgu);
  border: 1px solid var(--ttd-vurgu);
  color: #FFFFFF;
}

/* --- İKİNCİL / açık zemin */
html:not(#ttd):not(#ttd-2) body :is(.button.button--secondary:not(.button--close):not([is="next-button"]):not([is="previous-button"]):not(.quick-view__button), .gh-dugme.is-ikincil,
  [id*="__blocks_wKUYJT"] [class*="ai-btn-couple"], .ttn-cark-dugme),
html:not(#ttd):not(#ttd-2) body :is(.gh-dugme.is-ikincil, [id*="__blocks_wKUYJT"] [class*="ai-btn-couple"], .ttn-cark-dugme):hover {
  background: transparent;
  border: 1px solid var(--ttd-murekkep);
  color: var(--ttd-murekkep);
}
/* Görsel üstündeki "Hızlı Bakış": okunabilirlik için beyaz zemin korunur, ölçü/renk sisteme uyar */
html:not(#ttd):not(#ttd-2) body .quick-view__button {
  background: var(--ttd-kart);
  border: 1px solid var(--ttd-murekkep);
  color: var(--ttd-murekkep);
}
/* guclu-header "Ürünü Öğren" cam butonu: blur/cam zemini kalır, renk ve ölçü sisteme uyar */
html:not(#ttd):not(#ttd-2) body .gh-cam {
  background: rgba(255, 255, 255, 0.72);
  border: 1px solid var(--ttd-murekkep);
  color: var(--ttd-murekkep);
}
html:not(#ttd):not(#ttd-2) body .gh-cam::before {
  border-color: var(--ttd-murekkep);
}

/* --- İKİNCİL / koyu zemin */
html:not(#ttd):not(#ttd-2) body :is([class*="tt-catal-btn-"][href*="hediye"], :is([class^="tth-btn-template--"], [class^="tth-btn-sections--"]).is-cizgi,
  :is([id*="__blocks_HATjRq"], [id*="__blocks_BHFjY3"]) [class*="ai-btn-hediye"]),
html:not(#ttd):not(#ttd-2) body :is([class*="tt-catal-btn-"][href*="hediye"],
  :is([id*="__blocks_HATjRq"], [id*="__blocks_BHFjY3"]) [class*="ai-btn-hediye"]):hover {
  background: transparent;
  border: 1px solid var(--ttd-koyu-metin);
  color: var(--ttd-koyu-metin);
}
html:not(#ttd):not(#ttd-2) body :is([class^="tth-btn-template--"], [class^="tth-btn-sections--"]).is-cizgi:hover {
  background: var(--ttd-koyu-metin);
  border-color: var(--ttd-koyu-metin);
  color: var(--ttd-murekkep);
}

/* --- Başlık barı "Satın Al" (.tth-cta): koyu barda ana buton, 40px (bar 52/56px) */
html:not(#ttd):not(#ttd-2) body :is(:is([class^="tth-cta-template--"], [class^="tth-cta-sections--"]), :is([class^="tth-btn-template--"], [class^="tth-btn-sections--"])) {
  height: 40px;
  padding: 0 20px;
  border-radius: var(--ttd-r-hap);
  font-size: 16px;
  font-weight: 500;
  letter-spacing: 0;
}

/* --- "Nasıl çalışır?" yüzen butonu: koyu ana (zemin --ttd-koyu, kenarlık --ttd-koyu-cizgi) */
html:not(#ttd):not(#ttd-2) body .tt-nc-dugme {
  background: var(--ttd-koyu);
  border: 1px solid var(--ttd-koyu-cizgi);
  color: #FFFFFF;
  padding: 0 var(--ttd-btn-pad) 0 8px;
}

/* --- Ürün "Taksit tablosu" linki: küçük ikincil (36px) */
html:not(#ttd):not(#ttd-2) body .tt-fb-link {
  min-height: 36px;
  padding: 0 16px;
  border-radius: var(--ttd-r-hap);
  background: transparent;
  border: 1px solid var(--ttd-murekkep);
  color: var(--ttd-murekkep);
  font-size: 14px;
  font-weight: 500;
}
html:not(#ttd):not(#ttd-2) body .tt-fb-s3 .tt-fb-link,
html:not(#ttd):not(#ttd-2) body .tt-fb-s2 .tt-fb-link {
  color: var(--ttd-murekkep);
}
/* Cihaz uyumluluğu butonu: küçük ikincil */
html:not(#ttd):not(#ttd-2) body [class*="dcb-btn-"] {
  min-height: 36px;
  padding: 0 16px;
  border-radius: var(--ttd-r-hap);
  background: transparent;
  border: 1px solid var(--ttd-murekkep);
  color: var(--ttd-murekkep);
  font-size: 14px;
}

/* --- Bülten gönder: açık daire, koyu ok */
html:not(#ttd):not(#ttd-2) body .button.self-button {
  background: var(--ttd-koyu-metin);
  border-color: var(--ttd-koyu-metin);
  color: var(--ttd-murekkep);
  border-radius: var(--ttd-r-hap);
}
html:not(#ttd):not(#ttd-2) body .button.self-button svg {
  color: var(--ttd-murekkep);
  stroke: var(--ttd-murekkep);
}

/* --- Kart "+" (sepete ekle) butonu: hap köşe */
html:not(#ttd):not(#ttd-2) body .tt-uk-dugme {
  border-radius: var(--ttd-r-hap);
}

/* --- Metin linkleri: Inter 500 16px, mürekkep (koyu zeminde açık metin) */
html:not(#ttd):not(#ttd-2) body :is([class*="uac-bag-"], [class*="uac-bagyazi-"]) {
  font-size: 16px;
  font-weight: 500;
  color: var(--ttd-murekkep);
}
html:not(#ttd):not(#ttd-2) body :is(.ak-ust-bag, .ak-pop-bag) {
  font-size: 16px;
  font-weight: 500;
  color: var(--ttd-koyu-metin);
}

/* --- Çipler (.tt-cs-cip, .tt-sc-cip): 36px, 0 16px, 999px, 14px, kenarlıksız */
html:not(#ttd):not(#ttd-2) body :is(.tt-cs-cip, .tt-sc-cip) {
  min-height: 36px;
  padding: 0 16px;
  border: 0;
  border-radius: var(--ttd-r-hap);
  font-size: 14px;
  font-weight: 500;
  line-height: 1.2;
  letter-spacing: 0;
}
/* pasif: yumuşak zemin üstünde beyaz (tt-cok-satanlar), beyaz zemin üstünde yumuşak (tt-secim-kartlari) */
html:not(#ttd):not(#ttd-2) body .tt-cs-cip {
  background: var(--ttd-kart);
  color: var(--ttd-murekkep);
}
html:not(#ttd):not(#ttd-2) body .tt-sc-cip {
  background: var(--ttd-yumusak);
  color: var(--ttd-murekkep);
}
html:not(#ttd):not(#ttd-2) body :is(.tt-cs-cip, .tt-sc-cip)[aria-checked="true"] {
  background: var(--ttd-murekkep);
  color: #FFFFFF;
}

/* --- tt-couple / tt-tekli katmanındaki buton token'ları bu sisteme eşitlenir */
html:not(#ttd):not(#ttd-2) body #MainContent.tt-couple-page,
html:not(#ttd):not(#ttd-2) body #MainContent.tt-tekli-page {
  --tt-btn-font: 16px;
  --tt-btn-weight: 500;
  --tt-btn-pad-y: 14px;
  --tt-btn-pad-x: 24px;
  --tt-btn-radius: 999px;
  --tt-btn-gap: 8px;
}

/* ==========================================================================
   ADIM 5 — Kartlar, rozetler ve bölüm ritmi
   Kartlar kenarlıksız, 20px köşe. Yumuşak zemin üstünde --ttd-kart (beyaz),
   beyaz zemin üstünde --ttd-yumusak. Liste öğeleri 16px, görsel içi 12px.
   Bölüm üst/alt boşluğu mobilde 96px, masaüstünde 160px; mobil kenar 16px.
   ========================================================================== */

/* --- Tema geneli köşe token'ları (Concept ürün kartları, bloklar) */
:root {
  --rounded-card: 20px;
  --rounded-block: 20px;
}

/* --- Kartlar: yumuşak zemin üstünde beyaz */
html:not(#ttd):not(#ttd-2) body :is(.tt-cs-kart, .ho-row, .ttn-cark-ic, .cb-bildirim, [class^="ai-how-it-works-card-"]:not([class*="-card-title-"]):not([class*="-card-description-"]):not([class*="-card-image"]),
  [class*="ac-item-"], [id*="__blocks_wKUYJT"] [class*="ai-comparison-feature-card"]) {
  background: var(--ttd-kart);
  border: 0;
}
/* --- Kartlar: beyaz zemin üstünde yumuşak */
html:not(#ttd):not(#ttd-2) body :is(.tt-uk, .tt-sc-kart:not([aria-checked="true"]), .tt-sc-set, .mk-yorum, .tt-tk-grup) {
  background: var(--ttd-yumusak);
  border: 0;
}
html:not(#ttd):not(#ttd-2) body .tt-sc-kart:not([aria-checked="true"]) {
  box-shadow: none;
}
html:not(#ttd):not(#ttd-2) body .tt-uk-gorsel {
  background: var(--ttd-yumusak);
}
/* --- Kartlar: koyu bölümde */
html:not(#ttd):not(#ttd-2) body :is([class*="tt-catal-card-"], .as-kart, .vs-card, [class*="ttn-hiw-card"]:not([class*="-card-"]),
  :is([id*="__blocks_HATjRq"], [id*="__blocks_BHFjY3"]) [class*="ai-comparison-feature-card"], .ak-kart) {
  background: var(--ttd-koyu-kart);
  border: 0;
  box-shadow: none;
}
@media (min-width: 990px) {
  /* video-slider masaüstünde kartlar zeminsiz liste düzenindedir */
  html:not(#ttd):not(#ttd-2) body .vs-card {
    background: transparent;
  }
}

/* --- Köşe: kart 20px */
html:not(#ttd):not(#ttd-2) body :is(.tt-cs-kart, .tt-uk, .tt-sc-kart, .tt-sc-set, [class*="tt-catal-card-"], .mk-kart, .mk-pop, .as-kart,
  .vs-card, .vs-stage, [class*="ttn-hiw-card"]:not([class*="-card-"]),
  [class^="ai-how-it-works-card-"]:not([class*="-card-title-"]):not([class*="-card-description-"]):not([class*="-card-image"]),
  [class*="ai-comparison-product-image-wrapper"], [class*="ai-category-card"]:not([class*="-card-"]),
  .hv-media, .ttn-cark-ic, .ak-pencere, .ak-pencere-ic, [class*="ai-hero-image"]) {
  border-radius: var(--ttd-r-kart);
}
/* --- Köşe: küçük kart ve liste öğesi 16px */
html:not(#ttd):not(#ttd-2) body :is(.ho-row, .ak-kart, [class*="ai-comparison-feature-card"], [class*="ac-item-"], .tt-tk-grup, .tt-tk-indirim,
  .tt-fb-satir.tt-fb-s3, .cb-bildirim, .tt-sc-slot, .tt-sc-satir--kutu) {
  border-radius: var(--ttd-r-kucuk);
}
/* --- Köşe: görsel içi 12px */
html:not(#ttd):not(#ttd-2) body :is(.ho-media, [class*="tt-catal-media-"], [class*="ai-comparison-product-image"]:not([class*="-wrapper"]), .cb-tile,
  [class*="ttn-hiw-image-wrapper"], [class*="ai-how-it-works-card-image"], .tt-sc-nasil-gorsel) {
  border-radius: var(--ttd-r-gorsel);
}
html:not(#ttd):not(#ttd-2) body .cb-tile {
  border: 0;
}
html:not(#ttd):not(#ttd-2) body [class*="tt-catal-media-"] {
  border: 0;
}

/* --- Rozetler: 11px, Inter 500, 999px.
   Birincil ("2'li set", "Kadın", kampanya) mürekkep zemin beyaz yazı;
   ikincil ("#1 çok satan", etiket) beyaz zemin mürekkep yazı. */
html:not(#ttd):not(#ttd-2) body :is(.tt-cs-rozet, .tt-uk-rozet--kampanya, .tt-sc-rozet) {
  background: var(--ttd-murekkep);
  color: #FFFFFF;
  border: 0;
  font-size: 11px;
  font-weight: 500;
  border-radius: var(--ttd-r-hap);
}
html:not(#ttd):not(#ttd-2) body :is(.tt-cs-sira, .tt-uk-rozet--etiket) {
  background: var(--ttd-kart);
  color: var(--ttd-murekkep);
  border: 0;
  font-size: 11px;
  font-weight: 500;
  border-radius: var(--ttd-r-hap);
}

/* --- Bölüm ritmi: üst/alt boşluk 96px (mobil) → 160px (masaüstü) */
html:not(#ttd):not(#ttd-2) body :is(.hv-root, .tt-cs, [class^="tt-catal-template--"], [class^="tt-catal-sections--"], .ho-root, .vs-root, .mk-root,
  .ay-root, .cb-kok, .as-kok, .tt-veri, .ak-kok,
  [class^="ai-comparison-"]:not([class*="-category"]):not([class*="-title"]):not([class*="-subtitle"]):not([class*="-product"]):not([class*="-feature"]):not([class*="-button"]):not([class*="-header"]):not([class*="-grid"]):not([class*="-column"]):not([class*="-container"]):not([class*="-list"]):not([class*="-image"]),
  [class*="ttn-hiw-container"],
  [class^="ai-how-it-works-"]:not([class*="-container-"]):not([class*="-heading-"]):not([class*="-carousel"]):not([class*="-cards-"]):not([class*="-card-"]):not([class*="-nav-"]):not([class*="-pagination-"]):not([class*="-dot-"]):not([class*="-badge-"]),
  [class^="ai-hero-"]:not([class*="-container-"]):not([class*="-badge-"]):not([class*="-heading-"]):not([class*="-description-"]):not([class*="-image"]),
  [class^="ai-category-section"], [class^="ai-apple-text"]:not([class*="__"]),
  [class^="uac-template--"], [class^="uac-sections--"]) {
  padding-top: var(--ttd-bolum);
  padding-bottom: var(--ttd-bolum);
}
/* Concept section'ları kendi --section-padding değişkenleriyle çalışır */
html:not(#ttd):not(#ttd-2) body :is([id*="__newsletter"], [id$="__faq"], [id*="__featured_collection"], [id$="__product-recommendations"],
  [id$="__recently-viewed"], [id*="__ugc_galeri"]).shopify-section {
  --section-padding-top: var(--ttd-bolum);
  --section-padding-bottom: var(--ttd-bolum);
}

